import numpy as np

# ============================================================

# ACCOUNT TYPES - TUPLE

# ============================================================

account_types = ("Savings", "Current")

# ============================================================

# BANK ACCOUNTS - LIST

# ============================================================

accounts = []

# ============================================================

# FUNCTION 1: CREATE ACCOUNT

# ============================================================

def create_account():

```
print("\n========== CREATE ACCOUNT ==========")

name = input("Enter account holder name: ").strip().title()

if name == "":
    print("Name cannot be empty.")
    return

# Ask account type
print("\nAccount Types:")

for i in range(len(account_types)):
    print(i + 1, ".", account_types[i])

while True:

    choice = input("Choose account type: ").strip()

    if choice == "1":
        account_type = account_types[0]
        break

    elif choice == "2":
        account_type = account_types[1]
        break

    else:
        print("Invalid account type.")

# Create account number
account_number = 1001 + len(accounts)

# Create dictionary
account = {
    "account_number": account_number,
    "name": name,
    "account_type": account_type,
    "balance": 0,
    "transactions": []
}

# Add dictionary to list
accounts.append(account)

print("\nAccount created successfully!")
print("Account Number:", account_number)
print("Name:", name)
print("Account Type:", account_type)
```

# ============================================================

# FUNCTION 2: FIND ACCOUNT

# ============================================================

def find_account(account_number):

```
for account in accounts:

    if account["account_number"] == account_number:
        return account

return None
```

# ============================================================

# FUNCTION 3: DEPOSIT MONEY

# ============================================================

def deposit_money():

```
print("\n========== DEPOSIT MONEY ==========")

try:
    account_number = int(input("Enter account number: "))
except ValueError:
    print("Invalid account number.")
    return

account = find_account(account_number)

if account is None:
    print("Account not found.")
    return

try:
    amount = float(input("Enter deposit amount: "))
except ValueError:
    print("Please enter a valid amount.")
    return

if amount <= 0:
    print("Amount must be greater than zero.")
    return

# Update balance
account["balance"] += amount

# Add transaction
transaction = {
    "type": "Deposit",
    "amount": amount
}

account["transactions"].append(transaction)

print("\nDeposit successful!")
print("Deposited:", amount)
print("New Balance:", account["balance"])
```

# ============================================================

# FUNCTION 4: WITHDRAW MONEY

# ============================================================

def withdraw_money():

```
print("\n========== WITHDRAW MONEY ==========")

try:
    account_number = int(input("Enter account number: "))
except ValueError:
    print("Invalid account number.")
    return

account = find_account(account_number)

if account is None:
    print("Account not found.")
    return

try:
    amount = float(input("Enter withdrawal amount: "))
except ValueError:
    print("Please enter a valid amount.")
    return

if amount <= 0:
    print("Amount must be greater than zero.")
    return

if amount > account["balance"]:
    print("Insufficient balance.")
    return

# Update balance
account["balance"] -= amount

# Add transaction
transaction = {
    "type": "Withdrawal",
    "amount": amount
}

account["transactions"].append(transaction)

print("\nWithdrawal successful!")
print("Withdrawn:", amount)
print("Remaining Balance:", account["balance"])
```

