# ============================================================

# FUNCTION 6: TRANSACTION HISTORY

# ============================================================

def transaction_history():

```
print("\n========== TRANSACTION HISTORY ==========")

try:
    account_number = int(input("Enter account number: "))
except ValueError:
    print("Invalid account number.")
    return

account = find_account(account_number)

if account is None:
    print("Account not found.")
    return

if len(account["transactions"]) == 0:
    print("No transactions found.")
    return

print("\nAccount Holder:", account["name"])

for i, transaction in enumerate(
    account["transactions"],
    start=1
):

    print(
        i,
        ".",
        transaction["type"],
        "-",
        transaction["amount"]
    )
```

# ============================================================

# FUNCTION 7: TRANSACTION STATISTICS

# ============================================================

def transaction_statistics():

```
print("\n========== TRANSACTION STATISTICS ==========")

try:
    account_number = int(input("Enter account number: "))
except ValueError:
    print("Invalid account number.")
    return

account = find_account(account_number)

if account is None:
    print("Account not found.")
    return

if len(account["transactions"]) == 0:
    print("No transactions available.")
    return

amounts = []

for transaction in account["transactions"]:
    amounts.append(transaction["amount"])

# Convert list into NumPy array
amounts_array = np.array(amounts)

print("\nAccount Holder:", account["name"])

print(
    "Total Transaction Amount:",
    np.sum(amounts_array)
)

print(
    "Average Transaction:",
    round(np.mean(amounts_array), 2)
)

print(
    "Highest Transaction:",
    np.max(amounts_array)
)

print(
    "Lowest Transaction:",
    np.min(amounts_array)
)
```

