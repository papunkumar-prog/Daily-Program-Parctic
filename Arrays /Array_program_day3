# lower()
s1 = "PYTHON"
print(s1.lower())
#Linear Search using lower()
arr = ["Apple", "Banana", "Mango", "Orange"]
key = input("Enter fruit to search:").lower()
for i in range(len(arr)):
    if arr[i].lower() == key:
        print("Found at index:", i)
        break
else:
    print("No found")
#Count a word using lower()
arr1 = ["Apple", "apple", "Mango", "APPLE", "Banana"]
count = 0

for word in arr1:
    if word.lower() == key:
        count += 1
print("Count = ", count)
