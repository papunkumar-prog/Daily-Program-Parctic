#   Find Missing Number
#------------------------------
arr7 = [1,2,4,5,3,7]
n = 7
expected_sum = n * (n+1) // 2

actual_sum = 0
for elements in arr7:
    actual_sum = actual_sum + elements
missing = expected_sum - actual_sum
print("Missing Object :", missing)
#------------------------------
#   Find Duplicate Number
#------------------------------
arr8 = [10, 20, 30, 20, 40]
for i4 in range(len(arr8)):
    for j in range(i4 + 1, len(arr8)):
        if arr8[i4] == arr8[j]:
            print("Duplicate :", arr8[i4])
#------------------------------
#   Frequency Counting
#------------------------------
arr9 = [10, 20, 10, 30, 40, 10]
frequency = {}
for elmt in arr9:
    if elmt in frequency:
        frequency[elmt] = frequency[elmt] + 1
    else:
        frequency[elmt] = 1
print(frequency)
