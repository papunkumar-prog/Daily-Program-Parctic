#------------------------------
#   Remove Duplicates
#------------------------------
arr5 = [10, 20, 10, 30, 20, 40, 30]
result = []
for element in arr5:
    if element not in result:
        result.append(element)
print("Result :", result)
#------------------------------
#   Rotate Array
#------------------------------
arr6 = [10,20,30,40,50]
first = arr6[0]
for rot in range(len(arr6) -1):
    arr6[rot] = arr6[rot + 1]
arr6[-1] = first
print(arr6)
