import json
import re
from datetime import datetime

import numpy as np


# ==========================================================
# BANK ACCOUNT MANAGEMENT SYSTEM
# ==========================================================

accounts = []


# ==========================================================
# 1. LOAD ACCOUNTS
# ==========================================================

def load_accounts():

    global accounts

    try:

        with open("accounts.json", "r") as file:

            accounts = json.load(file)

        print("\nAccount data loaded successfully!")

    except FileNotFoundError:

        print("\nNo previous account data found.")

        accounts = []

    except json.JSONDecodeError:

        print("\nInvalid JSON file.")

        accounts = []


# ==========================================================
# 2. SAVE ACCOUNTS
# ==========================================================

def save_accounts():

    try:

        with open("accounts.json", "w") as file:

            json.dump(
                accounts,
                file,
                indent=4
            )

        print("\nAccount data saved successfully!")

    except Exception as error:

        print("\nError while saving data:", error)


# ==========================================================
# 3. GENERATE ACCOUNT NUMBER
# ==========================================================

def generate_account_number():

    if not accounts:

        return "ACC1001"

    numbers = []

    for account in accounts:

        account_number = account["account_number"]

        number = int(
            account_number.replace("ACC", "")
        )

        numbers.append(number)

    highest_number = max(numbers)

    return "ACC" + str(highest_number + 1)


# ==========================================================
# 4. CREATE ACCOUNT
# ==========================================================

def create_account():

    print("\n" + "=" * 50)
    print("CREATE NEW ACCOUNT")
    print("=" * 50)

    name = input(
        "Enter customer name: "
    ).strip().title()

    # ------------------------------------------
    # NAME VALIDATION USING REGEX
    # ------------------------------------------

    if not re.match(
        r"^[A-Za-z ]+$",
        name
    ):

        print(
            "\nInvalid name. "
            "Name should contain only letters."
        )

        return

    # ------------------------------------------
    # PHONE NUMBER
    # ------------------------------------------

    phone = input(
        "Enter phone number: "
    ).strip()

    if not re.match(
        r"^[6-9][0-9]{9}$",
        phone
    ):

        print(
            "\nInvalid phone number."
        )

        return

    # ------------------------------------------
    # EMAIL
    # ------------------------------------------

    email = input(
        "Enter email: "
    ).strip().lower()

    if not re.match(
        r"^[\w.-]+@[\w.-]+\.[A-Za-z]{2,}$",
        email
    ):

        print(
            "\nInvalid email address."
        )

        return

    # ------------------------------------------
    # ACCOUNT TYPE
    # ------------------------------------------

    account_types = (
        "Savings",
        "Current"
    )

    print("\nAccount Types:")

    for account_type in account_types:

        print("-", account_type)

    account_type = input(
        "Enter account type: "
    ).strip().title()

    if account_type not in account_types:

        print("\nInvalid account type.")

        return

    # ------------------------------------------
    # INITIAL DEPOSIT
    # ------------------------------------------

    try:

        initial_deposit = float(
            input(
                "Enter initial deposit: ₹"
            )
        )

        if initial_deposit < 0:

            print(
                "\nInitial deposit cannot be negative."
            )

            return

    except ValueError:

        print(
            "\nPlease enter a valid amount."
        )

        return

    # ------------------------------------------
    # ACCOUNT NUMBER
    # ------------------------------------------

    account_number = generate_account_number()

    # ------------------------------------------
    # CREATE ACCOUNT
    # ------------------------------------------

    account = {

        "account_number": account_number,

        "name": name,

        "phone": phone,

        "email": email,

        "account_type": account_type,

        "balance": initial_deposit,

        "transactions": []

    }

    # ------------------------------------------
    # ADD INITIAL TRANSACTION
    # ------------------------------------------

    if initial_deposit > 0:

        transaction = {

            "type": "Deposit",

            "amount": initial_deposit,

            "date": datetime.now().strftime(
                "%Y-%m-%d %H:%M:%S"
            ),

            "description": "Initial Deposit"

        }

        account["transactions"].append(
            transaction
        )

    accounts.append(account)

    print("\n" + "=" * 50)

    print("ACCOUNT CREATED SUCCESSFULLY!")

    print("=" * 50)

    print(
        "Account Number:",
        account_number
    )

    print(
        "Customer Name:",
        name
    )

    print(
        "Account Type:",
        account_type
    )

    print(
        "Balance: ₹",
        initial_deposit
    )


# ==========================================================
# 5. VIEW ALL ACCOUNTS
# ==========================================================

def view_accounts():

    if not accounts:

        print("\nNo accounts available.")

        return

    print("\n" + "=" * 100)

    print(
        f"{'ID':<5}"
        f"{'Account No.':<15}"
        f"{'Name':<20}"
        f"{'Type':<12}"
        f"{'Balance':<15}"
    )

    print("=" * 100)

    for index, account in enumerate(
        accounts,
        start=1
    ):

        print(
            f"{index:<5}"
            f"{account['account_number']:<15}"
