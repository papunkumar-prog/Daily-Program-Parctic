# ==========================================================
# 12. TRANSACTION HISTORY
# ==========================================================

def transaction_history():

    account_number = input(
        "\nEnter account number: "
    ).strip().upper()

    account = find_account(
        account_number
    )

    if account is None:

        print("\nAccount not found.")

        return

    transactions = account["transactions"]

    if not transactions:

        print("\nNo transactions found.")

        return

    print("\n" + "=" * 80)

    print(
        f"{'ID':<5}"
        f"{'Type':<20}"
        f"{'Amount':<15}"
        f"{'Date':<22}"
        f"{'Description':<30}"
    )

    print("=" * 80)

    for index, transaction in enumerate(
        transactions,
        start=1
    ):

        print(
            f"{index:<5}"
            f"{transaction['type']:<20}"
            f"₹{transaction['amount']:<14.2f}"
            f"{transaction['date']:<22}"
            f"{transaction['description']:<30}"
        )


# ==========================================================
# 13. DELETE ACCOUNT
# ==========================================================

def delete_account():

    account_number = input(
        "\nEnter account number to delete: "
    ).strip().upper()

    account = find_account(
        account_number
    )

    if account is None:

        print("\nAccount not found.")

        return

    print("\nAccount found.")

    print(
        "Name:",
        account["name"]
    )

    print(
        "Balance: ₹",
        account["balance"]
    )

    # Do not delete account with money

    if account["balance"] > 0:

        print(
            "\nAccount cannot be deleted "
            "while balance is greater than zero."
        )

        return

    confirm = input(
        "\nAre you sure? (yes/no): "
    ).strip().lower()

    if confirm == "yes":

        accounts.remove(account)

        print(
            "\nAccount deleted successfully!"
        )

    else:

        print("\nDelete cancelled.")


