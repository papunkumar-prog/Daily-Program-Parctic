            f"{account['account_type']:<12}"
            f"₹{account['balance']:<14.2f}"
        )


# ==========================================================
# 6. FIND ACCOUNT
# ==========================================================

def find_account(account_number):

    for account in accounts:

        if (
            account["account_number"]
            == account_number
        ):

            return account

    return None


# ==========================================================
# 7. SEARCH ACCOUNT
# ==========================================================

def search_account():

    search = input(
        "\nEnter account number or name: "
    ).strip().lower()

    found = False

    for account in accounts:

        if (
            search
            == account["account_number"].lower()
            or search
            in account["name"].lower()
        ):

            print("\n" + "-" * 45)

            print(
                "Account Number:",
                account["account_number"]
            )

            print(
                "Name:",
                account["name"]
            )

            print(
                "Phone:",
                account["phone"]
            )

            print(
                "Email:",
                account["email"]
            )

            print(
                "Account Type:",
                account["account_type"]
            )

            print(
                "Balance: ₹",
                account["balance"]
            )

            print("-" * 45)

            found = True

    if not found:

        print("\nAccount not found.")


# ==========================================================
# 8. DEPOSIT MONEY
# ==========================================================

def deposit_money():

    account_number = input(
        "\nEnter account number: "
    ).strip().upper()

    account = find_account(
        account_number
    )

    if account is None:

        print("\nAccount not found.")

        return

    try:

        amount = float(
            input(
                "Enter deposit amount: ₹"
            )
        )

        if amount <= 0:

            print(
                "\nAmount must be greater than zero."
            )

            return

    except ValueError:

        print(
            "\nPlease enter a valid amount."
        )

        return

    # Update balance

    account["balance"] += amount

    # Create transaction

    transaction = {

        "type": "Deposit",

        "amount": amount,

        "date": datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S"
        ),

        "description": "Money Deposited"

    }

    account["transactions"].append(
        transaction
    )

    print("\nDeposit successful!")

    print(
        "Deposited: ₹",
        amount
    )

    print(
        "New Balance: ₹",
        account["balance"]
    )


# ==========================================================
# 9. WITHDRAW MONEY
# ==========================================================

def withdraw_money():

    account_number = input(
        "\nEnter account number: "
    ).strip().upper()

    account = find_account(
        account_number
    )

    if account is None:

        print("\nAccount not found.")

        return

    try:

        amount = float(
            input(
                "Enter withdrawal amount: ₹"
            )
        )

        if amount <= 0:

            print(
                "\nAmount must be greater than zero."
            )

            return

    except ValueError:

        print(
            "\nPlease enter a valid amount."
        )

        return

    # Check balance

    if amount > account["balance"]:

        print("\nInsufficient balance.")

        print(
            "Available Balance: ₹",
            account["balance"]
        )

        return

    # Update balance

    account["balance"] -= amount

    # Create transaction

    transaction = {

        "type": "Withdrawal",

        "amount": amount,

        "date": datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S"
        ),

        "description": "Money Withdrawn"

    }

    account["transactions"].append(
        transaction
    )

    print("\nWithdrawal successful!")

    print(
        "Withdrawn: ₹",
        amount
    )

    print(
        "Remaining Balance: ₹",
        account["balance"]
    )


# ==========================================================
# 10. TRANSFER MONEY
# ==========================================================

def transfer_money():

    print("\n" + "=" * 50)
    print("MONEY TRANSFER")
    print("=" * 50)

    sender_number = input(
        "Enter sender account number: "
    ).strip().upper()

    sender = find_account(
        sender_number
    )

    if sender is None:

        print("\nSender account not found.")

        return

    receiver_number = input(
        "Enter receiver account number: "
    ).strip().upper()

    receiver = find_account(
        receiver_number
    )

    if receiver is None:

        print("\nReceiver account not found.")

        return

    if sender_number == receiver_number:

        print(
            "\nSender and receiver cannot be same."
        )

        return

    try:

        amount = float(
            input(
                "Enter transfer amount: ₹"
            )
        )

        if amount <= 0:

            print(
                "\nAmount must be greater than zero."
            )

            return

    except ValueError:

        print(
            "\nPlease enter a valid amount."
        )

        return

    if amount > sender["balance"]:

        print("\nInsufficient balance.")

        return

    # ------------------------------------------
    # REMOVE MONEY FROM SENDER
    # ------------------------------------------

    sender["balance"] -= amount

    # ------------------------------------------
    # ADD MONEY TO RECEIVER
    # ------------------------------------------

    receiver["balance"] += amount

    current_time = datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    # ------------------------------------------
    # SENDER TRANSACTION
    # ------------------------------------------

    sender_transaction = {

        "type": "Transfer Sent",

        "amount": amount,

        "date": current_time,

        "description":
            f"Transferred to {receiver_number}"

    }

    sender["transactions"].append(
        sender_transaction
    )

    # ------------------------------------------
    # RECEIVER TRANSACTION
    # ------------------------------------------

    receiver_transaction = {

        "type": "Transfer Received",

        "amount": amount,

        "date": current_time,

        "description":
            f"Received from {sender_number}"

    }

    receiver["transactions"].append(
        receiver_transaction
    )

    print("\nTransfer successful!")

    print(
        "Amount transferred: ₹",
        amount
    )


