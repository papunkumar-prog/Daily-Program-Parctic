# ==========================================================
# 16. BANK STATISTICS
# ==========================================================

def bank_statistics():

    if not accounts:

        print("\nNo accounts available.")

        return

    total_accounts = len(accounts)

    savings = 0
    current = 0

    total_balance = 0

    for account in accounts:

        total_balance += account["balance"]

        if account["account_type"] == "Savings":

            savings += 1

        elif account["account_type"] == "Current":

            current += 1

    print("\n" + "=" * 45)

    print("BANK STATISTICS")

    print("=" * 45)

    print(
        "Total Accounts:",
        total_accounts
    )

    print(
        "Savings Accounts:",
        savings
    )

    print(
        "Current Accounts:",
        current
    )

    print(
        "Total Bank Balance: ₹",
        total_balance
    )


