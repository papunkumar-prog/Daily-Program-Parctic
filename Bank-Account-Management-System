# ==========================================================
# 18. SHOW UNIQUE ACCOUNT TYPES USING SET
# ==========================================================

def unique_account_types():

    if not accounts:

        print("\nNo accounts available.")

        return

    types = set()

    for account in accounts:

        types.add(
            account["account_type"]
        )

    print("\nUnique Account Types:")

    for account_type in types:

        print("-", account_type)


# ==========================================================
# 19. NUMPY BALANCE ANALYSIS
# ==========================================================

def numpy_balance_analysis():

    if not accounts:

        print("\nNo accounts available.")

        return

    balances = []

    for account in accounts:

        balances.append(
            account["balance"]
        )

    balance_array = np.array(
        balances
    )

    print("\n" + "=" * 50)

    print("NUMPY BALANCE ANALYSIS")

    print("=" * 50)

    print(
        "Balance Array:",
        balance_array
    )

    print(
        "Total Balance: ₹",
        np.sum(balance_array)
    )

    print(
        "Average Balance: ₹",
        np.mean(balance_array)
    )

    print(
        "Highest Balance: ₹",
        np.max(balance_array)
    )

    print(
        "Lowest Balance: ₹",
        np.min(balance_array)
    )

    print(
        "Standard Deviation:",
        np.std(balance_array)
    )


# ==========================================================
# 20. SORT ACCOUNTS BY BALANCE
# ==========================================================

def sort_by_balance():

    if not accounts:

        print("\nNo accounts available.")

        return

    sorted_accounts = sorted(
        accounts,
        key=lambda x: x["balance"],
        reverse=True
    )

    print("\n" + "=" * 60)

    print("ACCOUNTS SORTED BY BALANCE")

    print("=" * 60)

    for account in sorted_accounts:

        print(
            account["account_number"],
            "|",
            account["name"],
            "| ₹",
            account["balance"]
        )


