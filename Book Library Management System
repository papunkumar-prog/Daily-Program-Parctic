from flask import Flask, request, jsonify

app = Flask(__name__)


# Store book records in a list of dictionaries
books = [
    {
        "id": 201,
        "title": "Python Basics",
        "author": "Rahul",
        "copies": 5
    },
    {
        "id": 202,
        "title": "Learn Flask",
        "author": "Amit",
        "copies": 3
    },
    {
        "id": 203,
        "title": "SQL for Beginners",
        "author": "Priya",
        "copies": 4
    }
]


# --------------------------------------------------
# 1. HOME ROUTE
# Flow: Receive request -> Return welcome message
# --------------------------------------------------
@app.route("/")
def home():
    return jsonify({
        "message": "Book Library API is running"
    }), 200


# --------------------------------------------------
# 2. GET ALL BOOKS
# Flow: Read book list -> Return JSON response
# --------------------------------------------------
@app.route("/api/books", methods=["GET"])
def get_books():
    return jsonify(books), 200


# --------------------------------------------------
# 3. GET ONE BOOK
# Flow: Read book ID -> Search -> Return book
# --------------------------------------------------
@app.route("/api/books/<int:book_id>", methods=["GET"])
def get_book(book_id):

    for book in books:
        if book["id"] == book_id:
            return jsonify(book), 200

    return jsonify({
        "error": "Book not found"
    }), 404


# --------------------------------------------------
# 4. ADD A NEW BOOK
# Flow: Read JSON -> Validate -> Generate ID
#       -> Add book -> Return response
# --------------------------------------------------
@app.route("/api/books", methods=["POST"])
def add_book():

    data = request.get_json(silent=True)

    if not isinstance(data, dict):
        return jsonify({
            "error": "A valid JSON object is required"
        }), 400

    if not all(key in data for key in
               ["title", "author", "copies"]):
        return jsonify({
            "error": "Title, author and copies are required"
        }), 400

    title = data["title"]
    author = data["author"]
    copies = data["copies"]

    if not isinstance(title, str) or not isinstance(author, str):
        return jsonify({
            "error": "Title and author must be text"
        }), 400

    title = title.strip()
    author = author.strip()

    if not title or not author:
        return jsonify({
            "error": "Title and author cannot be empty"
        }), 400

    if isinstance(copies, bool) or not isinstance(copies, int):
        return jsonify({
            "error": "Copies must be a whole number"
        }), 400

    if copies < 0:
        return jsonify({
            "error": "Copies cannot be negative"
        }), 400

    # Generate the next available ID
    if books:
        new_id = max(book["id"] for book in books) + 1
    else:
        new_id = 201

    new_book = {
        "id": new_id,
        "title": title,
        "author": author,
        "copies": copies
    }

    books.append(new_book)

    return jsonify({
        "message": "Book added successfully",
        "book": new_book
    }), 201


# --------------------------------------------------
# 5. UPDATE AN EXISTING BOOK
# Flow: Read ID and JSON -> Validate -> Find book
#       -> Update details -> Return response
# --------------------------------------------------
@app.route("/api/books/<int:book_id>", methods=["PUT"])
def update_book(book_id):

    data = request.get_json(silent=True)

    if not isinstance(data, dict):
        return jsonify({
            "error": "A valid JSON object is required"
        }), 400

    if not all(key in data for key in
               ["title", "author", "copies"]):
        return jsonify({
            "error": "Title, author and copies are required"
        }), 400

    title = data["title"]
    author = data["author"]
    copies = data["copies"]

    if not isinstance(title, str) or not isinstance(author, str):
        return jsonify({
            "error": "Title and author must be text"
        }), 400

    title = title.strip()
    author = author.strip()

    if not title or not author:
        return jsonify({
            "error": "Title and author cannot be empty"
        }), 400

    if isinstance(copies, bool) or not isinstance(copies, int):
        return jsonify({
            "error": "Copies must be a whole number"
        }), 400

    if copies < 0:
        return jsonify({
            "error": "Copies cannot be negative"
        }), 400

    for book in books:
        if book["id"] == book_id:
            book["title"] = title
            book["author"] = author
            book["copies"] = copies

            return jsonify({
                "message": "Book updated successfully",
                "book": book
            }), 200

    return jsonify({
        "error": "Book not found"
    }), 404


# --------------------------------------------------
# 6. DELETE A BOOK
# Flow: Read ID -> Search book -> Remove -> Respond
# --------------------------------------------------
@app.route("/api/books/<int:book_id>", methods=["DELETE"])
def delete_book(book_id):

    for book in books:
        if book["id"] == book_id:
            books.remove(book)

            return jsonify({
                "message": "Book deleted successfully"
            }), 200

    return jsonify({
        "error": "Book not found"
    }), 404


# --------------------------------------------------
# 7. SEARCH BOOKS BY AUTHOR
# Flow: Read query -> Search author -> Return matches
# --------------------------------------------------
@app.route("/api/books/search", methods=["GET"])
def search_books():

    author_name = request.args.get("author", "").strip()

    if not author_name:
        return jsonify({
            "error": "Please provide an author name"
        }), 400

    matched_books = []

    for book in books:
        if author_name.lower() in book["author"].lower():
            matched_books.append(book)

    return jsonify({
        "count": len(matched_books),
        "books": matched_books
    }), 200


# --------------------------------------------------
# 8. LIBRARY SUMMARY
# Flow: Count books -> Calculate copies -> Return totals
# --------------------------------------------------
@app.route("/api/books/summary", methods=["GET"])
def book_summary():

    total_titles = len(books)

    total_copies = sum(
        book["copies"] for book in books
    )

    out_of_stock = sum(
        1 for book in books if book["copies"] == 0
    )

    return jsonify({
        "total_titles": total_titles,
        "total_copies": total_copies,
        "out_of_stock_titles": out_of_stock
    }), 200


# --------------------------------------------------
# 9. START THE FLASK SERVER
# Flow: Start server -> Wait for incoming requests
# --------------------------------------------------
if __name__ == "__main__":
    app.run(debug=True)
