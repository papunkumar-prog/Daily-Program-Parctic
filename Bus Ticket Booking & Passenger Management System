# 7. REVENUE ANALYSIS USING NUMPY

# ============================================================

def revenue_analysis():

```
print("\n========== 📊 REVENUE ANALYSIS ==========")

if len(bookings) == 0:

    print("No booking data available.")

    return

# Extract total amount from each booking
revenue = np.array(
    [booking["total"] for booking in bookings]
)

# Extract number of tickets
tickets = np.array(
    [booking["tickets"] for booking in bookings]
)

print(
    "Total Revenue: ₹",
    np.sum(revenue)
)

print(
    "Average Booking: ₹",
    np.mean(revenue)
)

print(
    "Highest Booking: ₹",
    np.max(revenue)
)

print(
    "Lowest Booking: ₹",
    np.min(revenue)
)

print(
    "Total Tickets Sold:",
    np.sum(tickets)
)
```

