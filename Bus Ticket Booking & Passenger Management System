# 9. BUS SUMMARY

# ============================================================

def bus_summary():

```
print("\n========== 🚌 BUS SUMMARY ==========")

total_seats = 0
available_seats = 0

for bus in buses:

    total_seats += 50

    available_seats += bus["seats"]

booked_seats = (
    total_seats - available_seats
)

print(
    "Total Bus Capacity:",
    total_seats
)

print(
    "Available Seats:",
    available_seats
)

print(
    "Booked Seats:",
    booked_seats
)

if total_seats > 0:

    occupancy = (
        booked_seats / total_seats
    ) * 100

    print(
        "Occupancy:",
        round(occupancy, 2),
        "%"
    )
```

