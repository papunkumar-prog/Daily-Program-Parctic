# 10. ADD NEW BUS

# ============================================================

def add_bus():

```
print("\n========== ➕ ADD NEW BUS ==========")

try:

    bus_id = int(
        input("Enter Bus ID: ")
    )

    bus_name = input(
        "Enter Bus Name: "
    ).strip().title()

    print("\nAvailable Routes:")

    for route in routes:

        print("-", route)

    route = input(
        "Enter Route: "
    ).strip().title()

    if route not in routes:

        print("❌ Invalid route.")

        return

    price = float(
        input("Enter Ticket Price: ")
    )

    seats = int(
        input("Enter Total Seats: ")
    )

    if price <= 0:

        print("❌ Price must be greater than 0.")

        return

    if seats <= 0:

        print("❌ Seats must be greater than 0.")

        return

    # Check duplicate ID
    for bus in buses:

        if bus["bus_id"] == bus_id:

            print(
                "❌ Bus ID already exists."
            )

            return

    new_bus = {

        "bus_id": bus_id,
        "bus_name": bus_name,
        "route": route,
        "price": price,
        "seats": seats
    }

    buses.append(new_bus)

    print(
        "✅ New bus added successfully."
    )

except ValueError:

    print(
        "❌ Please enter valid values."
    )
```

