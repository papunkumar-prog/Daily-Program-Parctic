# 3. BOOK TICKET

# ============================================================

def book_ticket():

```
print("\n========== 🎟️ BOOK TICKET ==========")

try:

    bus_id = int(
        input("Enter Bus ID: ")
    )

    passenger = input(
        "Enter Passenger Name: "
    ).strip().title()

    age = int(
        input("Enter Passenger Age: ")
    )

    ticket_count = int(
        input("Enter Number of Tickets: ")
    )

    if age <= 0:

        print("❌ Invalid age.")
        return

    if ticket_count <= 0:

        print("❌ Ticket count must be greater than 0.")
        return

    # Find bus
    for bus in buses:

        if bus["bus_id"] == bus_id:

            # Check available seats
            if bus["seats"] >= ticket_count:

                total = (
                    bus["price"] * ticket_count
                )

                # Reduce available seats
                bus["seats"] -= ticket_count

                booking = {

                    "passenger": passenger,
                    "age": age,
                    "bus_id": bus_id,
                    "bus_name": bus["bus_name"],
                    "route": bus["route"],
                    "tickets": ticket_count,
                    "price": bus["price"],
                    "total": total
                }

                bookings.append(booking)

                print(
                    "\n✅ Ticket booked successfully!"
                )

                print(
                    "Passenger:",
                    passenger
                )

                print(
                    "Bus:",
                    bus["bus_name"]
                )

                print(
                    "Destination:",
                    bus["route"]
                )

                print(
                    "Tickets:",
                    ticket_count
                )

                print(
                    "Total Amount: ₹",
                    total
                )

                return

            else:

                print(
                    "❌ Not enough seats available."
                )

                return

    print("❌ Bus ID not found.")

except ValueError:

    print("❌ Please enter valid values.")
```

