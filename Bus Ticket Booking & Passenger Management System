# 4. CANCEL TICKET

# ============================================================

def cancel_ticket():

```
print("\n========== ❌ CANCEL TICKET ==========")

if len(bookings) == 0:

    print("No bookings available.")

    return

passenger = input(
    "Enter Passenger Name: "
).strip().title()

found = False

for booking in bookings:

    if booking["passenger"] == passenger:

        # Return seats to the bus
        for bus in buses:

            if bus["bus_id"] == booking["bus_id"]:

                bus["seats"] += booking["tickets"]

                break

        bookings.remove(booking)

        print(
            "✅ Ticket cancelled successfully."
        )

        found = True

        return

if not found:

    print("❌ Booking not found.")
```

