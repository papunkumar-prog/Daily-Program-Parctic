# 8. ROUTE-WISE ANALYSIS

# ============================================================

def route_analysis():

```
print("\n========== 📊 ROUTE ANALYSIS ==========")

for route in routes:

    ticket_count = 0
    revenue = 0

    for booking in bookings:

        if booking["route"] == route:

            ticket_count += booking["tickets"]

            revenue += booking["total"]

    print("\nRoute:", route)

    print(
        "Tickets Sold:",
        ticket_count
    )

    print(
        "Revenue: ₹",
        revenue
    )
```

