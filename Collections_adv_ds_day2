# ChainMap
from collections import ChainMap
student = {
    "name" : "Papun",
    "age" : 22
}
course = {
    "course" : "Python",
    "duration" : "6 Months"
}
data = ChainMap(student, course)
print(data["name"])
print(data["course"])

# Why ChainMap is useful
default_settings = {
    "theme": "light",
    "language": "English"
}

user_settings = {
    "theme": "dark"
}
from collections import ChainMap
settings = ChainMap(user_settings, default_settings)
print(settings["theme"])
print(settings["language"])

#UserDict

from collections import UserDict
class MyDict(UserDict):
    def add_data(self, key, value):
        self.data[key] = value
d = MyDict()
d.add_data("name", "Papun")
d.add_data("age", 30)
print(d)

# UserList
from collections import UserList
class MyList(UserList):
    def add_item(self, value):
        self.data.append(value)
n = MyList()
n.add_item(10)
n.add_item(20)
print(n)

# UserString

from collections import UserString
class MyString(UserString):
    def reverse(self):
        return self.data[::-1]
text = MyString("Python")
print(text.reverse())

