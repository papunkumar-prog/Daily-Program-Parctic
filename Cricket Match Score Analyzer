# 6. HIGHEST RUN SCORER

# ============================================================

def highest_scorer():

```
print("\n========== 🏆 HIGHEST RUN SCORER ==========")

if len(players) == 0:

    print("No players available.")

    return

highest = players[0]

for player in players:

    if player["runs"] > highest["runs"]:

        highest = player

print(
    "Player:",
    highest["name"]
)

print(
    "Team:",
    highest["team"]
)

print(
    "Runs:",
    highest["runs"]
)
```

