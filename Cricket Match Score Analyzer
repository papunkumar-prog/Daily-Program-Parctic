# ============================================================

# 8. NUMPY SCORE ANALYSIS

# ============================================================

def score_analysis():

```
print("\n========== 📊 NUMPY SCORE ANALYSIS ==========")

if len(players) == 0:

    print(
        "No player data available."
    )

    return

# Create NumPy array of runs
runs = np.array(
    [player["runs"] for player in players]
)

print(
    "Total Runs:",
    np.sum(runs)
)

print(
    "Average Runs:",
    round(np.mean(runs), 2)
)

print(
    "Highest Runs:",
    np.max(runs)
)

print(
    "Lowest Runs:",
    np.min(runs)
)
```

# ============================================================

# 9. TEAM ANALYSIS

# ============================================================

def team_analysis():

```
print("\n========== 📊 TEAM ANALYSIS ==========")

for team in teams:

    total_runs = 0
    total_wickets = 0
    player_count = 0

    for player in players:

        if player["team"] == team:

            total_runs += player["runs"]

            total_wickets += player["wickets"]

            player_count += 1

    print("\nTeam:", team)
    print("Players:", player_count)
    print("Total Runs:", total_runs)
    print("Total Wickets:", total_wickets)
```

