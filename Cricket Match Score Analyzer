# 5. CALCULATE STRIKE RATE

# ============================================================

def strike_rate():

```
print("\n========== ⚡ STRIKE RATE ==========")

found = False

for player in players:

    if player["balls"] > 0:

        rate = (
            player["runs"]
            / player["balls"]
        ) * 100

        print(
            player["name"],
            "→",
            round(rate, 2)
        )

        found = True

if not found:

    print("No batting data available.")
```

