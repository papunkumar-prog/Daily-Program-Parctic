# 1. DISPLAY PLAYERS

# ============================================================

def display_players():

```
print("\n========== 🏏 ALL PLAYERS ==========")

for player in players:

    print(
        f'ID: {player["id"]} | '
        f'Name: {player["name"]} | '
        f'Team: {player["team"]} | '
        f'Runs: {player["runs"]} | '
        f'Balls: {player["balls"]} | '
        f'Wickets: {player["wickets"]}'
    )
```

# ============================================================

# 2. SEARCH PLAYER

# ============================================================

def search_player():

```
print("\n========== 🔍 SEARCH PLAYER ==========")

name = input(
    "Enter player name: "
).strip().lower()

found = False

for player in players:

    if name in player["name"].lower():

        print("\nPlayer Found!")

        print("Name:", player["name"])
        print("Team:", player["team"])
        print("Runs:", player["runs"])
        print("Balls:", player["balls"])
        print("Wickets:", player["wickets"])

        found = True

if not found:

    print("❌ Player not found.")
```

# ============================================================

# 3. ADD PLAYER

# ============================================================

def add_player():

```
print("\n========== ➕ ADD PLAYER ==========")

try:

    player_id = int(
        input("Enter Player ID: ")
    )

    name = input(
        "Enter Player Name: "
    ).strip().title()

    print("\nAvailable Teams:")

    for team in teams:

        print("-", team)

    team = input(
        "Enter Team: "
    ).strip().title()

    if team not in teams:

        print("❌ Invalid team.")

        return

    # Check duplicate ID
    for player in players:

        if player["id"] == player_id:

            print(
                "❌ Player ID already exists."
            )

            return

    new_player = {

        "id": player_id,
        "name": name,
        "team": team,
        "runs": 0,
        "balls": 0,
        "wickets": 0
    }

    players.append(new_player)

    print(
        "✅ Player added successfully."
    )

except ValueError:

    print(
        "❌ Please enter valid values."
    )
```

# ============================================================

# 4. UPDATE PLAYER SCORE

# ============================================================

def update_score():

```
print("\n========== 📝 UPDATE PLAYER SCORE ==========")

try:

    player_id = int(
        input("Enter Player ID: ")
    )

    for player in players:

        if player["id"] == player_id:

            runs = int(
                input("Enter Runs: ")
            )

            balls = int(
                input("Enter Balls Faced: ")
            )

            wickets = int(
                input("Enter Wickets: ")
            )

            if runs < 0 or balls < 0 or wickets < 0:

                print(
                    "❌ Values cannot be negative."
                )

                return

            player["runs"] = runs
            player["balls"] = balls
            player["wickets"] = wickets

            print(
                "✅ Player score updated."
            )

            return

    print(
        "❌ Player ID not found."
    )

except ValueError:

    print(
        "❌ Please enter numbers only."
    )
```

