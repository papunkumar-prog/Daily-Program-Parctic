# 10. MATCH RESULT

# ============================================================

def match_result():

```
print("\n========== 🏆 MATCH RESULT ==========")

team1 = input(
    "Enter Team 1: "
).strip().title()

team2 = input(
    "Enter Team 2: "
).strip().title()

if team1 not in teams or team2 not in teams:

    print(
        "❌ Invalid team name."
    )

    return

if team1 == team2:

    print(
        "❌ Teams must be different."
    )

    return

score1 = int(
    input(
        f"Enter {team1} Score: "
    )
)

score2 = int(
    input(
        f"Enter {team2} Score: "
    )
)

if score1 > score2:

    print(
        f"🏆 {team1} won the match!"
    )

elif score2 > score1:

    print(
        f"🏆 {team2} won the match!"
    )

else:

    print(
        "🤝 Match Draw!"
    )
```

