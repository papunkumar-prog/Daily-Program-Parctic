@app.route("/api/leads/<int:lead_id>", methods=["GET"])
def get_lead(lead_id):

    lead = find_lead(lead_id)

    if lead is None:
        return jsonify({
            "error": "Lead not found"
        }), 404

    return jsonify(lead), 200


# --------------------------------------------------
# 4. ADD A NEW LEAD
# Flow: Read JSON -> Validate -> Check duplicate email
#       -> Generate ID -> Save lead -> Return response
# --------------------------------------------------
@app.route("/api/leads", methods=["POST"])
def add_lead():

    data = request.get_json(silent=True)

    lead_data, error = validate_lead(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    # Check duplicate email
    if check_duplicate_email(lead_data["email"]):
        return jsonify({
            "error": "Email already registered"
        }), 409

    # Generate next available lead ID
    if leads:
        new_id = max(lead["id"] for lead in leads) + 1
    else:
        new_id = 1001

    new_lead = {
        "id": new_id,
        **lead_data,
        "created_date": date.today().isoformat()
    }

    leads.append(new_lead)

    return jsonify({
        "message": "Lead added successfully",
        "lead": new_lead
    }), 201


# --------------------------------------------------
# 5. UPDATE LEAD DETAILS
# Flow: Read ID -> Validate JSON -> Find lead
#       -> Check duplicate email -> Update -> Respond
# --------------------------------------------------
@app.route("/api/leads/<int:lead_id>", methods=["PUT"])
def update_lead(lead_id):

    data = request.get_json(silent=True)

    lead_data, error = validate_lead(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    lead = find_lead(lead_id)

    if lead is None:
        return jsonify({
            "error": "Lead not found"
        }), 404

    if check_duplicate_email(
        lead_data["email"],
        exclude_id=lead_id
    ):
        return jsonify({
            "error": "Email already belongs to another lead"
        }), 409

    lead.update(lead_data)

    return jsonify({
        "message": "Lead updated successfully",
        "lead": lead
    }), 200


# --------------------------------------------------
# 6. DELETE A LEAD
# Flow: Read lead ID -> Find lead -> Remove lead
#       -> Return response
# --------------------------------------------------
@app.route("/api/leads/<int:lead_id>", methods=["DELETE"])
def delete_lead(lead_id):

    lead = find_lead(lead_id)

    if lead is None:
        return jsonify({
            "error": "Lead not found"
        }), 404

    leads.remove(lead)

    return jsonify({
        "message": "Lead deleted successfully"
    }), 200


# --------------------------------------------------
# 7. FIND PENDING FOLLOW-UPS
# Flow: Read due date -> Find active leads
#       -> Compare follow-up dates -> Return results
# --------------------------------------------------
@app.route("/api/leads/follow-ups", methods=["GET"])
def get_follow_ups():

    due_before_text = request.args.get("due_before")

    if due_before_text:
        due_before = parse_date(due_before_text)
    else:
        due_before = date.today()

    if due_before is None:
        return jsonify({
            "error": "Invalid due_before date. Use YYYY-MM-DD"
        }), 400

    today = date.today()
    pending_follow_ups = []

    for lead in leads:

        if lead["status"] in ["Won", "Lost"]:
            continue

        follow_up = parse_date(lead["follow_up_date"])

        if follow_up <= due_before:

            lead_copy = lead.copy()

            lead_copy["days_overdue"] = max(
                0, (today - follow_up).days
            )

            pending_follow_ups.append(lead_copy)

    return jsonify({
        "due_before": due_before.isoformat(),
        "total_follow_ups": len(pending_follow_ups),
        "follow_ups": pending_follow_ups
    }), 200


# --------------------------------------------------
# 8. CRM SALES SUMMARY
# Flow: Count lead statuses -> Calculate pipeline value
#       -> Calculate won value -> Return sales report
# --------------------------------------------------
@app.route("/api/leads/summary", methods=["GET"])
def lead_summary():

    status_counts = {
        status: 0 for status in LEAD_STATUSES
    }

    pipeline_value = 0
    won_value = 0

    for lead in leads:

        status_counts[lead["status"]] += 1

        # Calculate active sales pipeline
        if lead["status"] not in ["Won", "Lost"]:
            pipeline_value += lead["estimated_value"]

        # Calculate successful sales value
        elif lead["status"] == "Won":
            won_value += lead["estimated_value"]

    return jsonify({
        "total_leads": len(leads),
        "new_leads": status_counts["New"],
        "contacted_leads": status_counts["Contacted"],
        "qualified_leads": status_counts["Qualified"],
        "proposal_leads": status_counts["Proposal"],
        "won_leads": status_counts["Won"],
        "lost_leads": status_counts["Lost"],
        "active_pipeline_value": round(pipeline_value, 2),
        "won_sales_value": round(won_value, 2)
    }), 200


