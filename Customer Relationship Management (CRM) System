# --------------------------------------------------
# 2. GET ALL LEADS
# Flow: Read filters -> Filter lead records
#       -> Return matching leads
# --------------------------------------------------
@app.route("/api/leads", methods=["GET"])
def get_leads():

    filtered_leads = leads

    # Filter by lead status
    status = request.args.get("status")

    if status:

        status = status.strip().title()

        if status not in LEAD_STATUSES:
            return jsonify({
                "error": "Invalid lead status"
            }), 400

        filtered_leads = [
            lead for lead in filtered_leads
            if lead["status"] == status
        ]

    # Filter by lead source
    source = request.args.get("source")

    if source:

        source = source.strip().title()

        if source not in LEAD_SOURCES:
            return jsonify({
                "error": "Invalid lead source"
            }), 400

        filtered_leads = [
            lead for lead in filtered_leads
            if lead["source"] == source
        ]

    # Filter by assigned employee
    assigned_to = request.args.get("assigned_to")

    if assigned_to is not None:

        assigned_to = assigned_to.strip().lower()

        if not assigned_to:
            return jsonify({
                "error": "Employee name cannot be empty"
            }), 400

        filtered_leads = [
            lead for lead in filtered_leads
            if assigned_to in lead["assigned_to"].lower()
        ]

    return jsonify({
        "total_leads": len(filtered_leads),
        "leads": filtered_leads
    }), 200


