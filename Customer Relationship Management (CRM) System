# --------------------------------------------------
# HELPER FUNCTION: FIND LEAD
# Flow: Receive lead ID -> Search list -> Return lead
# --------------------------------------------------
def find_lead(lead_id):

    for lead in leads:

        if lead["id"] == lead_id:
            return lead

    return None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE DATE
# Flow: Receive date -> Check format -> Return date
# --------------------------------------------------
def parse_date(value):

    if not isinstance(value, str):
        return None

    try:
        parsed_date = date.fromisoformat(value)

        if parsed_date.isoformat() != value:
            return None

        return parsed_date

    except ValueError:
        return None


# --------------------------------------------------
# HELPER FUNCTION: CHECK DUPLICATE EMAIL
# Flow: Search lead records -> Compare email addresses
#       -> Return True if email already exists
# --------------------------------------------------
def check_duplicate_email(email, exclude_id=None):

    for lead in leads:

        if (
            lead["email"].lower() == email.lower()
            and lead["id"] != exclude_id
        ):
            return True

    return False


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE LEAD DATA
# Flow: Read JSON -> Check fields -> Validate details
#       -> Return cleaned lead information
# --------------------------------------------------
def validate_lead(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "lead_name",
        "company_name",
        "email",
        "phone",
        "source",
        "status",
        "assigned_to",
        "estimated_value",
        "follow_up_date"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    lead_name = data["lead_name"]
    company_name = data["company_name"]
    email = data["email"]
    phone = data["phone"]
    source = data["source"]
    status = data["status"]
    assigned_to = data["assigned_to"]
    estimated_value = data["estimated_value"]
    follow_up_date = data["follow_up_date"]

    # Validate text fields
    text_fields = [
        lead_name,
        company_name,
        email,
        phone,
        source,
        status,
        assigned_to
    ]

    if not all(isinstance(value, str) for value in text_fields):
        return None, "Lead details must contain text"

    # Remove unnecessary spaces
    lead_name = lead_name.strip()
    company_name = company_name.strip()
    email = email.strip().lower()
    phone = phone.strip()
    source = source.strip().title()
    status = status.strip().title()
    assigned_to = assigned_to.strip()

    if not all([
        lead_name,
        company_name,
        email,
        phone,
        assigned_to
    ]):
        return None, "Lead details cannot be empty"

    # Basic email validation
    if "@" not in email or "." not in email.split("@")[-1]:
        return None, "Enter a valid email address"

    # Validate lead source
    if source not in LEAD_SOURCES:
        return None, "Invalid lead source"

    # Validate lead status
    if status not in LEAD_STATUSES:
        return None, "Invalid lead status"

    # Validate estimated sales value
    if (
        isinstance(estimated_value, bool)
        or not isinstance(estimated_value, (int, float))
    ):
        return None, "Estimated value must be a number"

    if not math.isfinite(estimated_value) or estimated_value < 0:
        return None, "Estimated value must be non-negative and finite"

    # Validate follow-up date
    parsed_follow_up = parse_date(follow_up_date)

    if parsed_follow_up is None:
        return None, "Invalid date. Use YYYY-MM-DD format"

    lead_data = {
        "lead_name": lead_name,
        "company_name": company_name,
        "email": email,
        "phone": phone,
        "source": source,
        "status": status,
        "assigned_to": assigned_to,
        "estimated_value": estimated_value,
        "follow_up_date": follow_up_date
    }

    return lead_data, None


