# Student Marks Analyzer

def analyze_students(students):
    topper_name = ""
    highest_mark = 0

    frequency = {}
    for student in students:
        name = student[0]
        marks = student[1]
        if marks > highest_mark:
            highest_mark = marks
            topper_name = name
        if marks in frequency:
            frequency[marks] = frequency[marks] + 1
        else:
            frequency[marks] = 1

    topper = (topper_name, highest_mark)

    return topper, frequency


students = [
    ("Papun", 85),
    ("Rahul", 72),
    ("Amit", 91),
    ("Ravi", 85)
]

topper, frequency = analyze_students(students)

print("Topper:", topper[0])
print("Marks:", topper[1])
print("Marks Frequency:", frequency)
