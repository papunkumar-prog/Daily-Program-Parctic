# 1. Sum of elements in a list
def sum_list(lst):
    return sum(lst)
print("1:", sum_list([1, 2, 3, 4]))

# 2. Find max and min in a tuple
def tuple_min_max(tpl):
    return min(tpl), max(tpl)
print("2:", tuple_min_max((5, 1, 9, 3)))

# 3. Merge two dictionaries
def merge_dicts(d1, d2):
    return {**d1, **d2}
print("3:", merge_dicts({'a': 1}, {'b': 2}))

# 4. Remove duplicates from a list using set
def remove_duplicates(lst):
    return list(set(lst))
print("4:", remove_duplicates([1, 2, 2, 3, 1]))

# 5. Count frequency of elements in a list
def frequency_count(lst):
    freq = {}
    for item in lst:
        freq[item] = freq.get(item, 0) + 1
    return freq
print("5:", frequency_count(['apple', 'banana', 'apple']))

# 6. Check if a key exists in a dictionary
def key_exists(d, key):
    return key in d
print("6:", key_exists({'x': 10, 'y': 20}, 'y'))

# 7. Find intersection of two sets
def set_intersection(s1, s2):
    return s1 & s2
print("7:", set_intersection({1, 2, 3}, {2, 3, 4}))

# 8. Reverse a list
def reverse_list(lst):
    return lst[::-1]
print("8:", reverse_list([1, 2, 3]))

# 9. Convert list of tuples to dictionary
def list_of_tuples_to_dict(lst):
    return dict(lst)
print("9:", list_of_tuples_to_dict([('a', 1), ('b', 2)]))

# 10. Find union of two sets
def set_union(s1, s2):
    return s1 | s2
print("10:", set_union({1, 2}, {2, 3}))

# 11. Sort dictionary by value
def sort_dict_by_value(d):
    return dict(sorted(d.items(), key=lambda x: x[1]))
print("11:", sort_dict_by_value({'a': 3, 'b': 1, 'c': 2}))

# 12. Find common elements in two lists
def common_elements(lst1, lst2):
    return list(set(lst1) & set(lst2))
print("12:", common_elements([1, 2, 3], [2, 3, 4]))

# 13. Convert dictionary keys to a list
def dict_keys_to_list(d):
    return list(d.keys())
print("13:", dict_keys_to_list({'x': 1, 'y': 2}))

# 14. Find difference between two sets
def set_difference(s1, s2):
    return s1 - s2
print("14:", set_difference({1, 2, 3}, {2, 4}))

# 15. Check if a list is a palindrome
def is_palindrome(lst):
    return lst == lst[::-1]
print("15:", is_palindrome([1, 2, 1]))

# 16. Swap keys and values in a dictionary
def swap_dict(d):
    return {v: k for k, v in d.items()}
print("16:", swap_dict({'a': 1, 'b': 2}))

# 17. Find length of each word in a list
def word_lengths(words):
    return {word: len(word) for word in words}
print("17:", word_lengths(['apple', 'banana']))

# 18. Convert list to tuple
def list_to_tuple(lst):
    return tuple(lst)
print("18:", list_to_tuple([1, 2, 3]))

# 19. Remove specific element from a set
def remove_from_set(s, elem):
    s.discard(elem)
    return s
print("19:", remove_from_set({1, 2, 3}, 2))

# 20. Create a dictionary from two lists
def dict_from_lists(keys, values):
    return dict(zip(keys, values))
print("20:", dict_from_lists(['a', 'b'], [1, 2]))
