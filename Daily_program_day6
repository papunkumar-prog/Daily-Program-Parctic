# Pattern Programs
# Square Pattern
for i in range(3):
    for j in range(3):
        print("*", end=" ")
    print()
# Right Triangle
for i in range(1, 5):
    for j in range(i):
        print("*", end=" ")
    print()
# Inverted Triangle
for i in range(4,0,-1):
    for j in range(i):
        print("*", end=" ")
    print()
# Number Triangle
for i in range(1, 5):
    for j in range(1, i+1):
        print(j, end=" ")
    print()
# Same Number pattern
for i in range(1, 5):
    for j in range(i):
        print(i, end=" ")
    print()
# Increasing Number Pattern
num = 1
for i in range(1, 5):
    for j in range(i):
        print(num, end=" ")
        num += 1
    print()
# Star Pyramid
for i in range(1, 10):
    print(" " * (9 - i), end=" ")
    for j in range(i):
        print("*", end=" ")
    print()
# Inverted Number Pattern
for i in range(4, 0, -1):
    for j in range(1, i + 1):
        print(j, end=" ")
    print()
# 0 and 1 Pattern
for i in range(1, 5):
    for j in range(i):
        print((i + j) % 2, end=" ")
    print()
# Hollow Square
n = 4
for i in range(n):
    for j in range(n):
        if i == 0 or i == n -1 or j == 0 or j == n - 1:
            print("*", end=" ")
        else:
            print(" ", end=" ")
    print()
