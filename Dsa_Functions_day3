# ============================================================
# 1. Two Sum
# LeetCode 1
# Difficulty: Easy
# ============================================================

def twoSum(nums, target):
    seen = {}

    for i, num in enumerate(nums):
        complement = target - num

        if complement in seen:
            return [seen[complement], i]

        seen[num] = i

    return []


# Example:
# nums = [2, 7, 11, 15], target = 9
# Output: [0, 1]


# ============================================================
# 2. Valid Palindrome
# LeetCode 125
# Difficulty: Easy
# ============================================================

def isPalindrome(s):
    cleaned = ""

    for char in s:
        if char.isalnum():
            cleaned += char.lower()

    return cleaned == cleaned[::-1]


# Example:
# s = "A man, a plan, a canal: Panama"
# Output: True


# ============================================================
# 3. Contains Duplicate
# LeetCode 217
# Difficulty: Easy
# ============================================================

def containsDuplicate(nums):
    seen = set()

    for num in nums:
        if num in seen:
            return True

        seen.add(num)

    return False


# Example:
# nums = [1, 2, 3, 1]
# Output: True


# ============================================================
# 4. Best Time to Buy and Sell Stock
# LeetCode 121
# Difficulty: Easy
# ============================================================

def maxProfit(prices):
    minimum = prices[0]
    profit = 0

    for price in prices:
        minimum = min(minimum, price)

        current_profit = price - minimum
        profit = max(profit, current_profit)

    return profit


# Example:
# prices = [7, 1, 5, 3, 6, 4]
# Output: 5


# ============================================================
# 5. Valid Anagram
# LeetCode 242
# Difficulty: Easy
# ============================================================

def isAnagram(s, t):
    if len(s) != len(t):
        return False

    count = {}

    for char in s:
        count[char] = count.get(char, 0) + 1

    for char in t:
        if char not in count:
            return False

        count[char] -= 1

        if count[char] < 0:
            return False

    return True


# Example:
# s = "anagram"
# t = "nagaram"
# Output: True


# ============================================================
# 6. Maximum Subarray
# LeetCode 53
# Difficulty: Medium
# ============================================================

def maxSubArray(nums):
    current = nums[0]
    maximum = nums[0]

    for num in nums[1:]:
        current = max(num, current + num)
        maximum = max(maximum, current)

    return maximum


# Example:
# nums = [-2,1,-3,4,-1,2,1,-5,4]
# Output: 6


# ============================================================
# 7. Move Zeroes
# LeetCode 283
# Difficulty: Easy
# ============================================================

def moveZeroes(nums):
    position = 0

    for num in nums:
        if num != 0:
            nums[position] = num
            position += 1

    while position < len(nums):
        nums[position] = 0
        position += 1

    return nums


# Example:
# nums = [0,1,0,3,12]
# Output: [1,3,12,0,0]


# ============================================================
# 8. Valid Parentheses
# LeetCode 20
# Difficulty: Easy
# ============================================================

def isValid(s):
    stack = []

    pairs = {
        ")": "(",
        "}": "{",
        "]": "["
    }

    for char in s:

        if char in "({[":
            stack.append(char)

        else:
            if not stack:
                return False

            if stack.pop() != pairs[char]:
                return False

    return len(stack) == 0


# Example:
# s = "()[]{}"
# Output: True


# ============================================================
# 9. Merge Sorted Array
# LeetCode 88
# Difficulty: Easy
# ============================================================

def merge(nums1, m, nums2, n):
    i = m - 1
    j = n - 1
    k = m + n - 1

    while j >= 0:

        if i >= 0 and nums1[i] > nums2[j]:
            nums1[k] = nums1[i]
            i -= 1

        else:
            nums1[k] = nums2[j]
            j -= 1

        k -= 1

    return nums1


# Example:
# nums1 = [1,2,3,0,0,0]
# m = 3
# nums2 = [2,5,6]
# n = 3
# Output: [1,2,2,3,5,6]


# ============================================================
# 10. Longest Substring Without Repeating Characters
# LeetCode 3
# Difficulty: Medium
# ============================================================

def lengthOfLongestSubstring(s):
    seen = set()

    left = 0
    maximum = 0

    for right in range(len(s)):

        while s[right] in seen:
            seen.remove(s[left])
            left += 1

        seen.add(s[right])

        current_length = right - left + 1
        maximum = max(maximum, current_length)

    return maximum


# Example:
# s = "abcabcbb"
# Output: 3


