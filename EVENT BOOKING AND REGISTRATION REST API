# ============================================================
# EVENT BOOKING AND REGISTRATION REST API
# Simple Flask project using Python basics
# ============================================================

from flask import Flask, request, jsonify
from datetime import datetime


app = Flask(__name__)


# Available event categories and statuses
categories = (
    "Technology",
    "Career",
    "Education",
    "Arts",
    "Sports"
)

statuses = (
    "Scheduled",
    "Cancelled",
    "Completed"
)


# Sample events
events = [
    {
        "id": 101,
        "title": "Python Workshop",
        "category": "Technology",
        "city": "Chennai",
        "date": "2026-11-10",
        "capacity": 30,
        "booked": 0,
        "status": "Scheduled"
    },
    {
        "id": 102,
        "title": "Career Guidance",
        "category": "Career",
        "city": "Bangalore",
        "date": "2026-11-20",
        "capacity": 50,
        "booked": 0,
        "status": "Scheduled"
    },
    {
        "id": 103,
        "title": "Photography Workshop",
        "category": "Arts",
        "city": "Hyderabad",
        "date": "2026-12-05",
        "capacity": 20,
        "booked": 0,
        "status": "Scheduled"
    }
]


# Attendee registration records
registrations = []


# ============================================================
# FIND EVENT
# ============================================================

def find_event(event_id):

    # Search for an event using its ID
    for event in events:

        if event["id"] == event_id:
            return event

    return None


# ============================================================
# FIND REGISTRATION
# ============================================================

def find_registration(registration_id):

    # Search the registration list
    for registration in registrations:

        if registration["id"] == registration_id:
            return registration

    return None


# ============================================================
# VALIDATE DATE
# ============================================================

def valid_date(date_text):

    if not isinstance(date_text, str):
        return False

    try:
        datetime.strptime(date_text, "%Y-%m-%d")
        return True

    except ValueError:
        return False


# ============================================================
# GET ALL EVENTS
# ============================================================

@app.route("/api/events", methods=["GET"])
def get_events():

    return jsonify({
        "total_events": len(events),
        "events": events
    })


# ============================================================
# GET ONE EVENT
# ============================================================

@app.route("/api/events/<int:event_id>", methods=["GET"])
def get_event(event_id):

    event = find_event(event_id)

    if event is None:

        return jsonify({
            "message": "Event not found"
        }), 404

    return jsonify(event)


# ============================================================
# CREATE EVENT
# ============================================================

@app.route("/api/events", methods=["POST"])
def add_event():

    data = request.get_json(silent=True)

    if not isinstance(data, dict):

        return jsonify({
            "message": "A valid JSON object is required"
        }), 400

    # Check required fields
    required_fields = (
        "id",
        "title",
        "category",
        "city",
        "date",
        "capacity"
    )

    for field in required_fields:

        if field not in data:

            return jsonify({
                "message": field + " is required"
            }), 400

    # Validate event ID
    if type(data["id"]) is not int or data["id"] <= 0:

        return jsonify({
            "message": "ID must be a positive integer"
        }), 400

    if find_event(data["id"]) is not None:

        return jsonify({
            "message": "Event ID already exists"
        }), 409

    # Validate title
    if not isinstance(data["title"], str) or not data["title"].strip():

        return jsonify({
            "message": "Event title cannot be empty"
        }), 400

    # Validate category
    if data["category"] not in categories:

        return jsonify({
            "message": "Invalid category",
            "available_categories": categories
        }), 400

    # Validate city
    if not isinstance(data["city"], str) or not data["city"].strip():

        return jsonify({
            "message": "City cannot be empty"
        }), 400

    # Validate date
    if not valid_date(data["date"]):

        return jsonify({
            "message": "Date must use YYYY-MM-DD format"
        }), 400

    # Validate capacity
    if type(data["capacity"]) is not int or data["capacity"] <= 0:

        return jsonify({
            "message": "Capacity must be a positive integer"
        }), 400

    # Create the event
    event = {
        "id": data["id"],
        "title": data["title"].strip(),
        "category": data["category"],
        "city": data["city"].strip().title(),
        "date": data["date"],
        "capacity": data["capacity"],
        "booked": 0,
        "status": "Scheduled"
    }

    events.append(event)

    return jsonify({
        "message": "Event created successfully",
        "event": event
    }), 201


# ============================================================
# UPDATE EVENT DETAILS
# ============================================================

@app.route("/api/events/<int:event_id>", methods=["PUT"])
def update_event(event_id):

    event = find_event(event_id)

    if event is None:

        return jsonify({
            "message": "Event not found"
        }), 404

    data = request.get_json(silent=True)

    if not isinstance(data, dict) or not data:

        return jsonify({
            "message": "A non-empty JSON object is required"
        }), 400

    # Only these fields can be updated here
    allowed_fields = (
        "title",
        "category",
        "city",
        "date",
        "capacity"
    )

    for field in data:

        if field not in allowed_fields:

            return jsonify({
                "message": "Invalid field: " + field
            }), 400

    # Validate title
    if "title" in data:

        if not isinstance(data["title"], str) or not data["title"].strip():

            return jsonify({
                "message": "Title cannot be empty"
            }), 400

    # Validate category
    if "category" in data:

        if data["category"] not in categories:

            return jsonify({
                "message": "Invalid category",
                "available_categories": categories
            }), 400

    # Validate city
    if "city" in data:

        if not isinstance(data["city"], str) or not data["city"].strip():

            return jsonify({
                "message": "City cannot be empty"
            }), 400

    # Validate date
    if "date" in data:

        if not valid_date(data["date"]):

            return jsonify({
                "message": "Invalid date. Use YYYY-MM-DD"
            }), 400

    # Capacity cannot be less than booked seats
    if "capacity" in data:

        if type(data["capacity"]) is not int or data["capacity"] <= 0:

            return jsonify({
                "message": "Capacity must be a positive integer"
            }), 400

        if data["capacity"] < event["booked"]:

            return jsonify({
                "message": "Capacity cannot be less than booked seats"
            }), 400

    # Update only the fields supplied by the client
    if "title" in data:
        event["title"] = data["title"].strip()

    if "category" in data:
        event["category"] = data["category"]

    if "city" in data:
        event["city"] = data["city"].strip().title()

    if "date" in data:
        event["date"] = data["date"]

    if "capacity" in data:
        event["capacity"] = data["capacity"]

    return jsonify({
        "message": "Event updated successfully",
        "event": event
    })


# ============================================================
# UPDATE EVENT STATUS
# ============================================================

@app.route("/api/events/<int:event_id>/status", methods=["PUT"])
def update_status(event_id):

    event = find_event(event_id)

    if event is None:

        return jsonify({
            "message": "Event not found"
        }), 404

    data = request.get_json(silent=True)

    if not isinstance(data, dict) or "status" not in data:

        return jsonify({
            "message": "Status is required"
        }), 400

    new_status = data["status"]

    if new_status not in statuses:

        return jsonify({
            "message": "Invalid status",
            "available_statuses": statuses
        }), 400

    event["status"] = new_status

    return jsonify({
        "message": "Event status updated successfully",
        "event": event
    })


# ============================================================
# DELETE EVENT
# ============================================================

@app.route("/api/events/<int:event_id>", methods=["DELETE"])
def delete_event(event_id):

    event = find_event(event_id)

    if event is None:

        return jsonify({
            "message": "Event not found"
        }), 404

    # Do not remove events that still have bookings
    if event["booked"] > 0:

        return jsonify({
            "message": "Cancel registrations before deleting this event"
        }), 409

    events.remove(event)

    return jsonify({
        "message": "Event deleted successfully",
        "event": event
    })


# ============================================================
# REGISTER FOR AN EVENT
# ============================================================

@app.route("/api/events/<int:event_id>/register", methods=["POST"])
def register_attendee(event_id):

    event = find_event(event_id)

    if event is None:

        return jsonify({
            "message": "Event not found"
        }), 404

    if event["status"] != "Scheduled":

        return jsonify({
            "message": "Registration is not available for this event"
        }), 400

    data = request.get_json(silent=True)

    if not isinstance(data, dict):

        return jsonify({
            "message": "A valid JSON object is required"
        }), 400

    if "attendee" not in data:

        return jsonify({
            "message": "Attendee name is required"
        }), 400

    attendee = data["attendee"]

    if not isinstance(attendee, str) or not attendee.strip():

        return jsonify({
            "message": "Attendee name cannot be empty"
        }), 400

    # Seats defaults to 1 if the client does not provide it
    seats = data.get("seats", 1)

    if type(seats) is not int or seats <= 0:

        return jsonify({
            "message": "Seats must be a positive integer"
        }), 400

    available_seats = event["capacity"] - event["booked"]

    if seats > available_seats:

        return jsonify({
            "message": "Not enough seats available",
            "available_seats": available_seats
        }), 400

    # Generate the next registration ID
    registration_id = 101

    for registration in registrations:

        if registration["id"] >= registration_id:

            registration_id = registration["id"] + 1

    registration = {
        "id": registration_id,
        "event_id": event_id,
        "attendee": attendee.strip().title(),
        "seats": seats
    }

    registrations.append(registration)

    # Update booked seats
    event["booked"] = event["booked"] + seats

    return jsonify({
        "message": "Registration successful",
        "registration": registration,
        "available_seats": event["capacity"] - event["booked"]
    }), 201


