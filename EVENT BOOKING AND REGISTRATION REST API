# ============================================================
# CANCEL REGISTRATION
# ============================================================

@app.route("/api/registrations/<int:registration_id>", methods=["DELETE"])
def cancel_registration(registration_id):

    registration = find_registration(registration_id)

    if registration is None:

        return jsonify({
            "message": "Registration not found"
        }), 404

    event = find_event(registration["event_id"])

    if event is None:

        return jsonify({
            "message": "The linked event could not be found"
        }), 404

    # Return the seats to the event
    event["booked"] = event["booked"] - registration["seats"]

    registrations.remove(registration)

    return jsonify({
        "message": "Registration cancelled successfully",
        "registration": registration,
        "available_seats": event["capacity"] - event["booked"]
    })


# ============================================================
# GET AVAILABLE SEATS
# ============================================================

@app.route("/api/events/<int:event_id>/availability", methods=["GET"])
def event_availability(event_id):

    event = find_event(event_id)

    if event is None:

        return jsonify({
            "message": "Event not found"
        }), 404

    available_seats = event["capacity"] - event["booked"]

    return jsonify({
        "event_id": event["id"],
        "title": event["title"],
        "capacity": event["capacity"],
        "booked_seats": event["booked"],
        "available_seats": available_seats,
        "status": event["status"]
    })


# ============================================================
# SEARCH EVENTS BY CATEGORY
# ============================================================

@app.route("/api/events/category/<category>", methods=["GET"])
def events_by_category(category):

    result = []

    for event in events:

        if event["category"].lower() == category.lower():

            result.append(event)

    return jsonify({
        "category": category,
        "total_events": len(result),
        "events": result
    })


# ============================================================
# EVENT SUMMARY
# ============================================================

@app.route("/api/events/summary", methods=["GET"])
def event_summary():

    status_summary = {}

    for status in statuses:
        status_summary[status] = 0

    total_booked = 0
    total_available = 0

    for event in events:

        status = event["status"]

        status_summary[status] = status_summary[status] + 1

        total_booked = total_booked + event["booked"]

        total_available = (
            total_available
            + event["capacity"]
            - event["booked"]
        )

    return jsonify({
        "total_events": len(events),
        "status_summary": status_summary,
        "total_booked_seats": total_booked,
        "total_available_seats": total_available
    })


