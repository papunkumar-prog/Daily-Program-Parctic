# FUNCTION 1: CALCULATE BILL

# ============================================================

def calculate_bill(units):
"""
Execution Flow:
1. Receive electricity units.
2. Check the number of units.
3. Apply different rates.
4. Return the final bill amount.
"""

```
if units <= 100:
    bill = units * 3

elif units <= 200:
    bill = (100 * 3) + ((units - 100) * 5)

elif units <= 500:
    bill = (100 * 3) + (100 * 5) + ((units - 200) * 7)

else:
    bill = (100 * 3) + (100 * 5) + (300 * 7) + ((units - 500) * 10)

return bill
```

