# FUNCTION 9: AVERAGE USAGE

# ============================================================

def average_usage():
"""
Execution Flow:
1. Collect all customer units.
2. Create NumPy array.
3. Calculate average using NumPy.
"""

```
if len(customers) == 0:
    print("No customer data available.")
    return

units = []

for customer in customers:
    units.append(customer["units"])

units_array = np.array(units)

average = np.mean(units_array)

print("\n========== AVERAGE USAGE ==========")
print("Average electricity usage:", round(average, 2), "units")
```

