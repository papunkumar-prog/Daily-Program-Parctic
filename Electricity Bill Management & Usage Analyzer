# FUNCTION 4: ADD CUSTOMER

# ============================================================

def add_customer():
"""
Execution Flow:
1. Ask for customer ID.
2. Check whether ID already exists.
3. Ask for name, connection type and units.
4. Validate the input.
5. Store data inside dictionary.
6. Add dictionary to customer list.
"""

```
print("\n========== ADD CUSTOMER ==========")

try:
    customer_id = int(input("Enter customer ID: "))

    # Check duplicate ID
    for customer in customers:

        if customer["id"] == customer_id:
            print("Customer ID already exists.")
            return

    name = input("Enter customer name: ").strip().title()

    if name == "":
        print("Name cannot be empty.")
        return

    print("\nConnection Types:")

    for connection in connection_types:
        print("-", connection)

    connection = input("Enter connection type: ").strip().title()

    if connection not in connection_types:
        print("Invalid connection type.")
        return

    units = int(input("Enter electricity units: "))

    if units < 0:
        print("Units cannot be negative.")
        return

    new_customer = {
        "id": customer_id,
        "name": name,
        "connection": connection,
        "units": units
    }

    customers.append(new_customer)

    print("\nCustomer added successfully.")

except ValueError:
    print("Please enter valid numeric values.")
```

