# FUNCTION 6: UPDATE UNITS

# ============================================================

def update_units():
"""
Execution Flow:
1. Ask for customer ID.
2. Search customer.
3. Ask for new units.
4. Update the dictionary.
"""

```
try:

    customer_id = int(input("\nEnter customer ID: "))

    for customer in customers:

        if customer["id"] == customer_id:

            new_units = int(input("Enter new units: "))

            if new_units < 0:
                print("Units cannot be negative.")
                return

            customer["units"] = new_units

            print("Units updated successfully.")
            return

    print("Customer ID not found.")

except ValueError:
    print("Please enter a valid number.")
```

