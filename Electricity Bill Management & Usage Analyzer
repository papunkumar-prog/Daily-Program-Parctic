def main():
"""
Execution Flow:
1. Display menu.
2. Ask the user for choice.
3. Call the required function.
4. Repeat using while loop.
5. Exit when user selects 11.
"""

```
while True:

    print("\n")
    print("==========================================")
    print(" ELECTRICITY BILL MANAGEMENT SYSTEM")
    print("==========================================")
    print("1. Add Customer")
    print("2. View All Customers")
