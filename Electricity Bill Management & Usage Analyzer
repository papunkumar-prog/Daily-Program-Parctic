# FUNCTION 11: DELETE CUSTOMER

# ============================================================

def delete_customer():
"""
Execution Flow:
1. Ask for customer ID.
2. Search customer.
3. Ask for confirmation.
4. Delete customer from list.
"""

```
try:

    customer_id = int(input("\nEnter customer ID to delete: "))

    for customer in customers:

        if customer["id"] == customer_id:

            confirm = input(
                f"Delete {customer['name']}? (y/n): "
            ).strip().lower()

            if confirm == "y":

                customers.remove(customer)

                print("Customer deleted successfully.")

            else:
                print("Delete operation cancelled.")

            return

    print("Customer ID not found.")

except ValueError:
    print("Please enter a valid customer ID.")
```

