    print("10. Delete Customer")
    print("11. Exit")
    print("==========================================")

    choice = input("Enter your choice: ").strip()

    if choice == "1":
        add_customer()

    elif choice == "2":
        view_customers()

    elif choice == "3":
        search_customer()

    elif choice == "4":
        update_units()

    elif choice == "5":
        highest_usage()

    elif choice == "6":
        lowest_usage()

    elif choice == "7":
        average_usage()

    elif choice == "8":
        total_revenue()

    elif choice == "9":

        try:
            units = int(input("Enter electricity units: "))

            if units < 0:
                print("Units cannot be negative.")

            else:
                bill = calculate_bill(units)
                category = usage_category(units)

                print("\n========== BILL DETAILS ==========")
                print("Units    :", units)
                print("Category :", category)
                print("Bill     : ₹", bill)

