# FUNCTION 2: GET USAGE CATEGORY

# ============================================================

def usage_category(units):
"""
Execution Flow:
1. Receive units.
2. Compare units with limits.
3. Return the usage category.
"""

```
if units <= 100:
    return "Low Usage"

elif units <= 300:
    return "Medium Usage"

elif units <= 500:
    return "High Usage"

else:
    return "Very High Usage"
```

