# FUNCTION 7: HIGHEST USAGE

# ============================================================

def highest_usage():
"""
Execution Flow:
1. Get all units.
2. Convert them into NumPy array.
3. Find maximum units.
4. Find the customer having maximum usage.
"""

```
if len(customers) == 0:
    print("No customer data available.")
    return

units = []

for customer in customers:
    units.append(customer["units"])

units_array = np.array(units)

highest = np.max(units_array)

print("\n========== HIGHEST USAGE ==========")

for customer in customers:

    if customer["units"] == highest:
        print("Customer :", customer["name"])
        print("Units    :", highest)
        print("Bill     : ₹", calculate_bill(highest))
```

