# FUNCTION 5: SEARCH CUSTOMER

# ============================================================

def search_customer():
"""
Execution Flow:
1. Ask for customer name.
2. Search the list.
3. Compare names.
4. Display matching customer.
"""

```
search_name = input("\nEnter customer name: ").strip().lower()

found = False

for customer in customers:

    if customer["name"].lower() == search_name:

        bill = calculate_bill(customer["units"])

        print("\n========== CUSTOMER FOUND ==========")
        print("ID         :", customer["id"])
        print("Name       :", customer["name"])
        print("Connection :", customer["connection"])
        print("Units      :", customer["units"])
        print("Bill       : ₹", bill)

        found = True
        break

if not found:
    print("Customer not found.")
```

