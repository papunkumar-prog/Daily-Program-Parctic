# 6. DELETE AN EMPLOYEE
# Flow: Read ID -> Find employee -> Check payroll history
#       -> Delete employee -> Return response
# --------------------------------------------------
@app.route("/api/employees/<int:employee_id>", methods=["DELETE"])
def delete_employee(employee_id):

    employee = find_employee(employee_id)

    if employee is None:
        return jsonify({
            "error": "Employee not found"
        }), 404

    # Preserve employee records linked to payroll history
    for payroll in payrolls:

        if payroll["employee_id"] == employee_id:
            return jsonify({
                "error": "Cannot delete employee because payroll records exist"
            }), 409

    employees.remove(employee)

    return jsonify({
        "message": "Employee deleted successfully"
    }), 200


# --------------------------------------------------
# 7. GENERATE MONTHLY PAYROLL
# Flow: Read JSON -> Validate month and year
#       -> Find employee -> Check duplicate payroll
#       -> Calculate salary -> Save payroll
# --------------------------------------------------
@app.route("/api/payrolls", methods=["POST"])
def generate_payroll():

    data = request.get_json(silent=True)

    if not isinstance(data, dict):
        return jsonify({
            "error": "A valid JSON object is required"
        }), 400

    required_fields = ["employee_id", "month", "year"]

    for field in required_fields:

        if field not in data:
            return jsonify({
                "error": f"{field} is required"
            }), 400

    employee_id = data["employee_id"]
    month = data["month"]
    year = data["year"]

    # Validate employee ID
    if isinstance(employee_id, bool) or not isinstance(employee_id, int):
        return jsonify({
            "error": "Employee ID must be an integer"
        }), 400

    if employee_id <= 0:
        return jsonify({
            "error": "Employee ID must be greater than zero"
        }), 400

    # Validate month and year
    if isinstance(month, bool) or not isinstance(month, int):
        return jsonify({
            "error": "Month must be an integer"
        }), 400

    if isinstance(year, bool) or not isinstance(year, int):
        return jsonify({
            "error": "Year must be an integer"
        }), 400

    if month < 1 or month > 12:
        return jsonify({
            "error": "Month must be between 1 and 12"
        }), 400

    if year < 2000 or year > 2100:
        return jsonify({
            "error": "Enter a valid payroll year"
        }), 400

    # Find employee
    employee = find_employee(employee_id)

    if employee is None:
        return jsonify({
            "error": "Employee not found"
        }), 404

    if employee["status"] != "Active":
        return jsonify({
            "error": "Payroll cannot be generated for an inactive employee"
        }), 409

    # Prevent duplicate monthly payroll
    for payroll in payrolls:

        if (
            payroll["employee_id"] == employee_id
            and payroll["month"] == month
            and payroll["year"] == year
        ):
            return jsonify({
                "error": "Payroll already generated for this employee and month"
            }), 409

    # Calculate salary
    salary_details = calculate_salary(employee)

    if salary_details["net_salary"] < 0:
        return jsonify({
            "error": "Total deductions cannot exceed gross salary"
        }), 400

    # Generate payroll ID
    if payrolls:
        new_id = max(payroll["id"] for payroll in payrolls) + 1
    else:
        new_id = 701

    new_payroll = {
        "id": new_id,
        "employee_id": employee["id"],
        "employee_name": employee["name"],
        "department": employee["department"],
        "designation": employee["designation"],
        "month": month,
        "month_name": calendar.month_name[month],
        "year": year,
        **salary_details,
        "processed_on": date.today().isoformat()
    }

    payrolls.append(new_payroll)

    return jsonify({
        "message": "Payroll generated successfully",
        "payroll": new_payroll
    }), 201


# --------------------------------------------------
# 8. GET ALL PAYROLL RECORDS
# Flow: Read filters -> Filter payroll records
#       -> Return matching payrolls
# --------------------------------------------------
@app.route("/api/payrolls", methods=["GET"])
def get_payrolls():

    filtered_payrolls = payrolls

    employee_id = request.args.get("employee_id")

    if employee_id is not None:

        try:
            employee_id = int(employee_id)
        except ValueError:
            return jsonify({
                "error": "Employee ID must be an integer"
            }), 400

        filtered_payrolls = [
            payroll for payroll in filtered_payrolls
            if payroll["employee_id"] == employee_id
        ]

    month = request.args.get("month")

    if month is not None:

        try:
            month = int(month)
        except ValueError:
            return jsonify({
                "error": "Month must be an integer"
            }), 400

        if month < 1 or month > 12:
            return jsonify({
                "error": "Month must be between 1 and 12"
            }), 400

        filtered_payrolls = [
            payroll for payroll in filtered_payrolls
            if payroll["month"] == month
        ]

    year = request.args.get("year")

    if year is not None:

        try:
            year = int(year)
        except ValueError:
            return jsonify({
                "error": "Year must be an integer"
            }), 400

        filtered_payrolls = [
            payroll for payroll in filtered_payrolls
            if payroll["year"] == year
        ]

    return jsonify({
        "total_payrolls": len(filtered_payrolls),
        "payrolls": filtered_payrolls
    }), 200


