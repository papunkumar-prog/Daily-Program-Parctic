# --------------------------------------------------
# 11. PAYROLL SUMMARY
# Flow: Read year filter -> Calculate salary totals
#       -> Count employees -> Return statistics
# --------------------------------------------------
@app.route("/api/payrolls/summary", methods=["GET"])
def payroll_summary():

    filtered_payrolls = payrolls

    year = request.args.get("year")

    if year is not None:

        try:
            year = int(year)
        except ValueError:
            return jsonify({
                "error": "Year must be an integer"
            }), 400

        filtered_payrolls = [
            payroll for payroll in filtered_payrolls
            if payroll["year"] == year
        ]

    total_gross_salary = sum(
        payroll["gross_salary"] for payroll in filtered_payrolls
    )

    total_deductions = sum(
        payroll["total_deductions"] for payroll in filtered_payrolls
    )

    total_net_salary = sum(
        payroll["net_salary"] for payroll in filtered_payrolls
    )

    employee_ids = set(
        payroll["employee_id"] for payroll in filtered_payrolls
    )

    return jsonify({
        "total_payroll_records": len(filtered_payrolls),
        "employees_paid": len(employee_ids),
        "total_gross_salary": round(total_gross_salary, 2),
        "total_deductions": round(total_deductions, 2),
        "total_net_salary": round(total_net_salary, 2)
    }), 200


