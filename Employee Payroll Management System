# --------------------------------------------------
# HELPER FUNCTION: CHECK DUPLICATE EMAIL
# Flow: Search existing employees -> Check email
#       -> Return True if duplicate exists
# --------------------------------------------------
def check_duplicate_email(email, exclude_id=None):

    for employee in employees:

        if (
            employee["email"] == email
            and employee["id"] != exclude_id
        ):
            return True

    return False


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE EMPLOYEE DATA
# Flow: Receive JSON -> Check fields -> Validate values
#       -> Return cleaned employee information
# --------------------------------------------------
def validate_employee(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "name",
        "email",
        "department",
        "designation",
        "basic_salary",
        "hra_percent",
        "other_allowances",
        "pf_percent",
        "tax_percent"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    name = data["name"]
    email = data["email"]
    department = data["department"]
    designation = data["designation"]

    numeric_fields = [
        "basic_salary",
        "hra_percent",
        "other_allowances",
        "pf_percent",
        "tax_percent"
    ]

    # Validate text fields
    if not all(
        isinstance(value, str)
        for value in [name, email, department, designation]
    ):
        return None, "Employee details must be text"

    name = name.strip()
    email = email.strip().lower()
    department = department.strip()
    designation = designation.strip()

    if not all([name, email, department, designation]):
        return None, "Employee details cannot be empty"

    if "@" not in email or "." not in email.split("@")[-1]:
        return None, "Enter a valid email address"

    # Validate salary and percentage fields
    for field in numeric_fields:

        value = data[field]

        if isinstance(value, bool) or not isinstance(value, (int, float)):
            return None, f"{field} must be a number"

        if not math.isfinite(value):
            return None, f"{field} must be a finite number"

        if value < 0:
            return None, f"{field} cannot be negative"

    if data["basic_salary"] <= 0:
        return None, "Basic salary must be greater than zero"

    # Validate percentage limits
    for field in ["hra_percent", "pf_percent", "tax_percent"]:

        if data[field] > 100:
            return None, f"{field} cannot exceed 100"

    # Employee status
    status = data.get("status", "Active")

    if not isinstance(status, str):
        return None, "Employee status must be text"

    status = status.strip().title()

    if status not in EMPLOYEE_STATUSES:
        return None, "Status must be Active or Inactive"

    employee_data = {
        "name": name,
        "email": email,
        "department": department,
        "designation": designation,
        "basic_salary": data["basic_salary"],
        "hra_percent": data["hra_percent"],
        "other_allowances": data["other_allowances"],
        "pf_percent": data["pf_percent"],
        "tax_percent": data["tax_percent"],
        "status": status
    }

    return employee_data, None


# --------------------------------------------------
# HELPER FUNCTION: CALCULATE SALARY
# Flow: Read employee salary -> Calculate HRA
#       -> Calculate gross salary -> Calculate deductions
#       -> Calculate net salary -> Return salary details
# --------------------------------------------------
def calculate_salary(employee):

    basic_salary = employee["basic_salary"]

    # Calculate House Rent Allowance
    hra = round(
        basic_salary * employee["hra_percent"] / 100, 2
    )

    other_allowances = employee["other_allowances"]

    # Gross salary = Basic + HRA + Other Allowances
    gross_salary = round(
        basic_salary + hra + other_allowances, 2
    )

    # Calculate Provident Fund deduction
    pf_deduction = round(
        basic_salary * employee["pf_percent"] / 100, 2
    )

    # Calculate tax deduction on gross salary
    tax_deduction = round(
        gross_salary * employee["tax_percent"] / 100, 2
    )

    total_deductions = round(
        pf_deduction + tax_deduction, 2
    )

    net_salary = round(
        gross_salary - total_deductions, 2
    )

    return {
        "basic_salary": basic_salary,
        "hra": hra,
        "other_allowances": other_allowances,
        "gross_salary": gross_salary,
        "pf_deduction": pf_deduction,
        "tax_deduction": tax_deduction,
        "total_deductions": total_deductions,
        "net_salary": net_salary
    }


