# --------------------------------------------------
# 4. ADD A NEW EMPLOYEE
# Flow: Read JSON -> Validate -> Check duplicate email
#       -> Generate ID -> Save employee -> Respond
# --------------------------------------------------
@app.route("/api/employees", methods=["POST"])
def add_employee():

    data = request.get_json(silent=True)

    employee_data, error = validate_employee(data)

    if error:
        return jsonify({"error": error}), 400

    if check_duplicate_email(employee_data["email"]):
        return jsonify({
            "error": "Email already registered"
        }), 409

    # Generate next available employee ID
    if employees:
        new_id = max(employee["id"] for employee in employees) + 1
    else:
        new_id = 1001

    new_employee = {
        "id": new_id,
        **employee_data
    }

    employees.append(new_employee)

    return jsonify({
        "message": "Employee added successfully",
        "employee": new_employee
    }), 201


# --------------------------------------------------
# 5. UPDATE EMPLOYEE DETAILS
# Flow: Read ID -> Validate -> Find employee
#       -> Check email -> Update details -> Respond
# --------------------------------------------------
@app.route("/api/employees/<int:employee_id>", methods=["PUT"])
def update_employee(employee_id):

    data = request.get_json(silent=True)

    employee_data, error = validate_employee(data)

    if error:
        return jsonify({"error": error}), 400

    employee = find_employee(employee_id)

    if employee is None:
        return jsonify({
            "error": "Employee not found"
        }), 404

    if check_duplicate_email(
        employee_data["email"],
        exclude_id=employee_id
    ):
        return jsonify({
            "error": "Email already belongs to another employee"
        }), 409

    employee.update(employee_data)

    return jsonify({
        "message": "Employee updated successfully",
        "employee": employee
    }), 200


