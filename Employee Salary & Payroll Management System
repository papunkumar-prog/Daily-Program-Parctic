# ============================================================

# EMPLOYEE SALARY & PAYROLL MANAGEMENT SYSTEM

# Simple CLI project using Python basics and NumPy

# ============================================================

import numpy as np

# Departments in the company

departments = (
"IT",
"HR",
"Finance",
"Sales",
"Support"
)

# Employee details

employees = [
{
"id": 101,
"name": "Papun",
"department": "IT",
"salary": 35000,
"attendance": 26
},
{
"id": 102,
"name": "Amit",
"department": "HR",
"salary": 30000,
"attendance": 24
},
{
"id": 103,
"name": "Rahul",
"department": "Sales",
"salary": 28000,
"attendance": 22
}
]

# ============================================================

# FIND EMPLOYEE

# ============================================================

def find_employee(employee_id):

```
for employee in employees:

    if employee["id"] == employee_id:
        return employee

return None
```

# ============================================================

# CALCULATE NET SALARY

# ============================================================

def calculate_salary(basic_salary, attendance):

```
# Less attendance means some deduction
if attendance >= 26:
    deduction = 0

elif attendance >= 24:
    deduction = basic_salary * 0.02

elif attendance >= 20:
    deduction = basic_salary * 0.05

else:
    deduction = basic_salary * 0.10

net_salary = basic_salary - deduction

return net_salary
```

# ============================================================

# ADD EMPLOYEE

# ============================================================

def add_employee():

```
print("\n----------- ADD EMPLOYEE -----------")

try:

    employee_id = int(input("Enter employee ID: "))

    # Check duplicate employee ID
    for employee in employees:

        if employee["id"] == employee_id:
            print("Employee ID already exists.")
            return

    name = input("Enter employee name: ").strip().title()

    if name == "":
        print("Employee name is required.")
        return

    print("\nDepartments:")

    for department in departments:
        print("-", department)

    department = input(
        "Enter department: "
    ).strip().upper()

    if department not in departments:
        print("Invalid department.")
        return

    salary = float(input("Enter basic salary: "))

    if salary <= 0:
        print("Salary must be greater than zero.")
        return

    attendance = int(
        input("Enter attendance days: ")
    )

    if attendance < 0 or attendance > 26:
        print("Attendance should be between 0 and 26.")
        return

    employee = {
        "id": employee_id,
        "name": name,
        "department": department,
        "salary": salary,
        "attendance": attendance
    }

    employees.append(employee)

    print("Employee added successfully.")


except ValueError:

    print("Please enter valid values.")
```

# ============================================================

# SHOW ALL EMPLOYEES

# ============================================================

def show_employees():

```
print("\n----------- ALL EMPLOYEES -----------")

if len(employees) == 0:
    print("No employees found.")
    return

for employee in employees:

    net_salary = calculate_salary(
        employee["salary"],
        employee["attendance"]
    )

    print("-------------------------------------")
    print("ID         :", employee["id"])
    print("Name       :", employee["name"])
    print("Department :", employee["department"])
    print("Basic Salary:", employee["salary"])
    print("Attendance :", employee["attendance"])
    print("Net Salary : ₹", round(net_salary, 2))
```

# ============================================================

# SEARCH EMPLOYEE

# ============================================================

def search_employee():

```
print("\n----------- SEARCH EMPLOYEE -----------")

try:

    employee_id = int(input("Enter employee ID: "))

    employee = find_employee(employee_id)

    if employee is None:
        print("Employee not found.")
        return

    net_salary = calculate_salary(
        employee["salary"],
        employee["attendance"]
    )

    print("\nEmployee found")
    print("ID         :", employee["id"])
    print("Name       :", employee["name"])
    print("Department :", employee["department"])
    print("Basic Salary:", employee["salary"])
    print("Attendance :", employee["attendance"])
    print("Net Salary : ₹", round(net_salary, 2))


except ValueError:

    print("Enter a valid employee ID.")
```

# ============================================================

# UPDATE ATTENDANCE

# ============================================================

def update_attendance():

```
print("\n----------- UPDATE ATTENDANCE -----------")

try:

    employee_id = int(input("Enter employee ID: "))

    employee = find_employee(employee_id)

    if employee is None:
        print("Employee not found.")
        return

    print("Employee:", employee["name"])
    print("Current attendance:", employee["attendance"])

    attendance = int(
        input("Enter new attendance: ")
    )

    if attendance < 0 or attendance > 26:
        print("Attendance should be between 0 and 26.")
        return

    employee["attendance"] = attendance

    print("Attendance updated successfully.")


except ValueError:

