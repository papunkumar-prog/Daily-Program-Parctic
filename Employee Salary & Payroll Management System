# HIGHEST SALARY

# ============================================================

def highest_salary():

```
print("\n----------- HIGHEST SALARY -----------")

if len(employees) == 0:
    print("No employees found.")
    return

salaries = []

for employee in employees:

    salaries.append(employee["salary"])

salary_array = np.array(salaries)

highest = np.max(salary_array)

for employee in employees:

    if employee["salary"] == highest:

        print("Employee :", employee["name"])
        print("Department:", employee["department"])
        print("Salary   : ₹", highest)
```

