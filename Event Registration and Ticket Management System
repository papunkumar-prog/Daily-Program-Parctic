def find_registration(registration_id):

    for registration in registrations:

        if registration["id"] == registration_id:
            return registration

    return None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE EVENT DATA
# Flow: Read JSON -> Validate details -> Check date
#       -> Return cleaned event information
# --------------------------------------------------
def validate_event(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "event_name",
        "venue",
        "event_date",
        "ticket_price",
        "total_seats"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    event_name = data["event_name"]
    venue = data["venue"]
    event_date = data["event_date"]
    ticket_price = data["ticket_price"]
    total_seats = data["total_seats"]

    # Validate text fields
    if not isinstance(event_name, str):
        return None, "Event name must be text"

    if not isinstance(venue, str):
        return None, "Venue must be text"

    event_name = event_name.strip()
    venue = venue.strip()

    if not event_name or not venue:
        return None, "Event name and venue cannot be empty"

    # Validate event date
    if not isinstance(event_date, str):
        return None, "Event date must be text"

    try:
        parsed_date = datetime.strptime(
            event_date, "%Y-%m-%d"
        ).date()

        if parsed_date.isoformat() != event_date:
            return None, "Date must use YYYY-MM-DD format"

    except ValueError:
        return None, "Invalid event date"

    if parsed_date < date.today():
        return None, "Event date cannot be in the past"

    # Validate ticket price
    if (
        isinstance(ticket_price, bool)
        or not isinstance(ticket_price, (int, float))
    ):
        return None, "Ticket price must be a number"

    if not math.isfinite(ticket_price) or ticket_price < 0:
        return None, "Ticket price must be non-negative and finite"

    # Validate total seats
    if isinstance(total_seats, bool) or not isinstance(total_seats, int):
        return None, "Total seats must be a whole number"

    if total_seats <= 0:
        return None, "Total seats must be greater than zero"

    event_data = {
        "event_name": event_name,
        "venue": venue,
        "event_date": event_date,
        "ticket_price": ticket_price,
        "total_seats": total_seats
    }

    return event_data, None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE REGISTRATION DATA
# Flow: Read JSON -> Validate participant details
#       -> Check event -> Return registration data
# --------------------------------------------------
def validate_registration(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "event_id",
        "participant_name",
        "email",
        "tickets"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    event_id = data["event_id"]
    participant_name = data["participant_name"]
    email = data["email"]
    tickets = data["tickets"]

    # Validate event ID
    if isinstance(event_id, bool) or not isinstance(event_id, int):
        return None, "Event ID must be an integer"

    if event_id <= 0:
        return None, "Event ID must be greater than zero"

    # Validate participant name
    if not isinstance(participant_name, str):
        return None, "Participant name must be text"

    participant_name = participant_name.strip()

    if not participant_name:
        return None, "Participant name cannot be empty"

    # Validate email
    if not isinstance(email, str):
        return None, "Email must be text"

    email = email.strip().lower()

    if "@" not in email or "." not in email.split("@")[-1]:
        return None, "Please enter a valid email address"

    # Validate ticket quantity
    if isinstance(tickets, bool) or not isinstance(tickets, int):
        return None, "Tickets must be a whole number"

    if tickets <= 0:
        return None, "Tickets must be greater than zero"

    # Check whether event exists
    event = find_event(event_id)

    if event is None:
        return None, "Event not found"

    registration_data = {
        "event_id": event_id,
        "participant_name": participant_name,
        "email": email,
        "tickets": tickets
    }

    return registration_data, None


