# --------------------------------------------------
# 4. CREATE A NEW EVENT
# Flow: Read JSON -> Validate -> Generate ID
#       -> Save event -> Return response
# --------------------------------------------------
@app.route("/api/events", methods=["POST"])
def create_event():

    data = request.get_json(silent=True)

    event_data, error = validate_event(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    # Generate next available event ID
    if events:
        new_id = max(event["id"] for event in events) + 1
    else:
        new_id = 1201

    new_event = {
        "id": new_id,
        **event_data,
        "available_seats": event_data["total_seats"]
    }

    events.append(new_event)

    return jsonify({
        "message": "Event created successfully",
        "event": new_event
    }), 201


# --------------------------------------------------
# 5. GET ALL REGISTRATIONS
# Flow: Read filters -> Filter registrations
#       -> Return matching records
# --------------------------------------------------
@app.route("/api/registrations", methods=["GET"])
def get_registrations():

    filtered_registrations = registrations

    # Filter by registration status
    status = request.args.get("status")

    if status:

        status = status.strip().title()

        if status not in REGISTRATION_STATUSES:
            return jsonify({
                "error": "Invalid registration status"
            }), 400

        filtered_registrations = [
            record for record in filtered_registrations
            if record["status"] == status
        ]

    # Filter by event ID
    event_id = request.args.get("event_id")

    if event_id is not None:

        try:
            event_id = int(event_id)
        except ValueError:
            return jsonify({
                "error": "Event ID must be an integer"
            }), 400

        filtered_registrations = [
            record for record in filtered_registrations
            if record["event_id"] == event_id
        ]

    return jsonify({
        "total_registrations": len(filtered_registrations),
        "registrations": filtered_registrations
    }), 200


