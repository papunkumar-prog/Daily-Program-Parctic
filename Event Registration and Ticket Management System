# --------------------------------------------------
# 7. REGISTER A PARTICIPANT
# Flow: Read JSON -> Validate -> Check duplicate
#       -> Check seats -> Calculate amount
#       -> Save registration -> Reduce seats
# --------------------------------------------------
@app.route("/api/registrations", methods=["POST"])
def register_participant():

    data = request.get_json(silent=True)

    registration_data, error = validate_registration(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    event = find_event(registration_data["event_id"])

    # Check duplicate registration
    for registration in registrations:

        if (
            registration["event_id"] == registration_data["event_id"]
            and registration["email"] == registration_data["email"]
            and registration["status"] != "Cancelled"
        ):
            return jsonify({
                "error": "This email is already registered for the event"
            }), 409

    tickets = registration_data["tickets"]

    # Check available seats
    if event["available_seats"] < tickets:
        return jsonify({
            "error": "Not enough seats available",
            "available_seats": event["available_seats"]
        }), 409

    # Calculate ticket amount
    total_amount = event["ticket_price"] * tickets

    # Generate registration ID
    if registrations:
        new_id = max(record["id"] for record in registrations) + 1
    else:
        new_id = 801

    new_registration = {
        "id": new_id,
        **registration_data,
        "total_amount": total_amount,
        "status": "Confirmed"
    }

    registrations.append(new_registration)

    # Reduce available seats
    event["available_seats"] -= tickets

    return jsonify({
        "message": "Registration completed successfully",
        "registration": new_registration
    }), 201


# --------------------------------------------------
# 8. CANCEL REGISTRATION
# Flow: Find registration -> Check status -> Cancel
#       -> Restore available seats -> Return response
# --------------------------------------------------
@app.route("/api/registrations/<int:registration_id>/cancel", methods=["POST"])
def cancel_registration(registration_id):

    registration = find_registration(registration_id)

    if registration is None:
        return jsonify({
            "error": "Registration not found"
        }), 404

    if registration["status"] != "Confirmed":
        return jsonify({
            "error": "Only confirmed registrations can be cancelled"
        }), 409

    # Find the event
    event = find_event(registration["event_id"])

    if event is not None:
        event["available_seats"] += registration["tickets"]

    registration["status"] = "Cancelled"

    return jsonify({
        "message": "Registration cancelled successfully",
        "registration": registration
    }), 200


# --------------------------------------------------
# 9. CHECK IN PARTICIPANT
# Flow: Find registration -> Verify status
#       -> Update status -> Return response
# --------------------------------------------------
@app.route("/api/registrations/<int:registration_id>/check-in", methods=["POST"])
def check_in_participant(registration_id):

    registration = find_registration(registration_id)

    if registration is None:
        return jsonify({
            "error": "Registration not found"
        }), 404

    if registration["status"] != "Confirmed":
        return jsonify({
            "error": "Only confirmed participants can check in"
        }), 409

    registration["status"] = "Checked In"

    return jsonify({
        "message": "Participant checked in successfully",
        "registration": registration
    }), 200


# --------------------------------------------------
# 10. EVENT SUMMARY
# Flow: Count events and registrations
#       -> Calculate ticket sales and revenue
#       -> Return statistics
# --------------------------------------------------
@app.route("/api/events/summary", methods=["GET"])
def event_summary():

    confirmed = 0
    checked_in = 0
    cancelled = 0
    tickets_sold = 0
    total_revenue = 0

    for registration in registrations:

        if registration["status"] == "Confirmed":
            confirmed += 1

        elif registration["status"] == "Checked In":
            checked_in += 1

        elif registration["status"] == "Cancelled":
            cancelled += 1

        if registration["status"] != "Cancelled":
            tickets_sold += registration["tickets"]
            total_revenue += registration["total_amount"]

    total_seats = sum(
        event["total_seats"] for event in events
    )

    available_seats = sum(
        event["available_seats"] for event in events
    )

    return jsonify({
        "total_events": len(events),
        "total_registrations": len(registrations),
        "confirmed_registrations": confirmed,
        "checked_in_registrations": checked_in,
        "cancelled_registrations": cancelled,
        "tickets_sold": tickets_sold,
        "total_seats": total_seats,
        "available_seats": available_seats,
        "total_revenue": total_revenue
    }), 200


