# ============================================================

# FUEL STATION MANAGEMENT SYSTEM

# Simple CLI project using Python basics and NumPy

# ============================================================

import numpy as np

# Fuel types available at the station

fuel_types = (
"Petrol",
"Diesel",
"CNG"
)

# Price per litre

fuel_price = {
"Petrol": 105,
"Diesel": 95,
"CNG": 85
}

# Fuel sales records

sales = [
{
"id": 101,
"customer": "Papun",
"vehicle": "Car",
"number": "TN01AB1234",
"fuel": "Petrol",
"litres": 20
},
{
"id": 102,
"customer": "Amit",
"vehicle": "Bike",
"number": "TN02CD5678",
"fuel": "Petrol",
"litres": 5
},
{
"id": 103,
"customer": "Rahul",
"vehicle": "Truck",
"number": "TN03EF9012",
"fuel": "Diesel",
"litres": 60
}
]

# ============================================================

# FIND SALE

# ============================================================

def find_sale(sale_id):

```
for sale in sales:

    if sale["id"] == sale_id:
        return sale

return None
```

# ============================================================

# CALCULATE FUEL COST

# ============================================================

def calculate_cost(fuel, litres):

```
price = fuel_price[fuel]

cost = price * litres

return cost
```

# ============================================================

# SHOW FUEL TYPES

# ============================================================

def show_fuel_types():

```
print("\nFuel Types:")

for fuel in fuel_types:

    print(
        fuel,
        "- ₹",
        fuel_price[fuel],
        "per litre"
    )
```

# ============================================================

# ADD FUEL SALE

# ============================================================

def add_sale():

```
print("\n----------- ADD FUEL SALE -----------")

try:

    sale_id = int(
        input("Enter sale ID: ")
    )

    # Check duplicate ID
    for sale in sales:

        if sale["id"] == sale_id:

            print("Sale ID already exists.")
            return

    customer = input(
        "Enter customer name: "
    ).strip().title()

    if customer == "":

        print("Customer name is required.")
        return

    vehicle = input(
        "Enter vehicle type: "
    ).strip().title()

    if vehicle == "":

        print("Vehicle type is required.")
        return

    number = input(
        "Enter vehicle number: "
    ).strip().upper()

    if number == "":

        print("Vehicle number is required.")
        return

    show_fuel_types()

    fuel = input(
        "Enter fuel type: "
    ).strip().title()

    if fuel not in fuel_types:

        print("Invalid fuel type.")
        return

    litres = float(
        input("Enter litres: ")
    )

    if litres <= 0:

        print("Litres must be greater than zero.")
        return

    sale = {
        "id": sale_id,
        "customer": customer,
        "vehicle": vehicle,
        "number": number,
        "fuel": fuel,
        "litres": litres
    }

    sales.append(sale)

    total = calculate_cost(
        fuel,
        litres
    )

    print("\nSale added successfully.")
    print("Total amount: ₹", total)

except ValueError:

    print("Please enter valid values.")
```

# ============================================================

