# ============================================================

# SEARCH SALE

# ============================================================

def search_sale():

```
print("\n----------- SEARCH SALE -----------")

try:

    sale_id = int(
        input("Enter sale ID: ")
    )

    sale = find_sale(sale_id)

    if sale is None:

