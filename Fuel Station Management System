# ============================================================

# HIGHEST SALE

# ============================================================

def highest_sale():

```
print("\n----------- HIGHEST SALE -----------")

if len(sales) == 0:

    print("No sales found.")
    return

amounts = []

for sale in sales:

    total = calculate_cost(
        sale["fuel"],
        sale["litres"]
    )

    amounts.append(total)

amount_array = np.array(amounts)

highest = np.max(amount_array)

for sale in sales:

    total = calculate_cost(
        sale["fuel"],
        sale["litres"]
    )

    if total == highest:

        print("Customer :", sale["customer"])
        print("Vehicle  :", sale["number"])
        print("Fuel     :", sale["fuel"])
        print("Amount   : ₹", highest)
```

