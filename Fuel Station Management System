# ============================================================

# AVERAGE SALE

# ============================================================

def average_sale():

```
print("\n----------- AVERAGE SALE -----------")

if len(sales) == 0:

    print("No sales found.")
    return

amounts = []

for sale in sales:

    total = calculate_cost(
        sale["fuel"],
        sale["litres"]
