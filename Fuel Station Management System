# ============================================================

# FUEL SUMMARY

# ============================================================

def fuel_summary():

```
print("\n----------- FUEL SUMMARY -----------")

summary = {}

# Start all fuel types at zero
for fuel in fuel_types:

    summary[fuel] = 0

# Add litres sold
for sale in sales:

    fuel = sale["fuel"]

    summary[fuel] = (
        summary[fuel] + sale["litres"]
    )

for fuel, litres in summary.items():

    print(
        fuel,
        ":",
        litres,
        "litres"
    )
```

# ============================================================

# VEHICLE SUMMARY

# ============================================================

def vehicle_summary():

```
print("\n----------- VEHICLE SUMMARY -----------")

summary = {}

for sale in sales:

    vehicle = sale["vehicle"]

    if vehicle in summary:

        summary[vehicle] = (
            summary[vehicle] + 1
        )

    else:

        summary[vehicle] = 1

if len(summary) == 0:

    print("No vehicle records found.")
    return

for vehicle, count in summary.items():

    print(
        vehicle,
        ":",
        count,
        "sales"
    )
```

# ============================================================

# DELETE SALE

# ============================================================

def delete_sale():

```
print("\n----------- DELETE SALE -----------")

try:

    sale_id = int(
        input("Enter sale ID: ")
    )

    sale = find_sale(sale_id)

    if sale is None:

        print("Sale not found.")
        return

    print("Customer:", sale["customer"])
    print("Vehicle :", sale["number"])

    confirm = input(
        "Delete this sale? (y/n): "
    ).strip().lower()

    if confirm == "y":

        sales.remove(sale)

        print("Sale deleted.")

    else:

        print("Delete cancelled.")

except ValueError:

    print("Enter a valid sale ID.")
```

