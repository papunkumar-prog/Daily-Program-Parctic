```

# ============================================================

# UPDATE LITRES

# ============================================================

def update_litres():

```
print("\n----------- UPDATE LITRES -----------")

try:

    sale_id = int(
        input("Enter sale ID: ")
    )

    sale = find_sale(sale_id)

    if sale is None:

        print("Sale not found.")
        return

    print(
        "Current litres:",
        sale["litres"]
    )

    litres = float(
        input("Enter new litres: ")
    )

    if litres <= 0:

        print("Litres must be greater than zero.")
        return

    sale["litres"] = litres

    total = calculate_cost(
        sale["fuel"],
        litres
    )

    print("Litres updated.")
    print("New total: ₹", total)

except ValueError:

    print("Enter a valid number.")
```

# ============================================================

# CHANGE FUEL TYPE

# ============================================================

def change_fuel():

```
print("\n----------- CHANGE FUEL TYPE -----------")

try:

    sale_id = int(
        input("Enter sale ID: ")
    )

    sale = find_sale(sale_id)

    if sale is None:

        print("Sale not found.")
