# ============================================================

# AVERAGE ATTENDANCE

# ============================================================

def average_attendance():

```
print("\n----------- AVERAGE ATTENDANCE -----------")

if len(members) == 0:

    print("No members found.")
    return

attendance = []

for member in members:

    attendance.append(
        member["days"]
    )

attendance_array = np.array(attendance)

average = np.mean(attendance_array)

print(
    "Average attendance:",
    round(average, 2),
    "days"
)
```

# ============================================================

# TOTAL MEMBERSHIP REVENUE

# ============================================================

def total_revenue():

```
print("\n----------- TOTAL REVENUE -----------")

total = 0

for member in members:

    fee = plan_price[member["plan"]]

    total = total + fee

print("Total membership revenue: ₹", total)
```

# ============================================================

# PLAN SUMMARY

# ============================================================

def plan_summary():

```
print("\n----------- PLAN SUMMARY -----------")

summary = {}

# Start all plans at zero
for plan in plans:

    summary[plan] = 0

# Count members in each plan
for member in members:

    plan = member["plan"]

    summary[plan] = (
        summary[plan] + 1
    )

for plan, count in summary.items():

    print(plan, ":", count)
```

# ============================================================

# DELETE MEMBER

# ============================================================

def delete_member():

```
print("\n----------- DELETE MEMBER -----------")

try:

    member_id = int(
        input("Enter member ID: ")
    )

    member = find_member(member_id)

    if member is None:

        print("Member not found.")
        return

    print("Member:", member["name"])

    confirm = input(
        "Delete this member? (y/n): "
    ).strip().lower()

    if confirm == "y":

        members.remove(member)

        print("Member deleted.")

    else:

        print("Delete cancelled.")


except ValueError:

    print("Enter a valid member ID.")
```

