# ============================================================

# GYM MEMBERSHIP MANAGEMENT SYSTEM

# Simple CLI project using Python basics and NumPy

# ============================================================

import numpy as np

# Available membership plans

plans = (
"Monthly",
"Quarterly",
"Half Yearly",
"Yearly"
)

# Membership price

plan_price = {
"Monthly": 1000,
"Quarterly": 2700,
"Half Yearly": 5000,
"Yearly": 9000
}

# Member details

members = [
{
"id": 101,
"name": "Papun",
"age": 30,
"plan": "Monthly",
"days": 20
},
{
"id": 102,
"name": "Amit",
"age": 25,
"plan": "Quarterly",
"days": 35
},
{
"id": 103,
"name": "Rahul",
"age": 28,
"plan": "Yearly",
"days": 80
}
]

# ============================================================

# FIND MEMBER

# ============================================================

def find_member(member_id):

```
for member in members:

    if member["id"] == member_id:
        return member

return None
```

# ============================================================

# ADD MEMBER

# ============================================================

def add_member():

```
print("\n----------- ADD MEMBER -----------")

try:

    member_id = int(input("Enter member ID: "))

    # Check duplicate ID
    for member in members:

        if member["id"] == member_id:
            print("Member ID already exists.")
            return

    name = input("Enter member name: ").strip().title()

    if name == "":
        print("Member name is required.")
        return

    age = int(input("Enter age: "))

    if age < 15:
        print("Minimum age is 15.")
        return

    print("\nMembership Plans:")

    for plan in plans:

        print(
            plan,
            "- ₹",
            plan_price[plan]
        )

    plan = input(
        "Enter membership plan: "
    ).strip().title()

    if plan not in plans:
        print("Invalid membership plan.")
        return

    days = int(
        input("Enter gym attendance days: ")
    )

    if days < 0:
        print("Attendance cannot be negative.")
        return

    member = {
        "id": member_id,
        "name": name,
        "age": age,
        "plan": plan,
        "days": days
    }

    members.append(member)

    print("Member added successfully.")


except ValueError:

    print("Please enter valid values.")
```

# ============================================================

# SHOW ALL MEMBERS

# ============================================================

def show_members():

```
print("\n----------- ALL MEMBERS -----------")

if len(members) == 0:

    print("No members found.")
    return

for member in members:

    fee = plan_price[member["plan"]]

    print("----------------------------------")
    print("ID         :", member["id"])
    print("Name       :", member["name"])
    print("Age        :", member["age"])
    print("Plan       :", member["plan"])
    print("Attendance :", member["days"], "days")
    print("Membership : ₹", fee)
```

# ============================================================

# SEARCH MEMBER

# ============================================================

def search_member():

```
print("\n----------- SEARCH MEMBER -----------")

try:

    member_id = int(
        input("Enter member ID: ")
    )

    member = find_member(member_id)

    if member is None:

        print("Member not found.")
        return

    fee = plan_price[member["plan"]]

    print("\nMember found")
    print("ID         :", member["id"])
    print("Name       :", member["name"])
    print("Age        :", member["age"])
    print("Plan       :", member["plan"])
    print("Attendance :", member["days"], "days")
    print("Membership : ₹", fee)


except ValueError:

    print("Enter a valid member ID.")
```

# ============================================================

# UPDATE MEMBERSHIP PLAN

# ============================================================

def update_plan():

```
print("\n----------- UPDATE PLAN -----------")

try:

    member_id = int(
        input("Enter member ID: ")
    )

    member = find_member(member_id)

    if member is None:

        print("Member not found.")
        return

    print("Current plan:", member["plan"])

    print("\nAvailable Plans:")

    for plan in plans:

        print(
            plan,
            "- ₹",
            plan_price[plan]
        )

    new_plan = input(
        "Enter new plan: "
    ).strip().title()

    if new_plan not in plans:

        print("Invalid plan.")
        return

    member["plan"] = new_plan

    print("Membership plan updated.")


except ValueError:

    print("Enter a valid member ID.")
```

# ============================================================

# UPDATE ATTENDANCE

# ============================================================

def update_attendance():

```
print("\n----------- UPDATE ATTENDANCE -----------")

try:

    member_id = int(
        input("Enter member ID: ")
    )

    member = find_member(member_id)

    if member is None:

        print("Member not found.")
        return

    print(
        "Current attendance:",
        member["days"]
    )

    days = int(
        input("Enter new attendance days: ")
    )

    if days < 0:

        print("Attendance cannot be negative.")
        return

    member["days"] = days

    print("Attendance updated.")


except ValueError:

    print("Enter a valid number.")
```

# ============================================================

# MEMBER ATTENDANCE CATEGORY

# ============================================================

def attendance_category(days):

```
if days >= 50:

    return "Excellent"

elif days >= 30:

    return "Good"

elif days >= 15:

    return "Average"

else:

    return "Low"
```

# ============================================================

# SHOW ATTENDANCE REPORT

# ============================================================

def attendance_report():

```
print("\n----------- ATTENDANCE REPORT -----------")

if len(members) == 0:

    print("No members found.")
    return

for member in members:

    category = attendance_category(
        member["days"]
    )

    print("----------------------------------")
    print("Name       :", member["name"])
    print("Plan       :", member["plan"])
    print("Attendance :", member["days"])
    print("Category   :", category)
```

# ============================================================

# HIGHEST ATTENDANCE

# ============================================================

def highest_attendance():

```
print("\n----------- HIGHEST ATTENDANCE -----------")

if len(members) == 0:

    print("No members found.")
    return

attendance = []

for member in members:

    attendance.append(
        member["days"]
    )

attendance_array = np.array(attendance)

highest = np.max(attendance_array)

for member in members:

    if member["days"] == highest:

        print("Name       :", member["name"])
        print("Attendance :", highest, "days")
```

