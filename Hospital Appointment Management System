# --------------------------------------------------
# 4. REGISTER A NEW PATIENT
# Flow: Read JSON -> Validate -> Check duplicate
#       -> Generate ID -> Save patient -> Respond
# --------------------------------------------------
@app.route("/api/patients", methods=["POST"])
def add_patient():

    data = request.get_json(silent=True)

    patient_data, error = validate_patient(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    # Check duplicate phone or email
    for patient in patients:

        if patient["phone"] == patient_data["phone"]:
            return jsonify({
                "error": "Phone number already registered"
            }), 409

        if patient["email"] == patient_data["email"]:
            return jsonify({
                "error": "Email already registered"
            }), 409

    # Generate patient ID
    if patients:
        new_id = max(patient["id"] for patient in patients) + 1
    else:
        new_id = 1001

    new_patient = {
        "id": new_id,
        **patient_data
    }

    patients.append(new_patient)

    return jsonify({
        "message": "Patient registered successfully",
        "patient": new_patient
    }), 201


# --------------------------------------------------
# 5. GET ALL APPOINTMENTS
# Flow: Read filters -> Filter appointments
#       -> Return matching records
# --------------------------------------------------
@app.route("/api/appointments", methods=["GET"])
def get_appointments():

    filtered_appointments = appointments

    # Filter by status
    status = request.args.get("status")

    if status:

        status = status.strip().title()

        if status not in APPOINTMENT_STATUSES:
            return jsonify({
                "error": "Invalid appointment status"
            }), 400

        filtered_appointments = [
            appointment for appointment in filtered_appointments
            if appointment["status"] == status
        ]

    # Filter by doctor
    doctor_id = request.args.get("doctor_id")

    if doctor_id is not None:

        try:
            doctor_id = int(doctor_id)
        except ValueError:
            return jsonify({
                "error": "Doctor ID must be an integer"
            }), 400

        filtered_appointments = [
            appointment for appointment in filtered_appointments
            if appointment["doctor_id"] == doctor_id
        ]

    # Filter by patient
    patient_id = request.args.get("patient_id")

    if patient_id is not None:

        try:
            patient_id = int(patient_id)
        except ValueError:
            return jsonify({
                "error": "Patient ID must be an integer"
            }), 400

        filtered_appointments = [
            appointment for appointment in filtered_appointments
            if appointment["patient_id"] == patient_id
        ]

    return jsonify({
        "total_appointments": len(filtered_appointments),
        "appointments": filtered_appointments
    }), 200


