# --------------------------------------------------
# 7. BOOK A NEW APPOINTMENT
# Flow: Read JSON -> Validate -> Check time conflicts
#       -> Generate ID -> Save appointment -> Respond
# --------------------------------------------------
@app.route("/api/appointments", methods=["POST"])
def book_appointment():

    data = request.get_json(silent=True)

    appointment_data, error = validate_appointment(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    # Check doctor and patient availability
    conflict = check_appointment_conflict(
        appointment_data["doctor_id"],
        appointment_data["patient_id"],
        appointment_data["appointment_date"],
        appointment_data["appointment_time"]
    )

    if conflict:
        return jsonify({
            "error": conflict
        }), 409

    # Generate appointment ID
    if appointments:
        new_id = max(
            appointment["id"] for appointment in appointments
        ) + 1
    else:
        new_id = 501

    new_appointment = {
        "id": new_id,
        **appointment_data,
        "status": "Booked"
    }

    appointments.append(new_appointment)

    return jsonify({
        "message": "Appointment booked successfully",
        "appointment": new_appointment
    }), 201


# --------------------------------------------------
# 8. RESCHEDULE AN APPOINTMENT
# Flow: Read ID -> Validate new details -> Find record
#       -> Check doctor availability -> Update -> Respond
# --------------------------------------------------
@app.route("/api/appointments/<int:appointment_id>", methods=["PUT"])
def update_appointment(appointment_id):

    data = request.get_json(silent=True)

    appointment_data, error = validate_appointment(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    appointment = find_appointment(appointment_id)

    if appointment is None:
        return jsonify({
            "error": "Appointment not found"
        }), 404

    if appointment["status"] != "Booked":
        return jsonify({
            "error": "Only booked appointments can be rescheduled"
        }), 409

    conflict = check_appointment_conflict(
        appointment_data["doctor_id"],
        appointment_data["patient_id"],
        appointment_data["appointment_date"],
        appointment_data["appointment_time"],
        exclude_id=appointment_id
    )

    if conflict:
        return jsonify({
            "error": conflict
        }), 409

    appointment.update(appointment_data)

    return jsonify({
        "message": "Appointment rescheduled successfully",
        "appointment": appointment
    }), 200


# --------------------------------------------------
# 9. CANCEL APPOINTMENT
# Flow: Read ID -> Find appointment -> Check status
#       -> Update status -> Return response
# --------------------------------------------------
@app.route("/api/appointments/<int:appointment_id>/cancel", methods=["POST"])
def cancel_appointment(appointment_id):

    appointment = find_appointment(appointment_id)

    if appointment is None:
        return jsonify({
            "error": "Appointment not found"
        }), 404

    if appointment["status"] != "Booked":
        return jsonify({
            "error": "Only booked appointments can be cancelled"
        }), 409

    appointment["status"] = "Cancelled"

    return jsonify({
        "message": "Appointment cancelled successfully",
        "appointment": appointment
    }), 200


# --------------------------------------------------
# 10. COMPLETE APPOINTMENT
# Flow: Find appointment -> Check booked status
#       -> Update status -> Return response
# --------------------------------------------------
@app.route("/api/appointments/<int:appointment_id>/complete", methods=["POST"])
def complete_appointment(appointment_id):

    appointment = find_appointment(appointment_id)

    if appointment is None:
        return jsonify({
            "error": "Appointment not found"
        }), 404

    if appointment["status"] != "Booked":
        return jsonify({
            "error": "Only booked appointments can be completed"
        }), 409

    appointment["status"] = "Completed"

    return jsonify({
        "message": "Appointment completed successfully",
        "appointment": appointment
    }), 200


# --------------------------------------------------
# 11. APPOINTMENT SUMMARY
# Flow: Count statuses -> Calculate consultation revenue
#       -> Return appointment statistics
# --------------------------------------------------
@app.route("/api/appointments/summary", methods=["GET"])
def appointment_summary():

    booked = 0
    completed = 0
    cancelled = 0
    total_revenue = 0

    for appointment in appointments:

        if appointment["status"] == "Booked":
            booked += 1

        elif appointment["status"] == "Completed":
            completed += 1

            total_revenue += appointment["consultation_fee"]

        elif appointment["status"] == "Cancelled":
            cancelled += 1

    return jsonify({
        "total_doctors": len(doctors),
        "total_patients": len(patients),
        "total_appointments": len(appointments),
        "booked_appointments": booked,
        "completed_appointments": completed,
        "cancelled_appointments": cancelled,
        "completed_consultation_revenue": total_revenue
    }), 200


