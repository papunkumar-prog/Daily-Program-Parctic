]


# Store appointment records
appointments = []


# Allowed appointment statuses
APPOINTMENT_STATUSES = [
    "Booked",
    "Completed",
    "Cancelled"
]


# Appointment duration in minutes
APPOINTMENT_DURATION = 30


# --------------------------------------------------
# HELPER FUNCTION: FIND DOCTOR
# Flow: Receive doctor ID -> Search doctor list
#       -> Return matching doctor
# --------------------------------------------------
def find_doctor(doctor_id):

    for doctor in doctors:

        if doctor["id"] == doctor_id:
            return doctor

    return None


# --------------------------------------------------
# HELPER FUNCTION: FIND PATIENT
# Flow: Receive patient ID -> Search patient list
#       -> Return matching patient
# --------------------------------------------------
def find_patient(patient_id):

    for patient in patients:

        if patient["id"] == patient_id:
            return patient

    return None


# --------------------------------------------------
# HELPER FUNCTION: FIND APPOINTMENT
# Flow: Receive appointment ID -> Search appointment list
#       -> Return matching appointment
# --------------------------------------------------
def find_appointment(appointment_id):

    for appointment in appointments:

        if appointment["id"] == appointment_id:
            return appointment

    return None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE DATE AND TIME
# Flow: Receive date and time -> Validate format
#       -> Return datetime object
# --------------------------------------------------
def parse_appointment_datetime(date_value, time_value):

    if not isinstance(date_value, str):
        return None

    if not isinstance(time_value, str):
        return None

    try:
        parsed = datetime.strptime(
            f"{date_value} {time_value}",
            "%Y-%m-%d %H:%M"
        )

        expected_date = parsed.strftime("%Y-%m-%d")
        expected_time = parsed.strftime("%H:%M")

        if expected_date != date_value:
            return None

        if expected_time != time_value:
            return None

        return parsed

    except ValueError:
        return None


# --------------------------------------------------
# HELPER FUNCTION: CHECK APPOINTMENT CONFLICT
# Flow: Read doctor and patient -> Check existing
#       appointments -> Detect overlapping time slots
#       -> Return error if conflict exists
# --------------------------------------------------
def check_appointment_conflict(
    doctor_id,
    patient_id,
    appointment_date,
    appointment_time,
    exclude_id=None
):

    new_start = parse_appointment_datetime(
        appointment_date,
        appointment_time
    )

    new_end = new_start + timedelta(
        minutes=APPOINTMENT_DURATION
    )

    for appointment in appointments:

        if appointment["id"] == exclude_id:
            continue

        if appointment["status"] == "Cancelled":
            continue

        existing_start = parse_appointment_datetime(
            appointment["appointment_date"],
            appointment["appointment_time"]
        )

        existing_end = existing_start + timedelta(
            minutes=APPOINTMENT_DURATION
        )

        # Check whether appointment times overlap
        overlap = (
            new_start < existing_end
            and existing_start < new_end
        )

        if overlap:

            if appointment["doctor_id"] == doctor_id:
                return "Doctor already has an appointment at this time"

            if appointment["patient_id"] == patient_id:
                return "Patient already has an appointment at this time"

    return None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE PATIENT DATA
# Flow: Receive JSON -> Validate patient details
#       -> Return cleaned patient information
# --------------------------------------------------
def validate_patient(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = ["name", "phone", "email"]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    name = data["name"]
    phone = data["phone"]
    email = data["email"]

    if not all(
        isinstance(value, str)
        for value in [name, phone, email]
    ):
        return None, "Patient details must be text"

    name = name.strip()
    phone = phone.strip()
    email = email.strip().lower()

    if not all([name, phone, email]):
        return None, "Patient details cannot be empty"

    if not phone.isdigit() or len(phone) != 10:
        return None, "Phone number must contain 10 digits"

    if "@" not in email or "." not in email.split("@")[-1]:
        return None, "Enter a valid email address"

    return {
        "name": name,
        "phone": phone,
        "email": email
    }, None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE APPOINTMENT DATA
# Flow: Read JSON -> Find doctor and patient
#       -> Validate date and time -> Check future date
#       -> Return appointment information
# --------------------------------------------------
def validate_appointment(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "patient_id",
        "doctor_id",
        "appointment_date",
        "appointment_time",
        "reason"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    patient_id = data["patient_id"]
    doctor_id = data["doctor_id"]
    appointment_date = data["appointment_date"]
    appointment_time = data["appointment_time"]
    reason = data["reason"]

    # Validate patient ID
    if isinstance(patient_id, bool) or not isinstance(patient_id, int):
        return None, "Patient ID must be an integer"

    if patient_id <= 0:
        return None, "Patient ID must be greater than zero"

    # Validate doctor ID
    if isinstance(doctor_id, bool) or not isinstance(doctor_id, int):
        return None, "Doctor ID must be an integer"

    if doctor_id <= 0:
        return None, "Doctor ID must be greater than zero"

    # Check patient existence
    patient = find_patient(patient_id)

    if patient is None:
        return None, "Patient not found"

    # Check doctor existence
    doctor = find_doctor(doctor_id)

    if doctor is None:
        return None, "Doctor not found"

    # Validate appointment date and time
    appointment_datetime = parse_appointment_datetime(
        appointment_date,
        appointment_time
    )

    if appointment_datetime is None:
        return None, "Invalid date or time. Use YYYY-MM-DD and HH:MM"

    # Appointment must be in the future
    if appointment_datetime <= datetime.now():
        return None, "Appointment must be scheduled in the future"

    # Validate appointment reason
    if not isinstance(reason, str):
        return None, "Appointment reason must be text"

    reason = reason.strip()

    if not reason:
        return None, "Appointment reason cannot be empty"

    appointment_data = {
        "patient_id": patient_id,
        "patient_name": patient["name"],
        "doctor_id": doctor_id,
        "doctor_name": doctor["name"],
        "specialization": doctor["specialization"],
        "appointment_date": appointment_date,
        "appointment_time": appointment_time,
        "reason": reason,
        "consultation_fee": doctor["consultation_fee"]
    }

    return appointment_data, None


