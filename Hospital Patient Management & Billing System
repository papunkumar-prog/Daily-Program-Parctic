# 8. HOSPITAL BILL ANALYSIS USING NUMPY

# ============================================================

def bill_analysis():

```
print("\n========== 📊 BILL ANALYSIS ==========")

if len(patients) == 0:

    print("No patient data available.")

    return

# Get all patient bills
bills = np.array(
    [patient["bill"] for patient in patients]
)

print("Total Hospital Billing: ₹", np.sum(bills))

print(
    "Average Patient Bill: ₹",
    np.mean(bills)
)

print(
    "Highest Patient Bill: ₹",
    np.max(bills)
)

print(
    "Lowest Patient Bill: ₹",
    np.min(bills)
)
```

# ============================================================

# 9. DEPARTMENT ANALYSIS

# ============================================================

def department_analysis():

```
print("\n========== 📊 DEPARTMENT ANALYSIS ==========")

for department in departments:

    count = 0

    for patient in patients:

        if patient["department"] == department:

            count += 1

    print(
        department,
        ":",
        count,
        "patient(s)"
    )
```

