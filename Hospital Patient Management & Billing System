# 1. DISPLAY ALL PATIENTS

# ============================================================

def display_patients():

```
print("\n========== 🏥 ALL PATIENTS ==========")

if len(patients) == 0:

    print("No patient records available.")
    return

# for loop reads every patient
for patient in patients:

    print(
        f'ID: {patient["id"]} | '
        f'Name: {patient["name"]} | '
        f'Age: {patient["age"]} | '
        f'Gender: {patient["gender"]} | '
        f'Department: {patient["department"]} | '
        f'Bill: ₹{patient["bill"]} | '
        f'Status: {patient["status"]}'
    )
```

# ============================================================

# 2. ADD NEW PATIENT

# ============================================================

def add_patient():

```
print("\n========== ➕ ADD PATIENT ==========")

try:

    patient_id = int(input("Enter Patient ID: "))

    name = input("Enter Patient Name: ").strip().title()

    age = int(input("Enter Age: "))

    gender = input("Enter Gender: ").strip().title()

    print("\nAvailable Departments:")

    for department in departments:

        print("-", department)

    department = input("Enter Department: ").strip().title()

    # Validate department
    if department not in departments:

        print("❌ Invalid department.")
        return

    if age <= 0:

        print("❌ Age must be greater than 0.")
        return

    # Check duplicate patient ID
    for patient in patients:

        if patient["id"] == patient_id:

            print("❌ Patient ID already exists.")
            return

    new_patient = {

        "id": patient_id,
        "name": name,
        "age": age,
        "gender": gender,
        "department": department,
        "bill": 0,
        "status": "Admitted"
    }

    patients.append(new_patient)

    print("✅ Patient added successfully.")


except ValueError:

    print("❌ Please enter valid values.")
```

# ============================================================

# 3. SEARCH PATIENT

# ============================================================

def search_patient():

```
print("\n========== 🔍 SEARCH PATIENT ==========")

search = input("Enter patient name: ").strip().lower()

found = False

for patient in patients:

    if search in patient["name"].lower():

        print("\nPatient Found")

        print("Patient ID:", patient["id"])
        print("Name:", patient["name"])
        print("Age:", patient["age"])
        print("Gender:", patient["gender"])
        print("Department:", patient["department"])
        print("Bill:", patient["bill"])
        print("Status:", patient["status"])

        found = True

if not found:

    print("❌ Patient not found.")
```

# ============================================================

# 4. ADD BILL

# ============================================================

def add_bill():

```
print("\n========== 💰 ADD PATIENT BILL ==========")

try:

    patient_id = int(input("Enter Patient ID: "))

    amount = float(input("Enter Bill Amount: "))

    if amount <= 0:

        print("❌ Amount must be greater than 0.")
        return

    for patient in patients:

        if patient["id"] == patient_id:

            patient["bill"] += amount

            print("✅ Bill added successfully.")

            print(
                "Current Bill: ₹",
                patient["bill"]
            )

            return

    print("❌ Patient ID not found.")


except ValueError:

    print("❌ Please enter valid numbers.")
```

# ============================================================

# 5. DISCHARGE PATIENT

# ============================================================

def discharge_patient():

```
print("\n========== 🚪 DISCHARGE PATIENT ==========")

try:

    patient_id = int(input("Enter Patient ID: "))

    for patient in patients:

        if patient["id"] == patient_id:

            if patient["status"] == "Admitted":

                patient["status"] = "Discharged"

                print(
                    "✅ Patient discharged successfully."
                )

            else:

                print("❌ Patient is already discharged.")

            return

    print("❌ Patient ID not found.")


except ValueError:

    print("❌ Enter a valid Patient ID.")
```

# ============================================================

# 6. PATIENT BILL DETAILS

# ============================================================

def patient_bill():

```
print("\n========== 💳 PATIENT BILL ==========")

try:

    patient_id = int(input("Enter Patient ID: "))

    for patient in patients:

        if patient["id"] == patient_id:

            print("\n========== BILL ==========")

            print("Patient:", patient["name"])
            print("Department:", patient["department"])
            print("Total Bill: ₹", patient["bill"])

            if patient["bill"] == 0:

                print("No bill generated.")

            elif patient["bill"] < 2000:

                print("Bill Category: Low")

            elif patient["bill"] <= 5000:

                print("Bill Category: Medium")

            else:

                print("Bill Category: High")

            return

    print("❌ Patient ID not found.")


except ValueError:

    print("❌ Enter a valid Patient ID.")
```

