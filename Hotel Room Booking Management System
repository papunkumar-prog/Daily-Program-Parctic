# --------------------------------------------------
# 7. CREATE A NEW BOOKING
# Flow: Read JSON -> Validate -> Check availability
#       -> Generate ID -> Save booking -> Respond
# --------------------------------------------------
@app.route("/api/bookings", methods=["POST"])
def create_booking():

    data = request.get_json(silent=True)

    booking_data, error = validate_booking(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    start_date = parse_date(booking_data["check_in"])
    end_date = parse_date(booking_data["check_out"])

    if not is_room_available(
        booking_data["room_id"],
        start_date,
        end_date
    ):
        return jsonify({
            "error": "Room is already booked for the selected dates"
        }), 409

    # Generate the next available booking ID
    if bookings:
        new_id = max(
            booking["id"] for booking in bookings
        ) + 1
    else:
        new_id = 701

    new_booking = {
        "id": new_id,
        **booking_data
    }

    bookings.append(new_booking)

    return jsonify({
        "message": "Hotel booking created successfully",
        "booking": new_booking
    }), 201


# --------------------------------------------------
# 8. UPDATE AN EXISTING BOOKING
# Flow: Read ID -> Validate JSON -> Check availability
#       -> Update booking -> Return response
# --------------------------------------------------
@app.route("/api/bookings/<int:booking_id>", methods=["PUT"])
def update_booking(booking_id):

    data = request.get_json(silent=True)

    booking_data, error = validate_booking(
        data,
        require_status=True
    )

    if error:
        return jsonify({
            "error": error
        }), 400

    # Find the booking first
    for booking in bookings:

        if booking["id"] == booking_id:

            # Check availability unless the booking is cancelled
            if booking_data["status"] != "Cancelled":

                start_date = parse_date(booking_data["check_in"])
                end_date = parse_date(booking_data["check_out"])

                if not is_room_available(
                    booking_data["room_id"],
                    start_date,
                    end_date,
                    exclude_booking_id=booking_id
                ):
                    return jsonify({
                        "error": "Room is already booked for the selected dates"
                    }), 409

            booking.update(booking_data)

            return jsonify({
                "message": "Booking updated successfully",
                "booking": booking
            }), 200

    return jsonify({
        "error": "Booking not found"
    }), 404


# --------------------------------------------------
# 9. DELETE A BOOKING
# Flow: Read ID -> Find booking -> Remove -> Respond
# --------------------------------------------------
@app.route("/api/bookings/<int:booking_id>", methods=["DELETE"])
def delete_booking(booking_id):

    for booking in bookings:

        if booking["id"] == booking_id:

            bookings.remove(booking)

            return jsonify({
                "message": "Booking deleted successfully"
            }), 200

    return jsonify({
        "error": "Booking not found"
    }), 404


# --------------------------------------------------
# 10. BOOKING SUMMARY
# Flow: Count bookings -> Calculate status totals
#       -> Calculate booking value -> Return summary
# --------------------------------------------------
@app.route("/api/bookings/summary", methods=["GET"])
def booking_summary():

    status_counts = {
        status: 0 for status in BOOKING_STATUSES
    }

    total_booking_value = 0

    for booking in bookings:

        status_counts[booking["status"]] += 1

        if booking["status"] != "Cancelled":
            total_booking_value += booking["total_amount"]

    return jsonify({
        "total_bookings": len(bookings),
        "confirmed_bookings": status_counts["Confirmed"],
        "checked_in_bookings": status_counts["Checked In"],
        "checked_out_bookings": status_counts["Checked Out"],
        "cancelled_bookings": status_counts["Cancelled"],
        "total_booking_value": total_booking_value
    }), 200


