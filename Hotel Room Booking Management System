# --------------------------------------------------
# 4. FIND AVAILABLE ROOMS
# Flow: Read dates -> Validate -> Check room availability
#       -> Return available rooms
# --------------------------------------------------
@app.route("/api/rooms/availability", methods=["GET"])
def available_rooms():

    check_in = request.args.get("check_in")
    check_out = request.args.get("check_out")
    guests_text = request.args.get("guests", "1")

    start_date = parse_date(check_in)
    end_date = parse_date(check_out)

    if start_date is None or end_date is None:
        return jsonify({
            "error": "Valid check-in and check-out dates are required"
        }), 400

    if end_date <= start_date:
        return jsonify({
            "error": "Check-out must be after check-in"
        }), 400

    try:
        guest_count = int(guests_text)
    except ValueError:
        return jsonify({
            "error": "Guests must be a whole number"
        }), 400

    if guest_count <= 0:
        return jsonify({
            "error": "Guests must be greater than zero"
        }), 400

    available = []

    for room in rooms:

        if guest_count > room["capacity"]:
            continue

        if is_room_available(
            room["id"],
            start_date,
            end_date
        ):
            available.append(room)

    return jsonify({
        "check_in": check_in,
        "check_out": check_out,
        "available_rooms": len(available),
        "rooms": available
    }), 200


# --------------------------------------------------
# 5. GET ALL BOOKINGS
# Flow: Read filters -> Filter bookings -> Return records
# --------------------------------------------------
@app.route("/api/bookings", methods=["GET"])
def get_bookings():

    filtered_bookings = bookings

    status = request.args.get("status")

    if status:

        status = status.strip().title()

        if status not in BOOKING_STATUSES:
            return jsonify({
                "error": "Invalid booking status"
            }), 400

        filtered_bookings = [
            booking for booking in filtered_bookings
            if booking["status"] == status
        ]

    guest = request.args.get("guest")

    if guest is not None:

        guest = guest.strip().lower()

        if not guest:
            return jsonify({
                "error": "Guest name cannot be empty"
            }), 400

        filtered_bookings = [
            booking for booking in filtered_bookings
            if guest in booking["guest_name"].lower()
        ]

    return jsonify({
        "total_bookings": len(filtered_bookings),
        "bookings": filtered_bookings
    }), 200


