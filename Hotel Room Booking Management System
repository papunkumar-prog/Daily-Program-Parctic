# Allowed booking statuses
BOOKING_STATUSES = [
    "Confirmed",
    "Checked In",
    "Checked Out",
    "Cancelled"
]


# --------------------------------------------------
# HELPER FUNCTION: FIND ROOM
# Flow: Receive room ID -> Search room list -> Return room
# --------------------------------------------------
def find_room(room_id):

    for room in rooms:

        if room["id"] == room_id:
            return room

    return None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE DATE
# Flow: Receive date -> Check format -> Return date
# --------------------------------------------------
def parse_date(value):

    if not isinstance(value, str):
        return None

    try:
        parsed = datetime.strptime(value, "%Y-%m-%d").date()

        if parsed.isoformat() != value:
            return None

        return parsed

    except ValueError:
        return None


# --------------------------------------------------
# HELPER FUNCTION: CHECK ROOM AVAILABILITY
# Flow: Read room ID -> Check existing bookings
#       -> Check date overlap -> Return availability
# --------------------------------------------------
def is_room_available(
    room_id,
    new_check_in,
    new_check_out,
    exclude_booking_id=None
):

    for booking in bookings:

        if booking["room_id"] != room_id:
            continue

        if booking["status"] == "Cancelled":
            continue

        if booking["id"] == exclude_booking_id:
            continue

        existing_check_in = parse_date(booking["check_in"])
        existing_check_out = parse_date(booking["check_out"])

        # Check whether the requested dates overlap
        if (
            new_check_in < existing_check_out
            and existing_check_in < new_check_out
        ):
            return False

    return True


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE BOOKING DATA
# Flow: Read JSON -> Validate fields -> Check room
#       -> Calculate nights and total price
#       -> Return booking data
# --------------------------------------------------
def validate_booking(data, require_status=False):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "guest_name",
        "room_id",
        "check_in",
        "check_out",
        "guests"
    ]

    if require_status:
        required_fields.append("status")

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    guest_name = data["guest_name"]
    room_id = data["room_id"]
    check_in = data["check_in"]
    check_out = data["check_out"]
    guest_count = data["guests"]

    # Validate guest name
    if not isinstance(guest_name, str):
        return None, "Guest name must be text"

    guest_name = guest_name.strip()

    if not guest_name:
        return None, "Guest name cannot be empty"

    # Validate room ID
    if isinstance(room_id, bool) or not isinstance(room_id, int):
        return None, "Room ID must be an integer"

    if room_id <= 0:
        return None, "Room ID must be greater than zero"

    # Check whether room exists
    room = find_room(room_id)

    if room is None:
        return None, "Room not found"

    # Validate number of guests
    if isinstance(guest_count, bool) or not isinstance(guest_count, int):
        return None, "Guest count must be an integer"

    if guest_count <= 0:
        return None, "Guest count must be greater than zero"

    if guest_count > room["capacity"]:
        return None, "Guest count exceeds room capacity"

    # Validate check-in date
    parsed_check_in = parse_date(check_in)

    if parsed_check_in is None:
        return None, "Invalid check-in date. Use YYYY-MM-DD"

    # Validate check-out date
    parsed_check_out = parse_date(check_out)

    if parsed_check_out is None:
        return None, "Invalid check-out date. Use YYYY-MM-DD"

    if parsed_check_out <= parsed_check_in:
        return None, "Check-out must be after check-in"

    # Validate booking status
    if require_status:

        status = data["status"]

        if not isinstance(status, str):
            return None, "Status must be text"

        status = status.strip().title()

        if status not in BOOKING_STATUSES:
            return None, "Invalid booking status"

    else:
        status = "Confirmed"

    # Calculate number of nights
    total_nights = (parsed_check_out - parsed_check_in).days

    # Calculate total booking amount
    nightly_rate = room["price_per_night"]

    total_amount = nightly_rate * total_nights

    booking_data = {
        "guest_name": guest_name,
        "room_id": room_id,
        "check_in": check_in,
        "check_out": check_out,
        "guests": guest_count,
        "status": status,
        "nights": total_nights,
        "nightly_rate": nightly_rate,
        "total_amount": total_amount
    }

    return booking_data, None


