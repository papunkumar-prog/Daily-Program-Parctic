# GET TICKETS BY STATUS

# ============================================================

@app.route("/api/tickets/status/<status>", methods=["GET"])
def tickets_by_status(status):

```
result = []

for ticket in tickets:

    if ticket["status"].lower() == status.lower():

        result.append(ticket)

if len(result) == 0:

    return jsonify({
        "message": "No tickets found for this status"
    }), 404

return jsonify(result)
```

