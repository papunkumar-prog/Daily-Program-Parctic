# -----------------------------
# 1. Brightness Adjustment
# -----------------------------
def adjus_brightness(img, value):
    result = np.clip(img.astype(np.int16) + value, 0, 255)
    return result.astype(np.uint8)
# -----------------------------
# 2. Negative Image
# -----------------------------
def negative_image(img):
    return 255 - img
# -----------------------------
# 3. Thresholding
# -----------------------------
def threshold_image(img, thershold):
    # Convert RGB to grayscale
    gray = img.mean(axis=2)
    binary = np.where(gray > thershold,255,0)
    return binary.astype(np.uint8)
# -----------------------------
# 4. Rotate 90° Clockwise
# -----------------------------
def rotate_anticlockwise(img):
    return np.rot90(img)
# -----------------------------
# 6. Horizontal Flip
# -----------------------------
def flip_horizontal(img):
    return np.fliplr(img)
# -----------------------------
# 7. Vertical Flip
# -----------------------------
def flip_vertical(img):
    return np.flipud(img)
# -----------------------------
# 8. Crop Image
# -----------------------------
def crop_image(img, start_row, end_row, start_col, end_col):
    return img[start_row:end_row, start_col:end_col]
# -----------------------------
# 9. Grayscale
# -----------------------------
def grayscale(img):
    gray = np.dot(img[..., :3], [0.299, 0.587, 0.114])
    return gray.astype(np.unit8)
