import numpy as np

# Available product categories

categories = (
"Electronics",
"Grocery",
"Clothing",
"Stationery",
"Home"
)

# Product data

products = [
{
"id": 101,
"name": "Keyboard",
"category": "Electronics",
"price": 800,
"stock": 10
},
{
"id": 102,
"name": "Rice",
"category": "Grocery",
"price": 600,
"stock": 25
},
{
"id": 103,
"name": "T-Shirt",
"category": "Clothing",
"price": 500,
"stock": 15
},
{
"id": 104,
"name": "Notebook",
"category": "Stationery",
"price": 80,
"stock": 40
}
]

# ============================================================

# FIND PRODUCT

# ============================================================

def find_product(product_id):

```
for product in products:

    if product["id"] == product_id:
        return product

return None
```

# ============================================================

# ADD PRODUCT

# ============================================================

def add_product():

```
print("\n----------- ADD PRODUCT -----------")

try:

    product_id = int(input("Enter product ID: "))

    # Check duplicate ID
    for product in products:

        if product["id"] == product_id:
            print("Product ID already exists.")
            return

    name = input("Enter product name: ").strip().title()

    if name == "":
        print("Product name is required.")
        return

    print("\nCategories:")

    for category in categories:
        print("-", category)

    category = input("Enter category: ").strip().title()

    if category not in categories:
        print("Invalid category.")
        return

    price = float(input("Enter product price: "))

    if price <= 0:
        print("Price must be greater than zero.")
        return

    stock = int(input("Enter stock quantity: "))

    if stock < 0:
        print("Stock cannot be negative.")
        return

    new_product = {
        "id": product_id,
        "name": name,
        "category": category,
        "price": price,
        "stock": stock
    }

    products.append(new_product)

    print("Product added successfully.")

except ValueError:

    print("Please enter valid values.")
```

# ============================================================

# SHOW ALL PRODUCTS

# ============================================================

def show_products():

```
print("\n----------- ALL PRODUCTS -----------")

if len(products) == 0:
    print("No products found.")
    return

for product in products:

    value = product["price"] * product["stock"]

    print("-----------------------------------")
    print("ID       :", product["id"])
    print("Name     :", product["name"])
    print("Category :", product["category"])
    print("Price    : ₹", product["price"])
    print("Stock    :", product["stock"])
    print("Value    : ₹", value)
```

# ============================================================

# SEARCH PRODUCT

# ============================================================

def search_product():

```
print("\n----------- SEARCH PRODUCT -----------")

name = input("Enter product name: ").strip().lower()

found = False

for product in products:

    if product["name"].lower() == name:

        print("\nProduct found")
        print("ID       :", product["id"])
        print("Name     :", product["name"])
        print("Category :", product["category"])
        print("Price    : ₹", product["price"])
        print("Stock    :", product["stock"])

        found = True

if not found:
    print("Product not found.")
```

# ============================================================

# UPDATE STOCK

# ============================================================

def update_stock():

```
print("\n----------- UPDATE STOCK -----------")

try:

    product_id = int(input("Enter product ID: "))

    product = find_product(product_id)

    if product is None:
        print("Product not found.")
        return

    print("Product:", product["name"])
    print("Current stock:", product["stock"])

    new_stock = int(input("Enter new stock: "))

    if new_stock < 0:
        print("Stock cannot be negative.")
        return

    product["stock"] = new_stock

    print("Stock updated successfully.")

except ValueError:

    print("Enter a valid number.")
```

# ============================================================

# SELL PRODUCT

# ============================================================

def sell_product():

```
print("\n----------- SELL PRODUCT -----------")

try:

    product_id = int(input("Enter product ID: "))

    product = find_product(product_id)

    if product is None:
        print("Product not found.")
        return

    print("Product:", product["name"])
    print("Available stock:", product["stock"])

    quantity = int(input("Enter quantity to sell: "))

    if quantity <= 0:
        print("Quantity must be greater than zero.")
        return

    if quantity > product["stock"]:
        print("Not enough stock available.")
        return

    product["stock"] = product["stock"] - quantity

    total = product["price"] * quantity

    print("\nSale completed.")
    print("Product :", product["name"])
    print("Quantity:", quantity)
    print("Amount  : ₹", total)
    print("Remaining stock:", product["stock"])

except ValueError:

    print("Enter a valid number.")
```

# ============================================================

# RESTOCK PRODUCT

# ============================================================

def restock_product():

```
print("\n----------- RESTOCK PRODUCT -----------")

try:

    product_id = int(input("Enter product ID: "))

    product = find_product(product_id)

    if product is None:
        print("Product not found.")
        return

    quantity = int(input("Enter quantity to add: "))

    if quantity <= 0:
        print("Quantity must be greater than zero.")
        return

    product["stock"] = product["stock"] + quantity

    print("Stock added successfully.")
    print("New stock:", product["stock"])

except ValueError:

    print("Enter a valid number.")
```

