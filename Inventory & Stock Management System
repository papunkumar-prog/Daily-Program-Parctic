# ============================================================

# HIGHEST STOCK PRODUCT

# ============================================================

def highest_stock():

```
print("\n----------- HIGHEST STOCK -----------")

if len(products) == 0:
    print("No products found.")
    return

stock_list = []

for product in products:
    stock_list.append(product["stock"])

stock_array = np.array(stock_list)

highest = np.max(stock_array)

for product in products:

    if product["stock"] == highest:

        print("Product :", product["name"])
        print("Stock   :", highest)
```

# ============================================================

# LOWEST STOCK PRODUCT

# ============================================================

def lowest_stock():

```
print("\n----------- LOWEST STOCK -----------")

if len(products) == 0:
    print("No products found.")
    return

stock_list = []

for product in products:
    stock_list.append(product["stock"])

stock_array = np.array(stock_list)

lowest = np.min(stock_array)

for product in products:

    if product["stock"] == lowest:

        print("Product :", product["name"])
        print("Stock   :", lowest)
```

# ============================================================

# AVERAGE STOCK

# ============================================================

def average_stock():

```
print("\n----------- AVERAGE STOCK -----------")

if len(products) == 0:
    print("No products found.")
    return

stock_list = []

for product in products:
    stock_list.append(product["stock"])

stock_array = np.array(stock_list)

average = np.mean(stock_array)

print("Average stock:", round(average, 2))
```

# ============================================================

# TOTAL INVENTORY VALUE

# ============================================================

def inventory_value():

```
print("\n----------- INVENTORY VALUE -----------")

total = 0

for product in products:

    value = product["price"] * product["stock"]

    total = total + value

print("Total inventory value: ₹", total)
```

# ============================================================

# CATEGORY SUMMARY

# ============================================================

def category_summary():

```
print("\n----------- CATEGORY SUMMARY -----------")

summary = {}

# Start every category at zero
for category in categories:
    summary[category] = 0

# Count products
for product in products:

    category = product["category"]

    summary[category] = summary[category] + 1

for category, count in summary.items():

    print(category, ":", count)
```

# ============================================================

# DELETE PRODUCT

# ============================================================

def delete_product():

```
print("\n----------- DELETE PRODUCT -----------")

try:

    product_id = int(input("Enter product ID: "))

    product = find_product(product_id)

    if product is None:
        print("Product not found.")
        return

    print("Product:", product["name"])

    confirm = input(
        "Delete this product? (y/n): "
    ).strip().lower()

    if confirm == "y":

        products.remove(product)

        print("Product deleted.")

    else:

        print("Delete cancelled.")

except ValueError:

    print("Enter a valid product ID.")
```

