# ============================================================
# JOB APPLICATION TRACKER REST API
# Simple Flask project using Python basics
# ============================================================

from flask import Flask, request, jsonify
from datetime import datetime


app = Flask(__name__)


# Available application statuses
statuses = (
    "Applied",
    "Interview",
    "Offer",
    "Rejected",
    "Withdrawn"
)


# Job application details
applications = [
    {
        "id": 101,
        "company": "ABC Technologies",
        "role": "Python Developer",
        "location": "Chennai",
        "status": "Applied",
        "applied_date": "2026-10-01"
    },
    {
        "id": 102,
        "company": "Tech Solutions",
        "role": "Application Support Engineer",
        "location": "Bangalore",
        "status": "Interview",
        "applied_date": "2026-10-03"
    },
    {
        "id": 103,
        "company": "Code Systems",
        "role": "Junior Python Developer",
        "location": "Hyderabad",
        "status": "Rejected",
        "applied_date": "2026-10-05"
    }
]


# ============================================================
# FIND APPLICATION
# ============================================================

def find_application(application_id):

    # Search the list using application ID
    for application in applications:

        if application["id"] == application_id:
            return application

    return None


# ============================================================
# CHECK DATE FORMAT
# ============================================================

def valid_date(date_text):

    if not isinstance(date_text, str):
        return False

    try:
        datetime.strptime(date_text, "%Y-%m-%d")
        return True

    except ValueError:
        return False


# ============================================================
# GET ALL APPLICATIONS
# ============================================================

@app.route("/api/applications", methods=["GET"])
def get_applications():

    return jsonify({
        "total": len(applications),
        "applications": applications
    })


# ============================================================
# GET ONE APPLICATION
# ============================================================

@app.route("/api/applications/<int:application_id>", methods=["GET"])
def get_application(application_id):

    application = find_application(application_id)

    if application is None:

        return jsonify({
            "message": "Application not found"
        }), 404

    return jsonify(application)


# ============================================================
# ADD NEW APPLICATION
# ============================================================

@app.route("/api/applications", methods=["POST"])
def add_application():

    data = request.get_json(silent=True)

    if not isinstance(data, dict):

        return jsonify({
            "message": "A valid JSON object is required"
        }), 400

    # Required fields
    required_fields = (
        "id",
        "company",
        "role",
        "location",
        "applied_date"
    )

    for field in required_fields:

        if field not in data:

            return jsonify({
                "message": field + " is required"
            }), 400

    # Validate application ID
    if type(data["id"]) is not int or data["id"] <= 0:

        return jsonify({
            "message": "ID must be a positive integer"
        }), 400

    if find_application(data["id"]) is not None:

        return jsonify({
            "message": "Application ID already exists"
        }), 409

    # Validate company
    if not isinstance(data["company"], str) or not data["company"].strip():

        return jsonify({
            "message": "Company name cannot be empty"
        }), 400

    # Validate role
    if not isinstance(data["role"], str) or not data["role"].strip():

        return jsonify({
            "message": "Job role cannot be empty"
        }), 400

    # Validate location
    if not isinstance(data["location"], str) or not data["location"].strip():

        return jsonify({
            "message": "Location cannot be empty"
        }), 400

    # Validate application date
    if not valid_date(data["applied_date"]):

        return jsonify({
            "message": "Date must use YYYY-MM-DD format"
        }), 400

    # A new application starts with Applied status
    application = {
        "id": data["id"],
        "company": data["company"].strip(),
        "role": data["role"].strip(),
        "location": data["location"].strip(),
        "status": "Applied",
        "applied_date": data["applied_date"]
    }

    applications.append(application)

    return jsonify({
        "message": "Application added successfully",
        "application": application
    }), 201


# ============================================================
# UPDATE APPLICATION
# ============================================================

@app.route("/api/applications/<int:application_id>", methods=["PUT"])
def update_application(application_id):

    application = find_application(application_id)

    if application is None:

        return jsonify({
            "message": "Application not found"
        }), 404

    data = request.get_json(silent=True)

    if not isinstance(data, dict) or not data:

        return jsonify({
            "message": "A non-empty JSON object is required"
        }), 400

    # Only these fields can be updated
    allowed_fields = (
        "company",
        "role",
        "location",
        "status",
        "applied_date"
    )

    for field in data:

        if field not in allowed_fields:

            return jsonify({
                "message": "Invalid field: " + field
            }), 400

    # Validate company
    if "company" in data:

        if not isinstance(data["company"], str) or not data["company"].strip():

            return jsonify({
                "message": "Company name cannot be empty"
            }), 400

    # Validate role
    if "role" in data:

        if not isinstance(data["role"], str) or not data["role"].strip():

            return jsonify({
                "message": "Job role cannot be empty"
            }), 400

    # Validate location
    if "location" in data:

        if not isinstance(data["location"], str) or not data["location"].strip():

            return jsonify({
                "message": "Location cannot be empty"
            }), 400

    # Validate status
    if "status" in data:

        if data["status"] not in statuses:

            return jsonify({
                "message": "Invalid status",
                "available_statuses": statuses
            }), 400

    # Validate date
    if "applied_date" in data:

        if not valid_date(data["applied_date"]):

            return jsonify({
                "message": "Date must use YYYY-MM-DD format"
            }), 400

    # Update only the supplied fields
    if "company" in data:
        application["company"] = data["company"].strip()

    if "role" in data:
        application["role"] = data["role"].strip()

    if "location" in data:
        application["location"] = data["location"].strip()

    if "status" in data:
        application["status"] = data["status"]

    if "applied_date" in data:
        application["applied_date"] = data["applied_date"]

    return jsonify({
        "message": "Application updated successfully",
        "application": application
    })


# ============================================================
# DELETE APPLICATION
# ============================================================

@app.route("/api/applications/<int:application_id>", methods=["DELETE"])
def delete_application(application_id):

    application = find_application(application_id)

    if application is None:

        return jsonify({
            "message": "Application not found"
        }), 404

    applications.remove(application)

    return jsonify({
        "message": "Application deleted successfully",
        "application": application
    })


# ============================================================
# FILTER APPLICATIONS BY STATUS
# ============================================================

@app.route("/api/applications/status/<status>", methods=["GET"])
def applications_by_status(status):

    result = []

    for application in applications:

        if application["status"].lower() == status.lower():

            result.append(application)

    return jsonify({
        "status": status,
        "total": len(result),
        "applications": result
    })


# ============================================================
# SEARCH APPLICATIONS BY COMPANY
# ============================================================

@app.route("/api/applications/company/<company>", methods=["GET"])
def applications_by_company(company):

    result = []

    for application in applications:

        if company.lower() in application["company"].lower():

            result.append(application)

    return jsonify({
        "company_search": company,
        "total": len(result),
        "applications": result
    })


# ============================================================
# SEARCH APPLICATIONS BY ROLE
# ============================================================

@app.route("/api/applications/role/<role>", methods=["GET"])
def applications_by_role(role):

    result = []

    for application in applications:

        if role.lower() in application["role"].lower():

            result.append(application)

    return jsonify({
        "role_search": role,
        "total": len(result),
        "applications": result
    })


# ============================================================
# APPLICATION SUMMARY
# ============================================================

@app.route("/api/applications/summary", methods=["GET"])
def application_summary():

    summary = {}

    # Start every status count at zero
    for status in statuses:
        summary[status] = 0

    # Count applications by status
    for application in applications:

        status = application["status"]

        summary[status] = summary[status] + 1

    return jsonify({
        "total_applications": len(applications),
        "status_summary": summary
    })


# ============================================================
# HOME ROUTE
