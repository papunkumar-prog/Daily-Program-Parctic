        "author": "Rahul",
        "isbn": "ISBN1001",
        "total_copies": 5,
        "available_copies": 5
    },
    {
        "id": 202,
        "title": "Learn Flask",
        "author": "Amit",
        "isbn": "ISBN1002",
        "total_copies": 3,
        "available_copies": 3
    },
    {
        "id": 203,
        "title": "SQL for Beginners",
        "author": "Priya",
        "isbn": "ISBN1003",
        "total_copies": 4,
        "available_copies": 4
    }
]


# Store issued and returned book records
loans = []


# Fine charged for each overdue day
FINE_PER_DAY = 10


# --------------------------------------------------
# HELPER FUNCTION: FIND BOOK
# Flow: Receive book ID -> Search book list -> Return book
# --------------------------------------------------
def find_book(book_id):

    for book in books:

        if book["id"] == book_id:
            return book

    return None


# --------------------------------------------------
# HELPER FUNCTION: FIND LOAN
# Flow: Receive loan ID -> Search loan list -> Return loan
# --------------------------------------------------
def find_loan(loan_id):

    for loan in loans:

        if loan["id"] == loan_id:
            return loan

    return None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE BOOK DATA
# Flow: Receive JSON -> Check fields -> Validate values
#       -> Return cleaned book information
# --------------------------------------------------
def validate_book(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "title",
        "author",
        "isbn",
        "total_copies"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    title = data["title"]
    author = data["author"]
    isbn = data["isbn"]
    total_copies = data["total_copies"]

    if not all(
        isinstance(value, str)
        for value in [title, author, isbn]
    ):
        return None, "Title, author and ISBN must be text"

    title = title.strip()
    author = author.strip()
    isbn = isbn.strip().upper()

    if not all([title, author, isbn]):
        return None, "Book details cannot be empty"

    if isinstance(total_copies, bool) or not isinstance(total_copies, int):
        return None, "Total copies must be a whole number"

    if total_copies <= 0:
        return None, "Total copies must be greater than zero"

    return {
        "title": title,
        "author": author,
        "isbn": isbn,
        "total_copies": total_copies
    }, None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE LOAN DATA
# Flow: Read JSON -> Validate member and book IDs
#       -> Validate loan days -> Return loan details
# --------------------------------------------------
def validate_loan(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "book_id",
        "member_id",
        "member_name"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    book_id = data["book_id"]
    member_id = data["member_id"]
    member_name = data["member_name"]
    loan_days = data.get("loan_days", 14)

    if isinstance(book_id, bool) or not isinstance(book_id, int):
        return None, "Book ID must be an integer"

    if book_id <= 0:
        return None, "Book ID must be greater than zero"

    if isinstance(member_id, bool) or not isinstance(member_id, int):
        return None, "Member ID must be an integer"

    if member_id <= 0:
        return None, "Member ID must be greater than zero"

    if not isinstance(member_name, str):
        return None, "Member name must be text"

    member_name = member_name.strip()

    if not member_name:
        return None, "Member name cannot be empty"

    if isinstance(loan_days, bool) or not isinstance(loan_days, int):
        return None, "Loan days must be a whole number"

    if loan_days < 1 or loan_days > 60:
        return None, "Loan period must be between 1 and 60 days"

    return {
        "book_id": book_id,
        "member_id": member_id,
        "member_name": member_name,
        "loan_days": loan_days
    }, None


