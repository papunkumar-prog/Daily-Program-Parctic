# --------------------------------------------------
# 10. RETURN A BOOK
# Flow: Read loan ID -> Find loan -> Check status
#       -> Calculate late days and fine
#       -> Update loan -> Increase available copies
# --------------------------------------------------
@app.route("/api/loans/<int:loan_id>/return", methods=["POST"])
def return_book(loan_id):

    loan = find_loan(loan_id)

    if loan is None:
        return jsonify({
            "error": "Loan record not found"
        }), 404

    if loan["status"] == "Returned":
        return jsonify({
            "error": "This book has already been returned"
        }), 409

    return_date = date.today()
    due_date = date.fromisoformat(loan["due_date"])

    # Calculate overdue days
    late_days = max(0, (return_date - due_date).days)

    # Calculate late return fine
    fine_amount = late_days * FINE_PER_DAY

    loan["return_date"] = return_date.isoformat()
    loan["status"] = "Returned"
    loan["late_days"] = late_days
    loan["fine_amount"] = fine_amount

    # Increase available copies after return
    book = find_book(loan["book_id"])

    if book is not None:
        book["available_copies"] += 1

    return jsonify({
        "message": "Book returned successfully",
        "loan": loan,
        "late_days": late_days,
        "fine_amount": fine_amount
    }), 200


# --------------------------------------------------
# 11. FIND OVERDUE BOOKS
# Flow: Check issued loans -> Compare due dates
#       -> Calculate overdue days -> Return results
# --------------------------------------------------
@app.route("/api/loans/overdue", methods=["GET"])
def overdue_loans():

    today = date.today()
    overdue = []

    for loan in loans:

        due_date = date.fromisoformat(loan["due_date"])

        if (
            loan["status"] == "Issued"
            and due_date < today
        ):
            record = loan.copy()
            record["days_overdue"] = (today - due_date).days
            record["current_fine"] = (
                record["days_overdue"] * FINE_PER_DAY
            )

            overdue.append(record)

    return jsonify({
        "overdue_count": len(overdue),
        "loans": overdue
    }), 200


# --------------------------------------------------
# 12. LIBRARY SUMMARY
# Flow: Count books and loans -> Calculate fines
#       -> Return library statistics
# --------------------------------------------------
@app.route("/api/loans/summary", methods=["GET"])
def library_summary():

    issued_loans = 0
    returned_loans = 0
    total_fines = 0

    for loan in loans:

        if loan["status"] == "Issued":
            issued_loans += 1

        elif loan["status"] == "Returned":
            returned_loans += 1
            total_fines += loan["fine_amount"]

    total_copies = sum(
        book["total_copies"] for book in books
    )

    available_copies = sum(
        book["available_copies"] for book in books
    )

    return jsonify({
        "total_book_titles": len(books),
        "total_book_copies": total_copies,
        "available_copies": available_copies,
        "issued_loans": issued_loans,
        "returned_loans": returned_loans,
        "total_loans": len(loans),
        "total_fines_collected": total_fines
    }), 200


