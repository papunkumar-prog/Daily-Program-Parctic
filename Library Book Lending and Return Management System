# --------------------------------------------------
# 2. GET ALL BOOKS
# Flow: Read book records -> Return JSON response
# --------------------------------------------------
@app.route("/api/books", methods=["GET"])
def get_books():

    search = request.args.get("search", "").strip().lower()

    filtered_books = []

    for book in books:

        if (
            not search
            or search in book["title"].lower()
            or search in book["author"].lower()
        ):
            filtered_books.append(book)

    return jsonify({
        "total_books": len(filtered_books),
        "books": filtered_books
    }), 200


# --------------------------------------------------
# 3. GET ONE BOOK
# Flow: Read book ID -> Search -> Return book details
# --------------------------------------------------
@app.route("/api/books/<int:book_id>", methods=["GET"])
def get_book(book_id):

    book = find_book(book_id)

    if book is None:
        return jsonify({
            "error": "Book not found"
        }), 404

    return jsonify(book), 200


# --------------------------------------------------
# 4. ADD A NEW BOOK
# Flow: Read JSON -> Validate -> Check duplicate ISBN
#       -> Generate ID -> Add book -> Return response
# --------------------------------------------------
@app.route("/api/books", methods=["POST"])
def add_book():

    data = request.get_json(silent=True)

    book_data, error = validate_book(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    # Check whether ISBN already exists
    for book in books:

        if book["isbn"] == book_data["isbn"]:
            return jsonify({
                "error": "ISBN already exists"
            }), 409

    # Generate next available book ID
    if books:
        new_id = max(book["id"] for book in books) + 1
    else:
        new_id = 201

    new_book = {
        "id": new_id,
        **book_data,
        "available_copies": book_data["total_copies"]
    }

    books.append(new_book)

    return jsonify({
        "message": "Book added successfully",
        "book": new_book
    }), 201


# --------------------------------------------------
# 5. UPDATE BOOK DETAILS
# Flow: Read ID -> Validate -> Find book
#       -> Check ISBN -> Preserve issued copies -> Update
# --------------------------------------------------
@app.route("/api/books/<int:book_id>", methods=["PUT"])
def update_book(book_id):

    data = request.get_json(silent=True)

    book_data, error = validate_book(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    book = find_book(book_id)

    if book is None:
        return jsonify({
            "error": "Book not found"
        }), 404

    # Check duplicate ISBN in other books
    for existing_book in books:

        if (
            existing_book["isbn"] == book_data["isbn"]
            and existing_book["id"] != book_id
        ):
            return jsonify({
                "error": "ISBN already belongs to another book"
            }), 409

    # Calculate how many copies are currently issued
    issued_copies = book["total_copies"] - book["available_copies"]

    if book_data["total_copies"] < issued_copies:
        return jsonify({
            "error": "Total copies cannot be less than issued copies"
        }), 400

    book.update(book_data)

    # Preserve the number of issued copies
    book["available_copies"] = (
        book_data["total_copies"] - issued_copies
    )

    return jsonify({
        "message": "Book updated successfully",
        "book": book
    }), 200


# --------------------------------------------------
# 6. DELETE A BOOK
# Flow: Read ID -> Find book -> Check issued copies
#       -> Delete book -> Return response
# --------------------------------------------------
@app.route("/api/books/<int:book_id>", methods=["DELETE"])
def delete_book(book_id):

    book = find_book(book_id)

    if book is None:
        return jsonify({
            "error": "Book not found"
        }), 404

    # Prevent deletion when copies are issued
    if book["available_copies"] != book["total_copies"]:
        return jsonify({
            "error": "Cannot delete a book with issued copies"
        }), 409

    books.remove(book)

    return jsonify({
        "message": "Book deleted successfully"
    }), 200


# --------------------------------------------------
# 7. ISSUE A BOOK
# Flow: Read JSON -> Validate -> Find book
#       -> Check availability -> Calculate due date
#       -> Create loan -> Reduce available copies
# --------------------------------------------------
@app.route("/api/loans", methods=["POST"])
def issue_book():

    data = request.get_json(silent=True)

    loan_data, error = validate_loan(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    book = find_book(loan_data["book_id"])

    if book is None:
        return jsonify({
            "error": "Book not found"
        }), 404

    if book["available_copies"] <= 0:
        return jsonify({
            "error": "No copies available for issuing"
        }), 409

    # Prevent issuing the same book twice to one
    # member while the earlier loan is still active
    for loan in loans:

        if (
            loan["book_id"] == loan_data["book_id"]
            and loan["member_id"] == loan_data["member_id"]
            and loan["status"] == "Issued"
        ):
            return jsonify({
                "error": "This member already has this book"
            }), 409

    # Calculate issue date and due date
    issue_date = date.today()
    due_date = issue_date + timedelta(
        days=loan_data["loan_days"]
    )

    # Generate next available loan ID
    if loans:
        new_id = max(loan["id"] for loan in loans) + 1
    else:
        new_id = 501

    new_loan = {
        "id": new_id,
        "book_id": book["id"],
        "book_title": book["title"],
        "member_id": loan_data["member_id"],
        "member_name": loan_data["member_name"],
        "issue_date": issue_date.isoformat(),
        "due_date": due_date.isoformat(),
        "return_date": None,
        "status": "Issued",
        "late_days": 0,
        "fine_amount": 0
    }

    loans.append(new_loan)

    # Reduce available copies after issuing
    book["available_copies"] -= 1

    return jsonify({
        "message": "Book issued successfully",
        "loan": new_loan
    }), 201


# --------------------------------------------------
# 8. GET ALL LOANS
# Flow: Read filter -> Filter loan records -> Respond
# --------------------------------------------------
@app.route("/api/loans", methods=["GET"])
def get_loans():

    filtered_loans = loans

    status = request.args.get("status")

    if status:

        status = status.strip().title()

        if status not in ["Issued", "Returned"]:
            return jsonify({
                "error": "Status must be Issued or Returned"
            }), 400

        filtered_loans = [
            loan for loan in filtered_loans
            if loan["status"] == status
        ]

    member_id = request.args.get("member_id")

    if member_id is not None:

        try:
            member_id = int(member_id)
        except ValueError:
            return jsonify({
                "error": "Member ID must be an integer"
            }), 400

        if member_id <= 0:
            return jsonify({
                "error": "Member ID must be greater than zero"
            }), 400

        filtered_loans = [
            loan for loan in filtered_loans
            if loan["member_id"] == member_id
        ]

    return jsonify({
        "total_loans": len(filtered_loans),
        "loans": filtered_loans
    }), 200


