return jsonify(result)
```

# ============================================================

# GET HIGH RATED MOVIES

# ============================================================

@app.route("/api/movies/top-rated", methods=["GET"])
def top_rated():

```
result = []

for movie in movies:

    if movie["rating"] >= 4.5:

        result.append(movie)

return jsonify({
    "total": len(result),
    "movies": result
})
```

# ============================================================

# GET HIGHEST RATED MOVIE

# ============================================================

@app.route("/api/movies/highest-rated", methods=["GET"])
def highest_rated():

```
if len(movies) == 0:

    return jsonify({
        "message": "No movies available"
    }), 404

ratings = []

for movie in movies:

    ratings.append(movie["rating"])

rating_array = np.array(ratings)

highest = np.max(rating_array)

result = []

for movie in movies:

    if movie["rating"] == highest:

        result.append(movie)

return jsonify({
    "highest_rating": float(highest),
    "movies": result
})
```

# ============================================================

# AVERAGE RATING

# ============================================================

@app.route("/api/movies/average-rating", methods=["GET"])
def average_rating():

```
if len(movies) == 0:

    return jsonify({
        "message": "No movies available"
    }), 404

ratings = []

for movie in movies:

    ratings.append(movie["rating"])

rating_array = np.array(ratings)

average = np.mean(rating_array)

return jsonify({
    "average_rating": round(float(average), 2)
})
```

# ============================================================

# MOVIE SUMMARY

# ============================================================

@app.route("/api/movies/summary", methods=["GET"])
def movie_summary():

```
summary = {}

# Start each genre with zero
for genre in genres:

    summary[genre] = 0

# Count movies by genre
for movie in movies:

    genre = movie["genre"]

    summary[genre] = summary[genre] + 1

return jsonify({
    "total_movies": len(movies),
    "genre_summary": summary
})
```

