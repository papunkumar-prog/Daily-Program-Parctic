# ============================================================

# 7. SALES ANALYSIS USING NUMPY

# ============================================================

def sales_analysis():

```
print("\n========== 📊 SALES ANALYSIS ==========")

if len(bookings) == 0:

    print("No sales data available.")
    return

# Take ticket totals from every booking
sales = np.array(
    [booking["total"] for booking in bookings]
)

tickets = np.array(
    [booking["tickets"] for booking in bookings]
)

print("Total Revenue:", np.sum(sales))

print("Average Booking Amount:", np.mean(sales))

print("Highest Booking:", np.max(sales))

print("Lowest Booking:", np.min(sales))

print("Total Tickets Sold:", np.sum(tickets))
```

# ============================================================

# 8. MOVIE-WISE SALES

# ============================================================

def movie_sales():

```
print("\n========== 🎬 MOVIE-WISE SALES ==========")

for movie in movies:

    total_tickets = 0
    total_revenue = 0

    for booking in bookings:

        if booking["movie"] == movie["name"]:

            total_tickets += booking["tickets"]
            total_revenue += booking["total"]

    print("\nMovie:", movie["name"])
    print("Tickets Sold:", total_tickets)
    print("Revenue: ₹", total_revenue)
```

# ============================================================

# 9. LANGUAGE ANALYSIS

# ============================================================

def language_analysis():

```
print("\n========== 🌐 LANGUAGE ANALYSIS ==========")

for language in languages:

    count = 0

    for movie in movies:

        if movie["language"] == language:

            count += 1

    print(language, ":", count, "movie(s)")
```

