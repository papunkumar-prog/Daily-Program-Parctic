# ============================================================

# 2. ADD NEW MOVIE

# ============================================================

def add_movie():

```
print("\n========== ➕ ADD MOVIE ==========")

try:

    movie_id = int(input("Enter Movie ID: "))

    name = input("Enter Movie Name: ").strip().title()

    print("\nAvailable Languages:")

    for language in languages:
        print("-", language)

    language = input("Enter Language: ").strip().title()

    if language not in languages:

        print("❌ Invalid language.")
        return

    price = float(input("Enter Ticket Price: "))

    seats = int(input("Enter Number of Seats: "))

    if price <= 0:

        print("❌ Price must be greater than 0.")
        return

    if seats <= 0:

        print("❌ Seats must be greater than 0.")
        return

    # Check duplicate ID
    for movie in movies:

        if movie["id"] == movie_id:

            print("❌ Movie ID already exists.")
            return

    new_movie = {
        "id": movie_id,
        "name": name,
        "language": language,
        "price": price,
        "available_seats": seats
    }

    movies.append(new_movie)

    print("✅ Movie added successfully.")

except ValueError:

    print("❌ Please enter valid values.")
```

# ============================================================

# 3. SEARCH MOVIE

# ============================================================

def search_movie():

```
print("\n========== 🔍 SEARCH MOVIE ==========")

search = input("Enter movie name: ").strip().lower()

found = False

for movie in movies:

    if search in movie["name"].lower():

        print("\nMovie Found")
        print("ID:", movie["id"])
        print("Name:", movie["name"])
        print("Language:", movie["language"])
        print("Price:", movie["price"])
        print("Available Seats:", movie["available_seats"])

        found = True

if not found:

    print("❌ Movie not found.")
```

# ============================================================

# 4. BOOK TICKETS

# ============================================================

def book_ticket():

```
print("\n========== 🎟️ BOOK TICKETS ==========")

try:

    movie_id = int(input("Enter Movie ID: "))

    customer = input("Enter Customer Name: ").strip().title()

    quantity = int(input("Enter Number of Tickets: "))

    if quantity <= 0:

        print("❌ Number of tickets must be greater than 0.")
        return

    for movie in movies:

        if movie["id"] == movie_id:

            if movie["available_seats"] >= quantity:

                total = movie["price"] * quantity

                movie["available_seats"] -= quantity

                booking = {
                    "customer": customer,
                    "movie": movie["name"],
                    "tickets": quantity,
                    "price": movie["price"],
                    "total": total
                }

                bookings.append(booking)

                print("\n✅ Booking successful!")
                print("Customer:", customer)
                print("Movie:", movie["name"])
                print("Tickets:", quantity)
                print("Total Amount: ₹", total)

                return

            else:

                print("❌ Not enough seats available.")
                return

    print("❌ Movie ID not found.")

except ValueError:

    print("❌ Please enter valid numbers.")
```

# ============================================================

# 5. CANCEL BOOKING

# ============================================================

def cancel_booking():

```
print("\n========== ❌ CANCEL BOOKING ==========")

if len(bookings) == 0:

    print("No bookings available.")
    return

customer = input("Enter Customer Name: ").strip().title()

found = False

for booking in bookings:

    if booking["customer"] == customer:

        # Return seats to movie
        for movie in movies:

            if movie["name"] == booking["movie"]:

                movie["available_seats"] += booking["tickets"]

        bookings.remove(booking)

        print("✅ Booking cancelled successfully.")

        found = True

        return

if not found:

    print("❌ Booking not found.")
```

