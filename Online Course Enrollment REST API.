@app.route("/api/courses/<int:course_id>", methods=["GET"])
def get_course(course_id):

    course = find_course(course_id)

    if course is None:

        return jsonify({
            "message": "Course not found"
        }), 404

    return jsonify(course_details(course))


# ============================================================
# ADD NEW COURSE
# ============================================================

@app.route("/api/courses", methods=["POST"])
def add_course():

    data = request.get_json(silent=True)

    if not isinstance(data, dict):

        return jsonify({
            "message": "A valid JSON object is required"
        }), 400

    # Check required fields
    required_fields = (
        "id",
        "title",
        "category",
        "fee",
        "capacity"
    )

    for field in required_fields:

        if field not in data:

            return jsonify({
                "message": field + " is required"
            }), 400

    # Validate course ID
    if type(data["id"]) is not int or data["id"] <= 0:

        return jsonify({
            "message": "ID must be a positive integer"
        }), 400

    if find_course(data["id"]) is not None:

        return jsonify({
            "message": "Course ID already exists"
        }), 409

    # Validate title
    if not isinstance(data["title"], str) or not data["title"].strip():

        return jsonify({
            "message": "Course title cannot be empty"
        }), 400

    # Validate category
    if data["category"] not in categories:

        return jsonify({
            "message": "Invalid category",
            "available_categories": categories
        }), 400

    # Validate course fee
    fee = data["fee"]

    if (
        isinstance(fee, bool)
        or not isinstance(fee, (int, float))
        or fee <= 0
    ):

        return jsonify({
            "message": "Fee must be a positive number"
        }), 400

    # Validate seat capacity
    capacity = data["capacity"]

    if type(capacity) is not int or capacity <= 0:

        return jsonify({
            "message": "Capacity must be a positive integer"
        }), 400

    # Create the course
    course = {
        "id": data["id"],
        "title": data["title"].strip(),
        "category": data["category"],
        "fee": fee,
        "capacity": capacity,
        "status": "Open"
    }

    courses.append(course)

    return jsonify({
        "message": "Course added successfully",
        "course": course_details(course)
    }), 201


# ============================================================
# UPDATE COURSE DETAILS
# ============================================================

@app.route("/api/courses/<int:course_id>", methods=["PUT"])
def update_course(course_id):

    course = find_course(course_id)

    if course is None:

        return jsonify({
            "message": "Course not found"
        }), 404

    data = request.get_json(silent=True)

    if not isinstance(data, dict) or not data:

        return jsonify({
            "message": "A non-empty JSON object is required"
        }), 400

    # Only these fields can be changed here
    allowed_fields = (
        "title",
        "category",
        "fee",
        "capacity"
    )

    for field in data:

        if field not in allowed_fields:

            return jsonify({
                "message": "Invalid field: " + field
            }), 400

    # Validate title
    if "title" in data:

        if not isinstance(data["title"], str) or not data["title"].strip():

            return jsonify({
                "message": "Title cannot be empty"
            }), 400

    # Validate category
    if "category" in data:

        if data["category"] not in categories:

            return jsonify({
                "message": "Invalid category",
                "available_categories": categories
            }), 400

    # Validate fee
    if "fee" in data:

        fee = data["fee"]

        if (
            isinstance(fee, bool)
            or not isinstance(fee, (int, float))
            or fee <= 0
        ):

            return jsonify({
                "message": "Fee must be a positive number"
            }), 400

    # Do not reduce capacity below active enrollment count
    if "capacity" in data:

        capacity = data["capacity"]

        if type(capacity) is not int or capacity <= 0:

            return jsonify({
                "message": "Capacity must be a positive integer"
            }), 400

        if capacity < count_enrollments(course_id):

            return jsonify({
                "message": "Capacity cannot be lower than active enrollments"
            }), 400

    # Apply changes after validation
    if "title" in data:
        course["title"] = data["title"].strip()

    if "category" in data:
        course["category"] = data["category"]

    if "fee" in data:
        course["fee"] = data["fee"]

    if "capacity" in data:
        course["capacity"] = data["capacity"]

    return jsonify({
        "message": "Course updated successfully",
        "course": course_details(course)
    })


# ============================================================
# CHANGE COURSE STATUS
# ============================================================

@app.route("/api/courses/<int:course_id>/status", methods=["PUT"])
def update_course_status(course_id):

    course = find_course(course_id)

    if course is None:

        return jsonify({
            "message": "Course not found"
        }), 404

    data = request.get_json(silent=True)

    if not isinstance(data, dict) or "status" not in data:

        return jsonify({
            "message": "Status is required"
        }), 400

    status = data["status"]

    if status not in course_statuses:

        return jsonify({
            "message": "Invalid status",
            "available_statuses": course_statuses
        }), 400

    course["status"] = status

    return jsonify({
        "message": "Course status updated successfully",
        "course": course_details(course)
    })


# ============================================================
# DELETE COURSE
# ============================================================

@app.route("/api/courses/<int:course_id>", methods=["DELETE"])
def delete_course(course_id):

    course = find_course(course_id)

    if course is None:

        return jsonify({
            "message": "Course not found"
        }), 404

    # Keep courses that have enrollment history
    for enrollment in enrollments:

        if enrollment["course_id"] == course_id:

            return jsonify({
                "message": "Cannot delete a course with enrollment records"
            }), 409

    courses.remove(course)

    return jsonify({
        "message": "Course deleted successfully"
    })


# ============================================================
# ENROLL STUDENT IN A COURSE
# ============================================================

@app.route("/api/courses/<int:course_id>/enroll", methods=["POST"])
def enroll_student(course_id):

    course = find_course(course_id)

    if course is None:

        return jsonify({
            "message": "Course not found"
        }), 404

    if course["status"] != "Open":

        return jsonify({
            "message": "This course is closed for enrollment"
        }), 400

    data = request.get_json(silent=True)

    if not isinstance(data, dict):

        return jsonify({
            "message": "A valid JSON object is required"
        }), 400

    # Check student details
    if "student_name" not in data:

        return jsonify({
            "message": "student_name is required"
        }), 400

    if "email" not in data:

        return jsonify({
            "message": "email is required"
        }), 400

    name = data["student_name"]
    email = data["email"]

    if not isinstance(name, str) or not name.strip():

        return jsonify({
            "message": "Student name cannot be empty"
        }), 400

    if not valid_email(email):

        return jsonify({
            "message": "Enter a valid email address"
        }), 400

    email = email.strip().lower()

    # Prevent the same student from enrolling twice
    # in the same course while the enrollment is active
    for enrollment in enrollments:

        if (
            enrollment["course_id"] == course_id
            and enrollment["email"].lower() == email
            and enrollment["status"] == "Active"
        ):

            return jsonify({
                "message": "Student is already enrolled in this course"
            }), 409

    # Check available seats
    enrolled = count_enrollments(course_id)

    if enrolled >= course["capacity"]:

        return jsonify({
            "message": "Course is full"
        }), 400

    # Create the enrollment
    enrollment = {
        "id": next_enrollment_id(),
        "course_id": course_id,
        "student_name": name.strip().title(),
        "email": email,
        "status": "Active"
    }

    enrollments.append(enrollment)

    return jsonify({
        "message": "Student enrolled successfully",
        "enrollment": enrollment,
        "course": course_details(course)
    }), 201


