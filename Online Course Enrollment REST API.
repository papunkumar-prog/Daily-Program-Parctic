# ============================================================
# FIND COURSE
# ============================================================

def find_course(course_id):

    # Search for a course using its ID
    for course in courses:

        if course["id"] == course_id:
            return course

    return None


# ============================================================
# FIND ENROLLMENT
# ============================================================

def find_enrollment(enrollment_id):

    for enrollment in enrollments:

        if enrollment["id"] == enrollment_id:
            return enrollment

    return None


# ============================================================
# COUNT ACTIVE ENROLLMENTS
# ============================================================

def count_enrollments(course_id):

    count = 0

    for enrollment in enrollments:

        if (
            enrollment["course_id"] == course_id
            and enrollment["status"] == "Active"
        ):
            count += 1

    return count


# ============================================================
# SHOW COURSE DETAILS
# ============================================================

def course_details(course):

    # Calculate current enrollment and available seats
    enrolled = count_enrollments(course["id"])

    available = course["capacity"] - enrolled

    return {
        "id": course["id"],
        "title": course["title"],
        "category": course["category"],
        "fee": course["fee"],
        "capacity": course["capacity"],
        "enrolled": enrolled,
        "available_seats": available,
        "status": course["status"]
    }


# ============================================================
# VALIDATE EMAIL
# ============================================================

def valid_email(email):

    if not isinstance(email, str):
        return False

    email = email.strip()

    if " " in email or "@" not in email:
        return False

    parts = email.split("@")

    if len(parts) != 2:
        return False

    if parts[0] == "" or "." not in parts[1]:
        return False

    return True


# ============================================================
# GENERATE ENROLLMENT ID
# ============================================================

def next_enrollment_id():

    highest_id = 200

    for enrollment in enrollments:

        if enrollment["id"] > highest_id:
            highest_id = enrollment["id"]

    return highest_id + 1


