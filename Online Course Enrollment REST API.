# ============================================================
# GET OPEN COURSES
# ============================================================

@app.route("/api/courses/open", methods=["GET"])
def open_courses():

    result = []

    for course in courses:

        if (
            course["status"] == "Open"
            and count_enrollments(course["id"]) < course["capacity"]
        ):

            result.append(course_details(course))

    return jsonify({
        "total_open_courses": len(result),
        "courses": result
    })


# ============================================================
# COURSE SUMMARY
# ============================================================

@app.route("/api/courses/summary", methods=["GET"])
def course_summary():

    category_count = {}

    total_active = 0
    total_seats = 0
    total_available = 0

    # Start every category at zero
    for category in categories:
        category_count[category] = 0

    # Count courses and seats
    for course in courses:

        category = course["category"]

        category_count[category] += 1

        enrolled = count_enrollments(course["id"])

        total_active += enrolled
        total_seats += course["capacity"]
        total_available += course["capacity"] - enrolled

    return jsonify({
        "total_courses": len(courses),
        "total_active_enrollments": total_active,
        "total_seats": total_seats,
        "available_seats": total_available,
        "category_summary": category_count
    })


