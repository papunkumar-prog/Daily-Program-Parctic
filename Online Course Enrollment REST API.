# ============================================================
# UPDATE STUDENT DETAILS
# ============================================================

@app.route("/api/enrollments/<int:enrollment_id>", methods=["PUT"])
def update_enrollment(enrollment_id):

    enrollment = find_enrollment(enrollment_id)

    if enrollment is None:

        return jsonify({
            "message": "Enrollment not found"
        }), 404

    if enrollment["status"] != "Active":

        return jsonify({
            "message": "Only active enrollments can be updated"
        }), 400

    data = request.get_json(silent=True)

    if not isinstance(data, dict) or not data:

        return jsonify({
            "message": "A non-empty JSON object is required"
        }), 400

    for field in data:

        if field not in ("student_name", "email"):

            return jsonify({
                "message": "Invalid field: " + field
            }), 400

    if "student_name" in data:

        name = data["student_name"]

        if not isinstance(name, str) or not name.strip():

            return jsonify({
                "message": "Student name cannot be empty"
            }), 400

    if "email" in data:

        email = data["email"]

        if not valid_email(email):

            return jsonify({
                "message": "Enter a valid email address"
            }), 400

        email = email.strip().lower()

        # Check for duplicate active enrollment
        for other in enrollments:

            if other["id"] == enrollment_id:
                continue

            if (
                other["course_id"] == enrollment["course_id"]
                and other["email"].lower() == email
                and other["status"] == "Active"
            ):

                return jsonify({
                    "message": "This email is already enrolled in the course"
                }), 409

    # Save changes
    if "student_name" in data:
        enrollment["student_name"] = data["student_name"].strip().title()

    if "email" in data:
        enrollment["email"] = data["email"].strip().lower()

    return jsonify({
        "message": "Enrollment updated successfully",
        "enrollment": enrollment
    })


# ============================================================
# CANCEL ENROLLMENT
# ============================================================

@app.route("/api/enrollments/<int:enrollment_id>", methods=["DELETE"])
def cancel_enrollment(enrollment_id):

    enrollment = find_enrollment(enrollment_id)

    if enrollment is None:

        return jsonify({
            "message": "Enrollment not found"
        }), 404

    if enrollment["status"] == "Cancelled":

        return jsonify({
            "message": "Enrollment is already cancelled"
        }), 400

    # Mark it cancelled instead of deleting its history
    enrollment["status"] = "Cancelled"

    course = find_course(enrollment["course_id"])

    return jsonify({
        "message": "Enrollment cancelled successfully",
        "enrollment": enrollment,
        "course": course_details(course) if course else None
    })


