# --------------------------------------------------
# HELPER FUNCTION: FIND COURSE
# Flow: Receive course ID -> Search course list
#       -> Return matching course
# --------------------------------------------------
def find_course(course_id):

    for course in courses:

        if course["id"] == course_id:
            return course

    return None


# --------------------------------------------------
# HELPER FUNCTION: FIND ENROLLMENT
# Flow: Receive enrollment ID -> Search records
#       -> Return matching enrollment
# --------------------------------------------------
def find_enrollment(enrollment_id):

    for enrollment in enrollments:

        if enrollment["id"] == enrollment_id:
            return enrollment

    return None


# --------------------------------------------------
# HELPER FUNCTION: COUNT ACTIVE ENROLLMENTS
# Flow: Read course ID -> Count non-cancelled enrollments
#       -> Return current seat usage
# --------------------------------------------------
def count_enrolled_students(course_id):

    count = 0

    for enrollment in enrollments:

        if (
            enrollment["course_id"] == course_id
            and enrollment["status"] != "Cancelled"
        ):
            count += 1

    return count


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE COURSE DATA
# Flow: Read JSON -> Check fields -> Validate values
#       -> Validate lessons -> Return course data
# --------------------------------------------------
def validate_course(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "title",
        "instructor",
        "category",
        "course_fee",
        "capacity",
        "lessons"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    title = data["title"]
    instructor = data["instructor"]
    category = data["category"]
    course_fee = data["course_fee"]
    capacity = data["capacity"]
    lesson_titles = data["lessons"]

    # Validate text fields
    if not all(
        isinstance(value, str)
        for value in [title, instructor, category]
    ):
        return None, "Course details must contain text"

    title = title.strip()
    instructor = instructor.strip()
    category = category.strip().title()

    if not all([title, instructor, category]):
        return None, "Course details cannot be empty"

    # Validate course fee
    if isinstance(course_fee, bool) or not isinstance(course_fee, (int, float)):
        return None, "Course fee must be a number"

    if not math.isfinite(course_fee) or course_fee < 0:
        return None, "Course fee must be non-negative and finite"

    # Validate capacity
    if isinstance(capacity, bool) or not isinstance(capacity, int):
        return None, "Capacity must be a whole number"

    if capacity <= 0:
        return None, "Capacity must be greater than zero"

    # Validate lesson list
    if not isinstance(lesson_titles, list) or not lesson_titles:
        return None, "At least one lesson is required"

    lessons = []
    lesson_names = set()

    for index, lesson_title in enumerate(lesson_titles, start=1):

        if not isinstance(lesson_title, str):
            return None, "Every lesson title must be text"

        lesson_title = lesson_title.strip()

        if not lesson_title:
            return None, "Lesson title cannot be empty"

        if lesson_title.lower() in lesson_names:
            return None, "Duplicate lesson titles are not allowed"

        lesson_names.add(lesson_title.lower())

        lessons.append({
            "id": index,
            "title": lesson_title
        })

    course_data = {
        "title": title,
        "instructor": instructor,
        "category": category,
        "course_fee": course_fee,
        "capacity": capacity,
        "lessons": lessons
    }

    return course_data, None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE ENROLLMENT DATA
# Flow: Read JSON -> Validate student details
#       -> Check course -> Return enrollment data
# --------------------------------------------------
def validate_enrollment(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "course_id",
        "student_name",
        "email"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    course_id = data["course_id"]
    student_name = data["student_name"]
    email = data["email"]

    # Validate course ID
    if isinstance(course_id, bool) or not isinstance(course_id, int):
        return None, "Course ID must be an integer"

    if course_id <= 0:
        return None, "Course ID must be greater than zero"

    # Validate student name
    if not isinstance(student_name, str):
        return None, "Student name must be text"

    student_name = student_name.strip()

    if not student_name:
        return None, "Student name cannot be empty"

    # Validate email
    if not isinstance(email, str):
        return None, "Email must be text"

    email = email.strip().lower()

    if "@" not in email or "." not in email.split("@")[-1]:
        return None, "Enter a valid email address"

    # Check course existence
    course = find_course(course_id)

    if course is None:
        return None, "Course not found"

    enrollment_data = {
        "course_id": course_id,
        "student_name": student_name,
        "email": email
    }

    return enrollment_data, None


