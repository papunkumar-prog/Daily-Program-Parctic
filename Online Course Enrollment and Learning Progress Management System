# --------------------------------------------------
# 7. ENROLL A STUDENT
# Flow: Read JSON -> Validate -> Check duplicate
#       -> Check seats -> Generate ID
#       -> Save enrollment -> Return response
# --------------------------------------------------
@app.route("/api/enrollments", methods=["POST"])
def enroll_student():

    data = request.get_json(silent=True)

    enrollment_data, error = validate_enrollment(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    course = find_course(enrollment_data["course_id"])

    # Prevent duplicate active or completed enrollment
    for enrollment in enrollments:

        if (
            enrollment["course_id"] == enrollment_data["course_id"]
            and enrollment["email"] == enrollment_data["email"]
            and enrollment["status"] != "Cancelled"
        ):
            return jsonify({
                "error": "Student is already enrolled in this course"
            }), 409

    # Check course capacity
    enrolled_count = count_enrolled_students(course["id"])

    if enrolled_count >= course["capacity"]:
        return jsonify({
            "error": "Course is fully booked"
        }), 409

    # Generate enrollment ID
    if enrollments:
        new_id = max(
            enrollment["id"] for enrollment in enrollments
        ) + 1
    else:
        new_id = 501

    new_enrollment = {
        "id": new_id,
        **enrollment_data,
        "course_title": course["title"],
        "enrolled_date": date.today().isoformat(),
        "amount_paid": course["course_fee"],
        "completed_lesson_ids": [],
        "progress_percentage": 0,
        "status": "Active"
    }

    enrollments.append(new_enrollment)

    return jsonify({
        "message": "Student enrolled successfully",
        "enrollment": new_enrollment
    }), 201


# --------------------------------------------------
# 8. MARK A LESSON AS COMPLETED
# Flow: Find enrollment -> Find lesson -> Check status
#       -> Update completed lessons -> Calculate progress
#       -> Complete course if all lessons are done
# --------------------------------------------------
@app.route(
    "/api/enrollments/<int:enrollment_id>/lessons/<int:lesson_id>/complete",
    methods=["POST"]
)
def complete_lesson(enrollment_id, lesson_id):

    enrollment = find_enrollment(enrollment_id)

    if enrollment is None:
        return jsonify({
            "error": "Enrollment not found"
        }), 404

    if enrollment["status"] != "Active":
        return jsonify({
            "error": "Only active enrollments can complete lessons"
        }), 409

    course = find_course(enrollment["course_id"])

    # Find the requested lesson
    lesson = None

    for item in course["lessons"]:

        if item["id"] == lesson_id:
            lesson = item
            break

    if lesson is None:
        return jsonify({
            "error": "Lesson not found in this course"
        }), 404

    # Prevent duplicate lesson completion
    if lesson_id in enrollment["completed_lesson_ids"]:
        return jsonify({
            "error": "Lesson is already completed"
        }), 409

    # Record completed lesson
    enrollment["completed_lesson_ids"].append(lesson_id)

    total_lessons = len(course["lessons"])

    completed_lessons = len(
        enrollment["completed_lesson_ids"]
    )

    # Calculate course progress percentage
    progress = round(
        (completed_lessons / total_lessons) * 100, 2
    )

    enrollment["progress_percentage"] = progress

    # Automatically complete the course
    if progress == 100:
        enrollment["status"] = "Completed"

    return jsonify({
        "message": "Lesson completed successfully",
        "lesson": lesson,
        "completed_lessons": completed_lessons,
        "total_lessons": total_lessons,
        "progress_percentage": progress,
        "enrollment_status": enrollment["status"]
    }), 200


# --------------------------------------------------
# 9. GET STUDENT LEARNING PROGRESS
# Flow: Find enrollment -> Find course
#       -> Identify completed and pending lessons
#       -> Return progress report
# --------------------------------------------------
@app.route(
    "/api/enrollments/<int:enrollment_id>/progress",
    methods=["GET"]
)
def get_learning_progress(enrollment_id):

    enrollment = find_enrollment(enrollment_id)

    if enrollment is None:
        return jsonify({
            "error": "Enrollment not found"
        }), 404

    course = find_course(enrollment["course_id"])

    completed_ids = enrollment["completed_lesson_ids"]

    completed_lessons = []
    pending_lessons = []

    for lesson in course["lessons"]:

        if lesson["id"] in completed_ids:
            completed_lessons.append(lesson)
        else:
            pending_lessons.append(lesson)

    return jsonify({
        "student_name": enrollment["student_name"],
        "course_title": course["title"],
        "total_lessons": len(course["lessons"]),
        "completed_lessons": len(completed_lessons),
        "pending_lessons": len(pending_lessons),
        "progress_percentage": enrollment["progress_percentage"],
        "enrollment_status": enrollment["status"],
        "completed_lesson_details": completed_lessons,
        "pending_lesson_details": pending_lessons
    }), 200


# --------------------------------------------------
# 10. CANCEL ENROLLMENT
# Flow: Find enrollment -> Check status
#       -> Update status -> Release course seat
#       -> Return response
# --------------------------------------------------
@app.route(
    "/api/enrollments/<int:enrollment_id>/cancel",
    methods=["POST"]
)
def cancel_enrollment(enrollment_id):

    enrollment = find_enrollment(enrollment_id)

    if enrollment is None:
        return jsonify({
            "error": "Enrollment not found"
        }), 404

    if enrollment["status"] != "Active":
        return jsonify({
            "error": "Only active enrollments can be cancelled"
        }), 409

    enrollment["status"] = "Cancelled"

    return jsonify({
        "message": "Enrollment cancelled successfully",
        "enrollment": enrollment
    }), 200


# --------------------------------------------------
# 11. LEARNING MANAGEMENT SUMMARY
# Flow: Count courses and enrollments
#       -> Calculate progress and enrollment value
#       -> Return statistics
# --------------------------------------------------
@app.route("/api/reports/summary", methods=["GET"])
def learning_summary():

    active = 0
    completed = 0
    cancelled = 0

    total_enrollment_value = 0

    for enrollment in enrollments:

        if enrollment["status"] == "Active":
            active += 1

        elif enrollment["status"] == "Completed":
            completed += 1

        elif enrollment["status"] == "Cancelled":
            cancelled += 1

        if enrollment["status"] != "Cancelled":
            total_enrollment_value += enrollment["amount_paid"]

    total_progress = sum(
        enrollment["progress_percentage"]
        for enrollment in enrollments
        if enrollment["status"] != "Cancelled"
    )

    active_enrollments = active + completed

    if active_enrollments > 0:
        average_progress = round(
            total_progress / active_enrollments, 2
        )
    else:
        average_progress = 0

    return jsonify({
        "total_courses": len(courses),
        "total_enrollments": len(enrollments),
        "active_enrollments": active,
        "completed_enrollments": completed,
        "cancelled_enrollments": cancelled,
        "average_learning_progress": average_progress,
        "total_enrollment_value": total_enrollment_value
    }), 200


