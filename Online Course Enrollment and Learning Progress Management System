# 2. GET ALL COURSES
# Flow: Read course list -> Calculate available seats
#       -> Return course information
# --------------------------------------------------
@app.route("/api/courses", methods=["GET"])
def get_courses():

    course_list = []

    for course in courses:

        enrolled_count = count_enrolled_students(course["id"])

        course_data = course.copy()

        course_data["enrolled_students"] = enrolled_count

        course_data["available_seats"] = (
            course["capacity"] - enrolled_count
        )

        course_list.append(course_data)

    return jsonify({
        "total_courses": len(course_list),
        "courses": course_list
    }), 200


# --------------------------------------------------
# 3. GET ONE COURSE
# Flow: Read course ID -> Search -> Calculate seats
#       -> Return course details
# --------------------------------------------------
@app.route("/api/courses/<int:course_id>", methods=["GET"])
def get_course(course_id):

    course = find_course(course_id)

    if course is None:
        return jsonify({
            "error": "Course not found"
        }), 404

    enrolled_count = count_enrolled_students(course_id)

    course_data = course.copy()

    course_data["enrolled_students"] = enrolled_count

    course_data["available_seats"] = (
        course["capacity"] - enrolled_count
    )

    return jsonify(course_data), 200


# --------------------------------------------------
# 4. CREATE A NEW COURSE
# Flow: Read JSON -> Validate -> Generate ID
#       -> Save course -> Return response
# --------------------------------------------------
@app.route("/api/courses", methods=["POST"])
def create_course():

    data = request.get_json(silent=True)

    course_data, error = validate_course(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    # Generate next available course ID
    if courses:
        new_id = max(course["id"] for course in courses) + 1
    else:
        new_id = 301

    new_course = {
        "id": new_id,
        **course_data
    }

    courses.append(new_course)

    return jsonify({
        "message": "Course created successfully",
        "course": new_course
    }), 201


# --------------------------------------------------
# 5. GET ALL ENROLLMENTS
# Flow: Read filters -> Filter student records
#       -> Return matching enrollments
# --------------------------------------------------
@app.route("/api/enrollments", methods=["GET"])
def get_enrollments():

    filtered_enrollments = enrollments

    status = request.args.get("status")

    if status:

        status = status.strip().title()

        if status not in ENROLLMENT_STATUSES:
            return jsonify({
                "error": "Invalid enrollment status"
            }), 400

        filtered_enrollments = [
            enrollment for enrollment in filtered_enrollments
            if enrollment["status"] == status
        ]

    course_id = request.args.get("course_id")

    if course_id is not None:

        try:
            course_id = int(course_id)
        except ValueError:
            return jsonify({
                "error": "Course ID must be an integer"
            }), 400

        filtered_enrollments = [
            enrollment for enrollment in filtered_enrollments
            if enrollment["course_id"] == course_id
        ]

    student_name = request.args.get("student")

    if student_name is not None:

        student_name = student_name.strip().lower()

        if not student_name:
            return jsonify({
                "error": "Student name cannot be empty"
            }), 400

        filtered_enrollments = [
            enrollment for enrollment in filtered_enrollments
            if student_name in enrollment["student_name"].lower()
        ]

    return jsonify({
        "total_enrollments": len(filtered_enrollments),
        "enrollments": filtered_enrollments
    }), 200


