# FUNCTION 1: CALCULATE PARKING FEE

# ============================================================

def calculate_fee(vehicle_type, hours):
"""
Execution Flow:
1. Receive vehicle type and parking hours.
2. Select the hourly rate.
3. Multiply rate by hours.
4. Return the parking fee.
"""

```
if vehicle_type == "Car":
    rate = 30

elif vehicle_type == "Bike":
    rate = 15

elif vehicle_type == "Auto":
    rate = 20

elif vehicle_type == "Truck":
    rate = 50

else:
    rate = 0

return rate * hours
```

