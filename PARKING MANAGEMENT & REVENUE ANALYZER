# FUNCTION 6: EXIT VEHICLE

# ============================================================

def exit_vehicle():
"""
Execution Flow:
1. Ask for ticket ID.
2. Search the record.
3. Calculate final parking fee.
4. Confirm vehicle exit.
5. Remove the record.
"""

```
try:
    ticket_id = int(input("\nEnter ticket ID: "))

    for record in parking_records:

        if record["ticket_id"] == ticket_id:

            fee = calculate_fee(
                record["vehicle_type"],
                record["hours"]
            )

            print("\n========== EXIT DETAILS ==========")
            print("Vehicle No  :", record["vehicle_no"])
            print("Owner       :", record["owner"])
            print("Vehicle Type:", record["vehicle_type"])
            print("Hours       :", record["hours"])
            print("Final Fee   : ₹", fee)

            confirm = input(
                "Confirm vehicle exit? (y/n): "
            ).strip().lower()

            if confirm == "y":
                parking_records.remove(record)
                print("Vehicle exited successfully.")
            else:
                print("Exit cancelled.")

            return

    print("Ticket ID not found.")

except ValueError:
    print("Please enter a valid ticket ID.")
```

