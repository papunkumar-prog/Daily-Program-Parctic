# FUNCTION 12: DELETE RECORD

# ============================================================

def delete_record():
"""
Execution Flow:
1. Ask for ticket ID.
2. Search the parking list.
3. Ask for confirmation.
4. Delete the record.
"""

```
try:

    ticket_id = int(
        input("\nEnter ticket ID to delete: ")
    )

    for record in parking_records:

        if record["ticket_id"] == ticket_id:

            confirm = input(
                f"Delete record for {record['vehicle_no']}? (y/n): "
            ).strip().lower()

            if confirm == "y":

                parking_records.remove(record)

                print("Record deleted successfully.")

            else:
                print("Delete operation cancelled.")

            return

    print("Ticket ID not found.")

except ValueError:
    print("Please enter a valid ticket ID.")
```

