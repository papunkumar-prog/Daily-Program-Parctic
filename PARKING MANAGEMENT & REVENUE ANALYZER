# FUNCTION 7: HIGHEST PARKING FEE

# ============================================================

def highest_fee():
"""
Execution Flow:
1. Collect all parking fees.
2. Convert fees into NumPy array.
3. Find maximum fee.
4. Display matching vehicle.
"""

```
if len(parking_records) == 0:
    print("No parking data available.")
    return

fees = []

for record in parking_records:

    fee = calculate_fee(
        record["vehicle_type"],
        record["hours"]
    )

    fees.append(fee)

fee_array = np.array(fees)

highest = np.max(fee_array)

print("\n========== HIGHEST PARKING FEE ==========")

for record in parking_records:

    fee = calculate_fee(
        record["vehicle_type"],
        record["hours"]
    )

    if fee == highest:
        print("Vehicle No :", record["vehicle_no"])
        print("Owner      :", record["owner"])
        print("Fee        : ₹", highest)
```

