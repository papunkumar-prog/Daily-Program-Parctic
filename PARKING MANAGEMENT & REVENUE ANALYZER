# FUNCTION 2: PARK VEHICLE

# ============================================================

def park_vehicle():
"""
Execution Flow:
1. Get ticket ID.
2. Check duplicate ticket ID.
3. Get vehicle number and owner name.
4. Select vehicle type.
5. Get parking hours.
6. Validate data.
7. Store record in the list.
"""

```
print("\n========== PARK VEHICLE ==========")

try:
    ticket_id = int(input("Enter ticket ID: "))

    # Check whether ticket already exists
    for record in parking_records:
        if record["ticket_id"] == ticket_id:
            print("Ticket ID already exists.")
            return

    vehicle_no = input("Enter vehicle number: ").strip().upper()
    owner = input("Enter owner name: ").strip().title()

    if vehicle_no == "" or owner == "":
        print("Vehicle number and owner name cannot be empty.")
        return

    print("\nVehicle Types:")
    for vehicle in vehicle_types:
        print("-", vehicle)

    vehicle_type = input("Enter vehicle type: ").strip().title()

    if vehicle_type not in vehicle_types:
        print("Invalid vehicle type.")
        return

    hours = float(input("Enter parking hours: "))

    if hours <= 0:
        print("Parking hours must be greater than 0.")
        return

    new_record = {
        "ticket_id": ticket_id,
        "vehicle_no": vehicle_no,
        "owner": owner,
        "vehicle_type": vehicle_type,
        "hours": hours
    }

    parking_records.append(new_record)

    fee = calculate_fee(vehicle_type, hours)

    print("\nVehicle parked successfully.")
    print("Parking Fee: ₹", fee)

except ValueError:
    print("Please enter valid numeric values.")
```

