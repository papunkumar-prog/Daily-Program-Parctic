# FUNCTION 11: VEHICLE TYPE SUMMARY

# ============================================================

def vehicle_summary():
"""
Execution Flow:
1. Count each vehicle type.
2. Use dictionary to store counts.
3. Display the summary.
"""

```
summary = {
    "Car": 0,
    "Bike": 0,
    "Auto": 0,
    "Truck": 0
}

for record in parking_records:

    vehicle_type = record["vehicle_type"]

    summary[vehicle_type] = summary[vehicle_type] + 1

print("\n========== VEHICLE TYPE SUMMARY ==========")

for vehicle_type, count in summary.items():

    print(vehicle_type, ":", count)
```

