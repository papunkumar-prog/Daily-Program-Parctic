# PROGRAM 1: FIND LARGEST AND SMALLEST
# ============================================================

def find_largest_smallest(numbers):

    largest = numbers[0]
    smallest = numbers[0]

    for number in numbers:

        if number > largest:
            largest = number

        if number < smallest:
            smallest = number

    print("Largest:", largest)
    print("Smallest:", smallest)


numbers = [10, 45, 23, 67, 12, 89, 34]

find_largest_smallest(numbers)


# ============================================================
# PROGRAM 2: COUNT EVEN AND ODD NUMBERS
# ============================================================

def count_even_odd(numbers):

    even = 0
    odd = 0

    for number in numbers:

        if number % 2 == 0:
            even += 1

        else:
            odd += 1

    print("Even numbers:", even)
    print("Odd numbers:", odd)


numbers = [10, 15, 20, 23, 30, 35, 40]

count_even_odd(numbers)


# ============================================================
# PROGRAM 3: REMOVE DUPLICATES
# ============================================================

def remove_duplicates(numbers):

    unique = []

    for number in numbers:

        if number not in unique:
            unique.append(number)

    print("Original:", numbers)
    print("Without duplicates:", unique)


numbers = [10, 20, 10, 30, 20, 40, 30]

remove_duplicates(numbers)


# ============================================================
# PROGRAM 4: FIND SECOND LARGEST
# ============================================================

def second_largest(numbers):

    largest = numbers[0]
    second = numbers[0]

    for number in numbers:

        if number > largest:
            second = largest
            largest = number

        elif number > second and number != largest:
            second = number

    print("Largest:", largest)
    print("Second Largest:", second)


numbers = [10, 50, 30, 90, 20, 70]

second_largest(numbers)


# ============================================================
# PROGRAM 5: REVERSE A LIST
# ============================================================

def reverse_list(numbers):

    reversed_list = []

    for i in range(len(numbers) - 1, -1, -1):
        reversed_list.append(numbers[i])

    print("Original:", numbers)
    print("Reversed:", reversed_list)


numbers = [10, 20, 30, 40, 50]

reverse_list(numbers)


