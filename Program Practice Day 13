# ============================================================
# PROGRAM 10: SUM OF EACH COLUMN
# ============================================================

def column_sum(matrix):

    columns = len(matrix[0])

    for column in range(columns):

        total = 0

        for row in matrix:
            total += row[column]

        print("Column", column + 1, "sum:", total)


matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

column_sum(matrix)


