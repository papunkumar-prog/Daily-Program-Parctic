# PROGRAM 16: MATRIX DIAGONAL SUM
# ============================================================

def diagonal_sum(matrix):

    main_sum = 0
    anti_sum = 0

    size = len(matrix)

    for i in range(size):

        main_sum += matrix[i][i]

        anti_sum += matrix[i][size - 1 - i]

    print("Main diagonal:", main_sum)
    print("Anti diagonal:", anti_sum)


matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

diagonal_sum(matrix)


