```

# Find average order amount

def average_order():

```
print("\n----------- AVERAGE ORDER -----------")

if len(orders) == 0:
    print("No orders found.")
    return

totals = []

for order in orders:

    total = calculate_total(
        order["item"],
        order["quantity"]
    )

    totals.append(total)

total_array = np.array(totals)

average = np.mean(total_array)

print("Average order amount: ₹", round(average, 2))
```

# Calculate total restaurant sales

def total_sales():

```
print("\n----------- TOTAL SALES -----------")

total = 0

for order in orders:

    amount = calculate_total(
        order["item"],
        order["quantity"]
    )

    total = total + amount

print("Total sales: ₹", total)
```

# Show item-wise order count

def item_summary():

```
print("\n----------- ITEM SUMMARY -----------")

summary = {}

for item in food_types:
    summary[item] = 0

for order in orders:

    item = order["item"]

    summary[item] = summary[item] + order["quantity"]

for item, quantity in summary.items():

    print(item, ":", quantity)
```

# Delete an order

def delete_order():

```
print("\n----------- DELETE ORDER -----------")

try:

    order_id = int(input("Enter order ID: "))

    for order in orders:

        if order["order_id"] == order_id:

            print("Customer :", order["customer"])
            print("Item     :", order["item"])

            confirm = input(
                "Delete this order? (y/n): "
            ).strip().lower()

            if confirm == "y":

                orders.remove(order)

                print("Order deleted.")

            else:

                print("Delete cancelled.")

            return

    print("Order ID not found.")

except ValueError:

    print("Enter a valid order ID.")
```

