#----------------------------------------------------------
#Character Classes
#----------------------------------------------------------
#Any digit
# \d -> Digit
# \d means any single digit(0-9)
import re
text = "My age is 21"
print(re.findall(r"\d", text))

# \d+ -> One or more digits
text2 = "My age is 21"
print(re.findall(r"\d+", text2))

# \D -> Not a digit
text3 = "A1B2C3"
print(re.findall(r"\D", text3))
#Word Character
text4 = "Python_3"
print(re.findall(r"\w", text4))
#Not a word character
text5 = "Python@3!"
print(re.findall(r"\W", text5))
#Whitespace
text6 = "Python Java"
print(re.findall(r"\s", text6))
# Not Whitespace
text7 = "Python Java"
print(re.findall(r"\S", text7))

#Practic Program
text8 = "Room 305"
print(re.findall(r"\d", text8))

text9 = "Marks: 90 85 100"
print(re.findall(r"\d+", text9))

text10 = "user_name123"
print(re.findall(r"\w", text10))

text11 = "Python is easy"
print(re.findall(r"\s", text11))

text12 = "Python is easy"
print(re.findall(r"\S", text12))
