# ==========================================================
# SHOPPING CART SYSTEM
# ==========================================================

cart = []


# Tuple - fixed product categories
categories = (
    "Electronics",
    "Clothing",
    "Food",
    "Books"
)


# ==========================================================
# 1. ADD PRODUCT
# ==========================================================

def add_product():

    name = input(
        "Enter product name: "
    ).strip().title()

    try:

        price = float(
            input("Enter product price: ₹")
        )

        quantity = int(
            input("Enter quantity: ")
        )

        if price <= 0 or quantity <= 0:

            print("Price and quantity must be greater than 0.")

            return

    except ValueError:

        print("Please enter valid numbers.")

        return

    print("\nAvailable Categories:")

    for category in categories:

        print("-", category)

    category = input(
        "Enter category: "
    ).strip().title()

    if category not in categories:

        print("Invalid category.")

        return

    # Dictionary
    product = {
        "name": name,
        "price": price,
        "quantity": quantity,
        "category": category
    }

    # Add dictionary to list
    cart.append(product)

    print("\nProduct added successfully!")


# ==========================================================
# 2. VIEW CART
# ==========================================================

def view_cart():

    if not cart:

        print("\nYour cart is empty.")

        return

    print("\n" + "=" * 75)

    print(
        f"{'ID':<5}"
        f"{'Product':<20}"
        f"{'Category':<15}"
        f"{'Price':<12}"
        f"{'Quantity':<10}"
    )

    print("=" * 75)

    for index, product in enumerate(
        cart,
        start=1
    ):

        print(
            f"{index:<5}"
            f"{product['name']:<20}"
            f"{product['category']:<15}"
            f"₹{product['price']:<11.2f}"
            f"{product['quantity']:<10}"
        )


# ==========================================================
# 3. CALCULATE TOTAL
# ==========================================================

def calculate_total():

    total = 0

    for product in cart:

        total += (
            product["price"]
            * product["quantity"]
        )

    print(
        "\nTotal Cart Value: ₹",
        total
    )

    return total


# ==========================================================
# 4. SEARCH PRODUCT
# ==========================================================

def search_product():

    name = input(
        "Enter product name: "
    ).strip().title()

    found = False

    for product in cart:

        if product["name"] == name:

            print("\nProduct Found!")

            print("Name:", product["name"])
            print("Category:", product["category"])
            print("Price:", product["price"])
            print("Quantity:", product["quantity"])

            found = True

    if not found:

        print("\nProduct not found.")


# ==========================================================
# 5. REMOVE PRODUCT
# ==========================================================

def remove_product():

    if not cart:

        print("\nCart is empty.")

        return

    view_cart()

    try:

        number = int(
            input(
                "\nEnter product ID to remove: "
            )
        )

        if 1 <= number <= len(cart):

            removed = cart.pop(
                number - 1
            )

            print(
                "\nRemoved:",
                removed["name"]
            )

        else:

            print("Invalid product ID.")

    except ValueError:

        print("Please enter a valid number.")


# ==========================================================
# 6. UPDATE QUANTITY
# ==========================================================

def update_quantity():

    if not cart:

        print("\nCart is empty.")

        return

    view_cart()

    try:

        number = int(
            input(
                "\nEnter product ID: "
            )
        )

        if not 1 <= number <= len(cart):

            print("Invalid product ID.")

            return

        quantity = int(
            input(
                "Enter new quantity: "
            )
        )

        if quantity <= 0:

            print(
                "Quantity must be greater than 0."
            )

            return

        cart[number - 1]["quantity"] = quantity

        print(
            "\nQuantity updated successfully!"
        )

    except ValueError:

        print("Please enter valid numbers.")


# ==========================================================
# 7. SHOW CATEGORIES
# ==========================================================

def show_categories():

    print("\nAvailable Categories:")

    for category in categories:

        print("-", category)


# ==========================================================
# 8. MAIN MENU
# ==========================================================

def main():

    while True:

        print("\n")
        print("=" * 45)
        print("       🛒 SHOPPING CART SYSTEM")
        print("=" * 45)

        print("1. Add Product")
        print("2. View Cart")
        print("3. Calculate Total")
        print("4. Search Product")
        print("5. Remove Product")
        print("6. Update Quantity")
        print("7. Show Categories")
        print("8. Exit")

        choice = input(
            "\nEnter your choice: "
        ).strip()

        if choice == "1":

            add_product()

        elif choice == "2":

            view_cart()

        elif choice == "3":

            calculate_total()

        elif choice == "4":

            search_product()

        elif choice == "5":

            remove_product()

        elif choice == "6":

            update_quantity()

        elif choice == "7":

            show_categories()

        elif choice == "8":

            print(
                "\nThank you for shopping!"
            )

            break

        else:

            print(
                "\nInvalid choice!"
            )


# ==========================================================
# PROGRAM START
# ==========================================================

main()
