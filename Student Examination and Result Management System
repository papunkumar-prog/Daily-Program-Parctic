# --------------------------------------------------
# 4. ADD A NEW STUDENT
# Flow: Read JSON -> Validate -> Check duplicate email
#       -> Generate ID -> Save student -> Respond
# --------------------------------------------------
@app.route("/api/students", methods=["POST"])
def add_student():

    data = request.get_json(silent=True)

    student_data, error = validate_student(data)

    if error:
        return jsonify({"error": error}), 400

    if check_duplicate_email(student_data["email"]):
        return jsonify({
            "error": "Email already registered"
        }), 409

    if students:
        new_id = max(student["id"] for student in students) + 1
    else:
        new_id = 1001

    new_student = {
        "id": new_id,
        **student_data
    }

    students.append(new_student)

    return jsonify({
        "message": "Student added successfully",
        "student": new_student
    }), 201


