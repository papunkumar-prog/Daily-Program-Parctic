# 7. GET ALL RESULTS
# Flow: Read filters -> Filter result records
#       -> Return matching results
# --------------------------------------------------
@app.route("/api/results", methods=["GET"])
def get_results():

    filtered_results = results

    student_id = request.args.get("student_id")

    if student_id is not None:

        try:
            student_id = int(student_id)
        except ValueError:
            return jsonify({
                "error": "Student ID must be an integer"
            }), 400

        filtered_results = [
            result for result in filtered_results
            if result["student_id"] == student_id
        ]

    exam_name = request.args.get("exam_name")

    if exam_name is not None:

        exam_name = exam_name.strip().lower()

        if not exam_name:
            return jsonify({
                "error": "Exam name cannot be empty"
            }), 400

        filtered_results = [
            result for result in filtered_results
            if exam_name in result["exam_name"].lower()
        ]

    status = request.args.get("status")

    if status is not None:

        status = status.strip().title()

        if status not in ["Pass", "Fail"]:
            return jsonify({
                "error": "Status must be Pass or Fail"
            }), 400

        filtered_results = [
            result for result in filtered_results
            if result["result_status"] == status
        ]

    return jsonify({
        "total_results": len(filtered_results),
        "results": filtered_results
    }), 200


