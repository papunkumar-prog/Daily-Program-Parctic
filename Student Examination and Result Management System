# --------------------------------------------------
# HELPER FUNCTION: FIND STUDENT
# Flow: Receive student ID -> Search student list
#       -> Return student record
# --------------------------------------------------
def find_student(student_id):

    for student in students:

        if student["id"] == student_id:
            return student

    return None


# --------------------------------------------------
# HELPER FUNCTION: FIND RESULT
# Flow: Receive result ID -> Search result list
#       -> Return matching result
# --------------------------------------------------
def find_result(result_id):

    for result in results:

        if result["id"] == result_id:
            return result

    return None


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE STUDENT DATA
# Flow: Receive JSON -> Check fields -> Validate
#       -> Return cleaned student information
# --------------------------------------------------
def validate_student(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "name",
        "email",
        "class_name"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    name = data["name"]
    email = data["email"]
    class_name = data["class_name"]

    if not all(
        isinstance(value, str)
        for value in [name, email, class_name]
    ):
        return None, "Student details must be text"

    name = name.strip()
    email = email.strip().lower()
    class_name = class_name.strip()

    if not all([name, email, class_name]):
        return None, "Student details cannot be empty"

    if "@" not in email or "." not in email.split("@")[-1]:
        return None, "Enter a valid email address"

    student_data = {
        "name": name,
        "email": email,
        "class_name": class_name
    }

    return student_data, None


# --------------------------------------------------
# HELPER FUNCTION: CHECK DUPLICATE EMAIL
# Flow: Search existing students -> Check email
#       -> Return True if duplicate exists
# --------------------------------------------------
def check_duplicate_email(email, exclude_id=None):

    for student in students:

        if (
            student["email"] == email
            and student["id"] != exclude_id
        ):
            return True

    return False


# --------------------------------------------------
# HELPER FUNCTION: CALCULATE GRADE
# Flow: Receive percentage -> Check conditions
#       -> Return grade and pass/fail status
# --------------------------------------------------
def calculate_grade(percentage):

    if percentage >= 90:
        grade = "A+"

    elif percentage >= 80:
        grade = "A"

    elif percentage >= 70:
        grade = "B"

    elif percentage >= 60:
        grade = "C"

    elif percentage >= 50:
        grade = "D"

    else:
        grade = "F"

    if percentage >= 35:
        status = "Pass"
    else:
        status = "Fail"

    return grade, status


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE RESULT DATA
# Flow: Read JSON -> Validate student -> Validate marks
#       -> Validate exam date -> Calculate percentage
#       -> Calculate grade -> Return result data
# --------------------------------------------------
def validate_result(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "student_id",
        "subject",
        "exam_name",
        "marks_obtained",
        "max_marks",
        "exam_date"
    ]

    for field in required_fields:

        if field not in data:
            return None, f"{field} is required"

    student_id = data["student_id"]
    subject = data["subject"]
    exam_name = data["exam_name"]
    marks = data["marks_obtained"]
    max_marks = data["max_marks"]
    exam_date = data["exam_date"]

    # Validate student ID
    if isinstance(student_id, bool) or not isinstance(student_id, int):
        return None, "Student ID must be an integer"

    if student_id <= 0:
        return None, "Student ID must be greater than zero"

    student = find_student(student_id)

    if student is None:
        return None, "Student not found"

    # Validate subject and exam name
    if not isinstance(subject, str) or not isinstance(exam_name, str):
        return None, "Subject and exam name must be text"

    subject = subject.strip().title()
    exam_name = exam_name.strip().title()

    if not subject or not exam_name:
        return None, "Subject and exam name cannot be empty"

    # Validate marks
    if (
        isinstance(marks, bool)
        or not isinstance(marks, (int, float))
    ):
        return None, "Marks obtained must be a number"

    if (
        isinstance(max_marks, bool)
        or not isinstance(max_marks, (int, float))
    ):
        return None, "Maximum marks must be a number"

    if not math.isfinite(marks) or not math.isfinite(max_marks):
        return None, "Marks must be finite numbers"

    if marks < 0:
        return None, "Marks cannot be negative"

    if max_marks <= 0:
        return None, "Maximum marks must be greater than zero"

    if marks > max_marks:
        return None, "Marks cannot exceed maximum marks"

    # Validate examination date
    if not isinstance(exam_date, str):
        return None, "Exam date must be text"

    try:
        parsed_date = date.fromisoformat(exam_date)

        if parsed_date.isoformat() != exam_date:
            return None, "Date must use YYYY-MM-DD format"

    except ValueError:
        return None, "Invalid examination date"

    # Calculate percentage
    percentage = round((marks / max_marks) * 100, 2)

    # Generate grade and pass/fail status
    grade, status = calculate_grade(percentage)

    result_data = {
        "student_id": student_id,
        "subject": subject,
        "exam_name": exam_name,
        "marks_obtained": marks,
        "max_marks": max_marks,
        "percentage": percentage,
        "grade": grade,
        "result_status": status,
        "exam_date": exam_date
    }

    return result_data, None


# --------------------------------------------------
# HELPER FUNCTION: CHECK DUPLICATE EXAM RESULT
# Flow: Compare student, subject and exam details
#       -> Return True if duplicate exists
# --------------------------------------------------
def check_duplicate_result(data, exclude_id=None):

    for result in results:

        if result["id"] == exclude_id:
            continue

        if (
            result["student_id"] == data["student_id"]
            and result["subject"].lower() == data["subject"].lower()
            and result["exam_name"].lower() == data["exam_name"].lower()
            and result["exam_date"] == data["exam_date"]
        ):
            return True

    return False


