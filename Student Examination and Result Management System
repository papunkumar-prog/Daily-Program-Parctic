# 5. UPDATE STUDENT DETAILS
# Flow: Read ID -> Validate -> Find student
#       -> Check duplicate email -> Update -> Respond
# --------------------------------------------------
@app.route("/api/students/<int:student_id>", methods=["PUT"])
def update_student(student_id):

    data = request.get_json(silent=True)

    student_data, error = validate_student(data)

    if error:
        return jsonify({"error": error}), 400

    student = find_student(student_id)

    if student is None:
        return jsonify({
            "error": "Student not found"
        }), 404

    if check_duplicate_email(
        student_data["email"],
        exclude_id=student_id
    ):
        return jsonify({
            "error": "Email already belongs to another student"
        }), 409

    student.update(student_data)

    return jsonify({
        "message": "Student updated successfully",
        "student": student
    }), 200


# --------------------------------------------------
# 6. DELETE A STUDENT
# Flow: Read ID -> Find student -> Check results
#       -> Delete student -> Return response
# --------------------------------------------------
@app.route("/api/students/<int:student_id>", methods=["DELETE"])
def delete_student(student_id):

    student = find_student(student_id)

    if student is None:
        return jsonify({
            "error": "Student not found"
        }), 404

    # Prevent deletion when examination results exist
    for result in results:

        if result["student_id"] == student_id:
            return jsonify({
                "error": "Cannot delete student because examination results exist"
            }), 409

    students.remove(student)

    return jsonify({
        "message": "Student deleted successfully"
    }), 200


