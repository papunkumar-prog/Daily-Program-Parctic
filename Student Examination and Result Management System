# --------------------------------------------------
# 12. STUDENT PERFORMANCE REPORT
# Flow: Read student ID -> Find results
#       -> Calculate total marks and percentage
#       -> Generate overall grade -> Return report
# --------------------------------------------------
@app.route("/api/students/<int:student_id>/report", methods=["GET"])
def student_report(student_id):

    student = find_student(student_id)

    if student is None:
        return jsonify({
            "error": "Student not found"
        }), 404

    student_results = [
        result for result in results
        if result["student_id"] == student_id
    ]

    if not student_results:
        return jsonify({
            "message": "No examination results available",
            "student": student
        }), 200

    total_marks = sum(
        result["marks_obtained"] for result in student_results
    )

    maximum_marks = sum(
        result["max_marks"] for result in student_results
    )

    overall_percentage = round(
        (total_marks / maximum_marks) * 100, 2
    )

    overall_grade, overall_status = calculate_grade(
        overall_percentage
    )

    failed_subjects = [
        result["subject"]
        for result in student_results
        if result["result_status"] == "Fail"
    ]

    report = {
        "student": student,
        "total_subjects": len(student_results),
        "total_marks_obtained": total_marks,
        "maximum_marks": maximum_marks,
        "overall_percentage": overall_percentage,
        "overall_grade": overall_grade,
        "overall_status": overall_status,
        "failed_subjects": failed_subjects,
        "subject_results": student_results
    }

    return jsonify(report), 200


# --------------------------------------------------
# 13. EXAMINATION SUMMARY
# Flow: Count results -> Calculate pass/fail totals
#       -> Calculate average percentage -> Respond
# --------------------------------------------------
@app.route("/api/results/summary", methods=["GET"])
def result_summary():

    passed = 0
    failed = 0
    total_percentage = 0

    grade_counts = {
        "A+": 0,
        "A": 0,
        "B": 0,
        "C": 0,
        "D": 0,
        "F": 0
    }

    for result in results:

        total_percentage += result["percentage"]

        grade_counts[result["grade"]] += 1

        if result["result_status"] == "Pass":
            passed += 1
        else:
            failed += 1

    if results:
        average_percentage = round(
            total_percentage / len(results), 2
        )
    else:
        average_percentage = 0

    return jsonify({
        "total_students": len(students),
        "total_exam_results": len(results),
        "passed_results": passed,
        "failed_results": failed,
        "average_percentage": average_percentage,
        "grade_distribution": grade_counts
    }), 200


