# ============================================================

# COMPLETED TASKS

# ============================================================

@app.route("/api/tasks/completed", methods=["GET"])
def completed_tasks():

```
result = []

for task in tasks:

    if task["status"] == "Completed":

        result.append(task)

return jsonify({
    "total_completed": len(result),
    "tasks": result
})
```

# ============================================================

# TASK SUMMARY

# ============================================================

@app.route("/api/tasks/summary", methods=["GET"])
def task_summary():

```
summary = {
    "Pending": 0,
    "In Progress": 0,
    "Completed": 0
}

for task in tasks:

    status = task["status"]

    summary[status] = summary[status] + 1

return jsonify({
    "total_tasks": len(tasks),
    "summary": summary
})
```

