
from flask import Flask, request, jsonify

app = Flask(__name__)


# Store task records in a list of dictionaries
tasks = [
    {
        "id": 301,
        "title": "Learn Python",
        "description": "Practice Python functions",
        "status": "Pending",
        "priority": "High"
    },
    {
        "id": 302,
        "title": "Learn Flask",
        "description": "Create Flask REST API",
        "status": "In Progress",
        "priority": "Medium"
    },
    {
        "id": 303,
        "title": "Practice SQL",
        "description": "Write SQL queries",
        "status": "Completed",
        "priority": "Low"
    }
]


# --------------------------------------------------
# HELPER FUNCTION: VALIDATE TASK DATA
# Flow: Receive JSON -> Check fields -> Validate values
#       -> Return cleaned task data
# --------------------------------------------------
def validate_task(data):

    if not isinstance(data, dict):
        return None, "A valid JSON object is required"

    required_fields = [
        "title",
        "description",
        "status",
        "priority"
    ]

    for field in required_fields:
        if field not in data:
            return None, f"{field} is required"

    title = data["title"]
    description = data["description"]
    status = data["status"]
    priority = data["priority"]

    if not isinstance(title, str):
        return None, "Title must be text"

    if not isinstance(description, str):
        return None, "Description must be text"

    if not isinstance(status, str):
        return None, "Status must be text"

    if not isinstance(priority, str):
        return None, "Priority must be text"

    title = title.strip()
    description = description.strip()
    status = status.strip().title()
    priority = priority.strip().title()

    if not title or not description:
        return None, "Title and description cannot be empty"

    allowed_status = ["Pending", "In Progress", "Completed"]

    if status not in allowed_status:
        return None, "Status must be Pending, In Progress or Completed"

    allowed_priority = ["Low", "Medium", "High"]

    if priority not in allowed_priority:
        return None, "Priority must be Low, Medium or High"

    task_data = {
        "title": title,
        "description": description,
        "status": status,
        "priority": priority
    }

    return task_data, None


# --------------------------------------------------
# 1. HOME ROUTE
# Flow: Receive request -> Return welcome message
# --------------------------------------------------
@app.route("/")
def home():

    return jsonify({
        "message": "Task Management API is running"
    }), 200


# --------------------------------------------------
# 2. GET ALL TASKS
# Flow: Read tasks -> Return all task records
# --------------------------------------------------
@app.route("/api/tasks", methods=["GET"])
def get_tasks():

    status = request.args.get("status")

    if status:
        status = status.strip().title()

        allowed_status = ["Pending", "In Progress", "Completed"]

        if status not in allowed_status:
            return jsonify({
                "error": "Invalid task status"
            }), 400

        filtered_tasks = []

        for task in tasks:
            if task["status"] == status:
                filtered_tasks.append(task)

        return jsonify({
            "count": len(filtered_tasks),
            "tasks": filtered_tasks
        }), 200

    return jsonify(tasks), 200


# --------------------------------------------------
# 3. GET ONE TASK
# Flow: Read task ID -> Search list -> Return task
# --------------------------------------------------
@app.route("/api/tasks/<int:task_id>", methods=["GET"])
def get_task(task_id):

    for task in tasks:
        if task["id"] == task_id:
            return jsonify(task), 200

    return jsonify({
        "error": "Task not found"
    }), 404


# --------------------------------------------------
# 4. CREATE A NEW TASK
# Flow: Read JSON -> Validate -> Generate ID
#       -> Add task -> Return response
# --------------------------------------------------
@app.route("/api/tasks", methods=["POST"])
def add_task():

    data = request.get_json(silent=True)

    task_data, error = validate_task(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    # Generate the next available task ID
    if tasks:
        new_id = max(task["id"] for task in tasks) + 1
    else:
        new_id = 301

    new_task = {
        "id": new_id,
        **task_data
    }

    tasks.append(new_task)

    return jsonify({
        "message": "Task created successfully",
        "task": new_task
    }), 201


# --------------------------------------------------
# 5. UPDATE AN EXISTING TASK
# Flow: Read ID -> Read JSON -> Validate -> Find task
#       -> Update task -> Return response
# --------------------------------------------------
@app.route("/api/tasks/<int:task_id>", methods=["PUT"])
def update_task(task_id):

    data = request.get_json(silent=True)

    task_data, error = validate_task(data)

    if error:
        return jsonify({
            "error": error
        }), 400

    for task in tasks:
        if task["id"] == task_id:

            task.update(task_data)

            return jsonify({
                "message": "Task updated successfully",
                "task": task
            }), 200

    return jsonify({
        "error": "Task not found"
    }), 404


# --------------------------------------------------
# 6. DELETE A TASK
# Flow: Read ID -> Search task -> Remove task
#       -> Return response
# --------------------------------------------------
@app.route("/api/tasks/<int:task_id>", methods=["DELETE"])
def delete_task(task_id):

    for task in tasks:
        if task["id"] == task_id:

            tasks.remove(task)

            return jsonify({
                "message": "Task deleted successfully"
            }), 200

    return jsonify({
        "error": "Task not found"
    }), 404


# --------------------------------------------------
# 7. TASK SUMMARY
# Flow: Count tasks -> Calculate status totals
#       -> Return task statistics
# --------------------------------------------------
@app.route("/api/tasks/summary", methods=["GET"])
def task_summary():

    total_tasks = len(tasks)

    pending_tasks = 0
    progress_tasks = 0
    completed_tasks = 0

    for task in tasks:

        if task["status"] == "Pending":
            pending_tasks += 1

        elif task["status"] == "In Progress":
            progress_tasks += 1

        elif task["status"] == "Completed":
            completed_tasks += 1

    return jsonify({
        "total_tasks": total_tasks,
        "pending_tasks": pending_tasks,
        "in_progress_tasks": progress_tasks,
        "completed_tasks": completed_tasks
    }), 200


# --------------------------------------------------
# 8. START THE FLASK SERVER
# Flow: Start server -> Wait for API requests
# --------------------------------------------------
if __name__ == "__main__":
    app.run(debug=True)
