        print("Invalid travel type.")
        return

    booking["type"] = new_type

    total = calculate_cost(
        new_type,
        booking["tickets"]
    )

    print("Travel type updated.")
    print("New total: ₹", total)

except ValueError:

    print("Enter a valid booking ID.")
```

# ============================================================

# HIGHEST BOOKING COST

# ============================================================

def highest_booking():

```
print("\n----------- HIGHEST BOOKING -----------")

if len(bookings) == 0:

    print("No bookings found.")
    return

amounts = []

for booking in bookings:

    total = calculate_cost(
        booking["type"],
        booking["tickets"]
    )

    amounts.append(total)

amount_array = np.array(amounts)

highest = np.max(amount_array)

for booking in bookings:

    total = calculate_cost(
        booking["type"],
        booking["tickets"]
    )

    if total == highest:

        print("Passenger :", booking["name"])
        print("From      :", booking["from"])
        print("To        :", booking["to"])
        print("Amount    : ₹", highest)
```

