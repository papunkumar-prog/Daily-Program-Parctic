# ============================================================

# TRAVEL TICKET BOOKING & TRIP MANAGEMENT SYSTEM

# Simple CLI project using Python basics and NumPy

# ============================================================

import numpy as np

# Available travel types

travel_types = (
"Bus",
"Train",
"Flight"
)

# Ticket prices based on travel type

ticket_price = {
"Bus": 500,
"Train": 900,
"Flight": 2500
}

# Booking details

bookings = [
{
"id": 101,
"name": "Papun",
"from": "Chennai",
"to": "Bangalore",
"type": "Bus",
"tickets": 2
},
{
"id": 102,
"name": "Amit",
"from": "Chennai",
"to": "Hyderabad",
"type": "Train",
"tickets": 1
},
{
"id": 103,
"name": "Rahul",
"from": "Chennai",
"to": "Delhi",
"type": "Flight",
"tickets": 2
}
]

# ============================================================

# FIND BOOKING

# ============================================================

def find_booking(booking_id):

```
for booking in bookings:

    if booking["id"] == booking_id:
        return booking

return None
```

# ============================================================

# CALCULATE TICKET COST

# ============================================================

def calculate_cost(travel_type, tickets):

```
price = ticket_price[travel_type]

return price * tickets
```

# ============================================================

# SHOW TRAVEL TYPES

# ============================================================

def show_travel_types():

```
print("\nAvailable Travel Types:")

for travel_type in travel_types:

    print(
        travel_type,
        "- ₹",
        ticket_price[travel_type]
    )
```

# ============================================================

# ADD BOOKING

# ============================================================

def add_booking():

```
print("\n----------- NEW BOOKING -----------")

try:

    booking_id = int(
        input("Enter booking ID: ")
    )

    # Check duplicate ID
    for booking in bookings:

        if booking["id"] == booking_id:

            print("Booking ID already exists.")
            return

    name = input(
        "Enter passenger name: "
    ).strip().title()

    if name == "":

        print("Passenger name is required.")
        return

    start = input(
        "Enter starting place: "
    ).strip().title()

    destination = input(
        "Enter destination: "
    ).strip().title()

    if start == "" or destination == "":

        print("Starting place and destination are required.")
        return

    if start.lower() == destination.lower():

        print("Starting place and destination cannot be the same.")
        return

    show_travel_types()

    travel_type = input(
        "Enter travel type: "
    ).strip().title()

    if travel_type not in travel_types:

        print("Invalid travel type.")
        return

    tickets = int(
        input("Enter number of tickets: ")
    )

    if tickets <= 0:

        print("Number of tickets must be greater than zero.")
        return

    booking = {
        "id": booking_id,
        "name": name,
        "from": start,
        "to": destination,
        "type": travel_type,
        "tickets": tickets
    }

    bookings.append(booking)

    total = calculate_cost(
        travel_type,
        tickets
    )

    print("\nBooking completed.")
    print("Total ticket cost: ₹", total)

except ValueError:

    print("Please enter valid values.")
```

# ============================================================

# SHOW ALL BOOKINGS

# ============================================================

def show_bookings():

```
print("\n----------- ALL BOOKINGS -----------")

if len(bookings) == 0:

    print("No bookings found.")
    return

for booking in bookings:

    total = calculate_cost(
        booking["type"],
        booking["tickets"]
    )

    print("-----------------------------------")
    print("Booking ID  :", booking["id"])
    print("Passenger   :", booking["name"])
    print("From        :", booking["from"])
    print("To          :", booking["to"])
    print("Travel Type :", booking["type"])
    print("Tickets     :", booking["tickets"])
    print("Total       : ₹", total)
```

# ============================================================

# SEARCH BOOKING

# ============================================================

def search_booking():

```
print("\n----------- SEARCH BOOKING -----------")

try:

    booking_id = int(
        input("Enter booking ID: ")
    )

    booking = find_booking(booking_id)

    if booking is None:

        print("Booking not found.")
        return

    total = calculate_cost(
        booking["type"],
        booking["tickets"]
    )

    print("\nBooking found")
    print("Booking ID  :", booking["id"])
    print("Passenger   :", booking["name"])
    print("From        :", booking["from"])
    print("To          :", booking["to"])
    print("Travel Type :", booking["type"])
    print("Tickets     :", booking["tickets"])
    print("Total       : ₹", total)

except ValueError:

    print("Enter a valid booking ID.")
```

# ============================================================

# UPDATE TICKETS

# ============================================================

def update_tickets():

```
print("\n----------- UPDATE TICKETS -----------")

try:

    booking_id = int(
        input("Enter booking ID: ")
    )

    booking = find_booking(booking_id)

    if booking is None:

        print("Booking not found.")
        return

    print(
        "Current tickets:",
        booking["tickets"]
    )

    tickets = int(
        input("Enter new number of tickets: ")
    )

    if tickets <= 0:

        print("Tickets must be greater than zero.")
        return

    booking["tickets"] = tickets

    total = calculate_cost(
        booking["type"],
        tickets
    )

    print("Booking updated.")
    print("New total: ₹", total)

except ValueError:

    print("Enter a valid number.")
```

