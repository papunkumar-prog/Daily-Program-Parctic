# ============================================================

# UPDATE TRAVEL TYPE

# ============================================================

def change_travel_type():

```
print("\n----------- CHANGE TRAVEL TYPE -----------")

try:

    booking_id = int(
        input("Enter booking ID: ")
    )

    booking = find_booking(booking_id)

    if booking is None:

        print("Booking not found.")
        return

    print("Current type:", booking["type"])

