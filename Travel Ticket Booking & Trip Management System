# ============================================================

# AVERAGE BOOKING COST

# ============================================================

def average_booking():

```
print("\n----------- AVERAGE BOOKING -----------")

if len(bookings) == 0:

    print("No bookings found.")
    return

amounts = []

for booking in bookings:

    total = calculate_cost(
        booking["type"],
        booking["tickets"]
    )

    amounts.append(total)

amount_array = np.array(amounts)

average = np.mean(amount_array)

print(
    "Average booking amount: ₹",
    round(average, 2)
)
```

# ============================================================

# TOTAL REVENUE

# ============================================================

def total_revenue():

```
print("\n----------- TOTAL REVENUE -----------")

total = 0

for booking in bookings:

    amount = calculate_cost(
        booking["type"],
        booking["tickets"]
    )

    total = total + amount

print("Total booking revenue: ₹", total)
```

# ============================================================

# TRAVEL TYPE SUMMARY

# ============================================================

def travel_summary():

```
print("\n----------- TRAVEL SUMMARY -----------")

summary = {}

# Start all travel types with zero
for travel_type in travel_types:

    summary[travel_type] = 0

# Add ticket count
for booking in bookings:

    travel_type = booking["type"]

    summary[travel_type] = (
        summary[travel_type]
        + booking["tickets"]
    )

for travel_type, count in summary.items():

    print(
        travel_type,
        ":",
        count,
        "tickets"
    )
```

# ============================================================

# CANCEL BOOKING

# ============================================================

def cancel_booking():

```
print("\n----------- CANCEL BOOKING -----------")

try:

    booking_id = int(
        input("Enter booking ID: ")
    )

    booking = find_booking(booking_id)

    if booking is None:

        print("Booking not found.")
        return

    print("Passenger:", booking["name"])
    print("Route:", booking["from"], "to", booking["to"])

    confirm = input(
        "Cancel this booking? (y/n): "
    ).strip().lower()

    if confirm == "y":

        bookings.remove(booking)

        print("Booking cancelled.")

    else:

        print("Cancellation stopped.")

except ValueError:

    print("Enter a valid booking ID.")
```

