# ============================================================

# VEHICLE SERVICE CENTER MANAGEMENT SYSTEM

# Simple CLI project using Python basics and NumPy

# ============================================================

import numpy as np

# Types of vehicles

vehicle_types = (
"Car",
"Bike",
"Auto",
"Truck"
)

# Types of service

service_types = (
"General Service",
"Oil Change",
"Engine Repair",
"Brake Service",
"Full Service"
)

# Service charges

service_price = {
"General Service": 800,
"Oil Change": 500,
"Engine Repair": 3000,
"Brake Service": 1500,
"Full Service": 5000
}

# Service records

services = [
{
"id": 101,
"customer": "Papun",
"vehicle_no": "TN01AB1234",
"vehicle_type": "Car",
"service": "General Service",
"days": 2
},
{
"id": 102,
"customer": "Amit",
"vehicle_no": "TN02CD5678",
"vehicle_type": "Bike",
"service": "Oil Change",
"days": 1
},
{
"id": 103,
"customer": "Rahul",
"vehicle_no": "TN03EF9012",
"vehicle_type": "Car",
"service": "Brake Service",
"days": 3
}
]

# ============================================================

# FIND SERVICE RECORD

# ============================================================

def find_service(service_id):

```
for item in services:

    if item["id"] == service_id:
        return item

return None
```

# ============================================================

# FIND VEHICLE

# ============================================================

def find_vehicle(vehicle_no):

```
for item in services:

    if item["vehicle_no"] == vehicle_no:
        return item

return None
```

# ============================================================

# CALCULATE SERVICE BILL

# ============================================================

def calculate_bill(service_name, days):

```
bill = service_price[service_name]

# Extra charge for keeping vehicle more than 2 days
if days > 2:

    extra_days = days - 2
    extra_charge = extra_days * 200
    bill = bill + extra_charge

return bill
```

# ============================================================

# SHOW VEHICLE TYPES

# ============================================================

def show_vehicle_types():

```
print("\nVehicle Types:")

for item in vehicle_types:

    print("-", item)
```

# ============================================================

# SHOW SERVICE TYPES

# ============================================================

def show_service_types():

```
print("\nService Types:")

for item in service_types:

    print(
        "-",
        item,
        ": ₹",
        service_price[item]
    )
```

# ============================================================

# ADD SERVICE

# ============================================================

def add_service():

```
print("\n----------- ADD SERVICE -----------")

try:

    service_id = int(
        input("Enter service ID: ")
    )

    # Check duplicate ID
    for item in services:

        if item["id"] == service_id:

            print("Service ID already exists.")
            return

    customer = input(
        "Enter customer name: "
    ).strip().title()

    if customer == "":

        print("Customer name is required.")
        return

    vehicle_no = input(
        "Enter vehicle number: "
    ).strip().upper()

    if vehicle_no == "":

        print("Vehicle number is required.")
        return

    # Check whether vehicle is already in service
    old_vehicle = find_vehicle(vehicle_no)

    if old_vehicle is not None:

        print("This vehicle already has a service record.")
        return

    show_vehicle_types()

    vehicle_type = input(
        "Enter vehicle type: "
    ).strip().title()

    if vehicle_type not in vehicle_types:

        print("Invalid vehicle type.")
        return

    show_service_types()

    service = input(
        "Enter service type: "
    ).strip().title()

    if service not in service_types:

        print("Invalid service type.")
        return

    days = int(
        input("Enter estimated service days: ")
    )

    if days <= 0:

        print("Service days must be greater than zero.")
        return

    new_service = {
        "id": service_id,
        "customer": customer,
        "vehicle_no": vehicle_no,
        "vehicle_type": vehicle_type,
        "service": service,
        "days": days
    }

    services.append(new_service)

    bill = calculate_bill(service, days)

    print("\nService record added.")
    print("Estimated bill: ₹", bill)

except ValueError:

    print("Please enter valid values.")
```

# ============================================================

# SHOW ALL SERVICES

# ============================================================

def show_services():

```
print("\n----------- ALL SERVICE RECORDS -----------")

if len(services) == 0:

    print("No service records found.")
    return

for item in services:

    bill = calculate_bill(
