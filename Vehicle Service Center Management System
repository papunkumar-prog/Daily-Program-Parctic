# ============================================================

# AVERAGE BILL

# ============================================================

def average_bill():

```
print("\n----------- AVERAGE BILL -----------")

if len(services) == 0:

    print("No service records found.")
    return

bills = []

for item in services:

    bill = calculate_bill(
        item["service"],
        item["days"]
    )

    bills.append(bill)

bill_array = np.array(bills)

average = np.mean(bill_array)

print(
    "Average service bill: ₹",
    round(average, 2)
)
```

