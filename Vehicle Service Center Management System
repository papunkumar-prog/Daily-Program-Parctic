    print("Vehicle Type  :", item["vehicle_type"])
    print("Service       :", item["service"])
    print("Service Days  :", item["days"])
    print("Estimated Bill: ₹", bill)
```

# ============================================================

# SEARCH SERVICE

# ============================================================

def search_service():

```
print("\n----------- SEARCH SERVICE -----------")

vehicle_no = input(
    "Enter vehicle number: "
).strip().upper()

item = find_vehicle(vehicle_no)

if item is None:

    print("Vehicle not found.")
    return

bill = calculate_bill(
    item["service"],
    item["days"]
)

print("\nService found")
print("Service ID    :", item["id"])
print("Customer      :", item["customer"])
print("Vehicle No    :", item["vehicle_no"])
print("Vehicle Type  :", item["vehicle_type"])
print("Service       :", item["service"])
print("Service Days  :", item["days"])
print("Estimated Bill: ₹", bill)
```

# ============================================================

# CHANGE SERVICE

# ============================================================

def change_service():

```
print("\n----------- CHANGE SERVICE -----------")

try:

    service_id = int(
        input("Enter service ID: ")
    )

    item = find_service(service_id)

    if item is None:

        print("Service record not found.")
        return

    print("Customer:", item["customer"])
    print("Current service:", item["service"])

    show_service_types()

    new_service = input(
        "Enter new service: "
    ).strip().title()

    if new_service not in service_types:

        print("Invalid service type.")
        return

    item["service"] = new_service

    bill = calculate_bill(
        new_service,
        item["days"]
    )

    print("Service changed successfully.")
    print("New estimated bill: ₹", bill)

except ValueError:

    print("Enter a valid service ID.")
```

# ============================================================

# UPDATE SERVICE DAYS

# ============================================================

def update_days():

```
print("\n----------- UPDATE SERVICE DAYS -----------")

try:

    service_id = int(
        input("Enter service ID: ")
    )

    item = find_service(service_id)

    if item is None:

        print("Service record not found.")
        return

    print(
        "Current days:",
        item["days"]
    )

    days = int(
        input("Enter new service days: ")
    )

    if days <= 0:

        print("Days must be greater than zero.")
        return

    item["days"] = days

    bill = calculate_bill(
        item["service"],
        days
    )

    print("Service days updated.")
    print("New estimated bill: ₹", bill)

except ValueError:

    print("Enter a valid number.")
```

# ============================================================

# PRINT SERVICE BILL

# ============================================================

def print_bill():

```
print("\n----------- SERVICE BILL -----------")

try:

    service_id = int(
        input("Enter service ID: ")
    )

    item = find_service(service_id)

    if item is None:

        print("Service record not found.")
        return

    service_charge = service_price[
        item["service"]
    ]

    extra_charge = 0

    if item["days"] > 2:

        extra_days = item["days"] - 2
        extra_charge = extra_days * 200

    total = service_charge + extra_charge

    print("\n===================================")
    print("        VEHICLE SERVICE BILL")
    print("===================================")
    print("Service ID   :", item["id"])
    print("Customer     :", item["customer"])
    print("Vehicle No   :", item["vehicle_no"])
    print("Vehicle Type :", item["vehicle_type"])
    print("Service      :", item["service"])
    print("Days         :", item["days"])
    print("-----------------------------------")
    print("Service Fee  : ₹", service_charge)
    print("Extra Charge : ₹", extra_charge)
    print("-----------------------------------")
    print("Total Bill   : ₹", total)
    print("===================================")

except ValueError:

    print("Enter a valid service ID.")
```

# ============================================================

# HIGHEST BILL

# ============================================================

def highest_bill():

```
print("\n----------- HIGHEST BILL -----------")

if len(services) == 0:

    print("No service records found.")
    return

bills = []

for item in services:

    bill = calculate_bill(
        item["service"],
        item["days"]
    )

    bills.append(bill)

bill_array = np.array(bills)

highest = np.max(bill_array)

for item in services:

    bill = calculate_bill(
        item["service"],
        item["days"]
    )

    if bill == highest:

        print("Customer :", item["customer"])
        print("Vehicle  :", item["vehicle_no"])
        print("Service  :", item["service"])
        print("Bill     : ₹", highest)
```

