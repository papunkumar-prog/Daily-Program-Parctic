# ============================================================

# SERVICE SUMMARY

# ============================================================

def service_summary():

```
print("\n----------- SERVICE SUMMARY -----------")

summary = {}

# Start each service count at zero
for service in service_types:

    summary[service] = 0

# Count services
for item in services:

    service = item["service"]

    summary[service] = (
        summary[service] + 1
    )

for service, count in summary.items():

    print(service, ":", count)
```

# ============================================================

# DELETE SERVICE RECORD

# ============================================================

def delete_service():

```
print("\n----------- DELETE SERVICE -----------")

try:

    service_id = int(
        input("Enter service ID: ")
    )

    item = find_service(service_id)

    if item is None:

        print("Service record not found.")
        return

    print("Customer:", item["customer"])
    print("Vehicle :", item["vehicle_no"])

    confirm = input(
        "Delete this service record? (y/n): "
    ).strip().lower()

    if confirm == "y":

        services.remove(item)

        print("Service record deleted.")

    else:

        print("Delete cancelled.")

except ValueError:

    print("Enter a valid service ID.")
```

