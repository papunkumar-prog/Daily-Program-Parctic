bookings = [
    {
        "id": 601,
        "customer_name": "Papun",
        "vehicle_number": "OD02AB1234",
        "vehicle_model": "Maruti Swift",
        "service_type": "General Service",
        "booking_date": "2026-11-10",
        "estimated_cost": 2500,
        "status": "Booked"
    },
    {
        "id": 602,
        "customer_name": "Amit",
        "vehicle_number": "OD02CD5678",
        "vehicle_model": "Hyundai i20",
        "service_type": "Engine Repair",
        "booking_date": "2026-11-11",
        "estimated_cost": 5000,
        "status": "In Progress"
    },
    {
        "id": 603,
        "customer_name": "Rahul",
        "vehicle_number": "OD02EF9012",
        "vehicle_model": "Tata Nexon",
        "service_type": "Oil Change",
        "booking_date": "2026-11-12",
        "estimated_cost": 1500,
        "status": "Completed"
